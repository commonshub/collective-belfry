<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Sent by belfry.pass.write whenever login_setup_url is written on an active pass: at
         activation (the onboarding service writes the link together with state=active) and when
         a steward presses "Send new login link". Mails are kept (auto_delete off) so a failed
         delivery stays visible under Settings > Technical > Emails. The text is maintained here,
         not in the database: noupdate is off, so a module upgrade rewrites the template
         (migrations/19.0.1.4.0 released the record, which was created with noupdate on).
         Look: Open Source Village, run by Belfry, dark card; the palette is brand/tokens.css,
         repeated inline (mail clients load no stylesheet); the wordmark PNG comes from the
         onboarding service's /brand (belfry.public_url). -->
    <record id="mail_template_pass_activated" model="mail.template">
        <field name="name">Open Source Village: pass active, sign-in link</field>
        <field name="model_id" ref="belfry_pass.model_belfry_pass"/>
        <field name="subject">Your Open Source Village pass is active ({{ object.member_number }})</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<t t-set="public_url" t-value="(object.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/')"/>
<t t-set="brand_url" t-value="public_url + '/brand'"/>
<div style="margin: 0; padding: 32px 12px; background-color: #2b3a31; font-family: Geist, -apple-system, 'Segoe UI', Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #ffffff;">
  <div style="max-width: 560px; margin: 0 auto; background-color: #1a231d; border: 1px solid #44534a; border-radius: 12px; padding: 28px;">
    <p style="margin: 0 0 20px;"><img t-att-src="brand_url + '/osv-logo-horizontal-dark.png'" alt="Open Source Village" width="240" style="display: block; width: 240px; max-width: 100%; height: auto; border: 0;"/></p>
    <p style="margin: 0 0 12px;">Hello <t t-out="object.partner_id.name or ''"/>,</p>
    <p style="margin: 0 0 12px;">
        Your <strong><t t-out="object.tier_name or ''"/></strong> pass for Open Source Village is active
        from <t t-out="format_date(object.date_start) or ''"/> to <t t-out="format_date(object.date_end) or ''"/>.
        Your member number is <strong><t t-out="object.member_number or ''"/></strong>.
    </p>
    <p style="margin: 20px 0 12px;">
        <a t-att-href="object.login_setup_url" style="display: inline-block; background-color: #d6ff52; color: #1a231d; font-weight: 600; padding: 12px 22px; text-decoration: none; border-radius: 8px; font-size: 16px;">
            Sign in to Open Source Village
        </a>
    </p>
    <p style="margin: 0 0 20px; color: #c9d1cb;">
        The button signs you in, without a password, and takes you to the community apps
        (<a t-att-href="object.belfry_apps_url()" style="color: #d6ff52;"><t t-out="object.belfry_apps_url()"/></a>).
        It works once, until <t t-out="format_datetime(object.login_setup_expires_at, dt_format='long') if object.login_setup_expires_at else ''"/>.
        Later, sign in at <a t-att-href="object.belfry_login_url()" style="color: #d6ff52;"><t t-out="object.belfry_login_url()"/></a>
        with your e-mail address: you get a sign-in link by mail each time.
    </p>
    <p style="margin: 20px 0 6px;"><strong>Also for you</strong></p>
    <ul style="margin: 0 0 20px; padding-left: 20px; color: #c9d1cb;">
        <li style="margin: 0 0 6px;">Your pass at the door: <a t-att-href="public_url + '/me'" style="color: #d6ff52;">show it on your phone</a><t t-if="object.sudo().claim_url">, or <a t-att-href="object.sudo().claim_url" style="color: #d6ff52;">add it to your wallet app</a></t>.</li>
        <li t-if="object.sudo().tokens_url" style="margin: 0 0 6px;"><a t-att-href="object.sudo().tokens_url" style="color: #d6ff52;">Your <t t-out="object.cashu_amount"/> village tokens</a>, to pass on to other participants (no monetary value).</li>
        <li t-if="ctx.get('belfry_invoice_attached')" style="margin: 0 0 6px;">Your invoice is attached to this mail.</li>
    </ul>
    <p style="margin: 0; font-size: 12px; color: #8e9a91;">
        Your public key on Nostr, kept safe by Belfry:
        <code style="font-family: 'Geist Mono', Menlo, monospace; font-size: 12px; word-break: break-all;"><t t-out="object.npub or ''"/></code>
    </p>
    <p style="margin: 24px 0 0;">See you at the village,<br/>Open Source Village, run by Belfry</p>
  </div>
  <p style="margin: 16px 0 0; text-align: center; font-size: 12px; color: #8e9a91;">
    Open Source Village, run by Belfry ·
    <a t-att-href="public_url + '/help'" style="color: #8e9a91;">Help</a> ·
    <a t-att-href="public_url + '/rules'" style="color: #8e9a91;">Community rules</a> ·
    <a t-att-href="public_url + '/privacy'" style="color: #8e9a91;">Privacy</a> ·
    <a t-att-href="public_url + '/terms'" style="color: #8e9a91;">Terms</a>
  </p>
</div>
        </field>
    </record>
</odoo>
