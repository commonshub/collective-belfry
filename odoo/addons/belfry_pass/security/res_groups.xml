<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_belfry" model="ir.module.category">
        <field name="name">Belfry</field>
        <field name="description">Open Source Village passes and invites</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_belfry" model="res.groups.privilege">
        <field name="name">Belfry</field>
        <field name="category_id" ref="module_category_belfry"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_steward" model="res.groups">
        <field name="name">Steward</field>
        <field name="privilege_id" ref="privilege_belfry"/>
        <field name="sequence">10</field>
        <field name="comment">Can generate invite links and see their own invites and all passes.</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_belfry"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_steward'))]"/>
        <field name="comment">Full access to passes, invites and Stripe events. Also the group of the onboarding service user.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_admin'))]"/>
    </record>
</odoo>
