<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_belfry_invite_steward_own" model="ir.rule">
        <field name="name">Stewards see their own invites</field>
        <field name="model_id" ref="model_belfry_invite"/>
        <field name="domain_force">[('steward_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_steward'))]"/>
    </record>

    <record id="rule_belfry_invite_admin_all" model="ir.rule">
        <field name="name">Belfry admins see all invites</field>
        <field name="model_id" ref="model_belfry_invite"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin'))]"/>
    </record>
</odoo>
