<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_belfry_invite_list" model="ir.ui.view">
        <field name="name">belfry.invite.list</field>
        <field name="model">belfry.invite</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="create_date" string="Created"/>
                <field name="steward_id"/>
                <field name="note"/>
                <field name="expires_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-info="state == 'used'"
                       decoration-muted="state in ('expired', 'revoked')"/>
                <field name="used_by_partner_id"/>
                <field name="pass_id"/>
                <field name="url" widget="CopyClipboardChar"/>
            </list>
        </field>
    </record>

    <record id="view_belfry_invite_form" model="ir.ui.view">
        <field name="name">belfry.invite.form</field>
        <field name="model">belfry.invite</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'open'"
                            confirm="Revoke this invite? The link will stop working."/>
                    <field name="state" widget="statusbar" statusbar_visible="open,used"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="note"/>
                            <field name="steward_id"/>
                            <field name="expires_at"/>
                        </group>
                        <group>
                            <field name="used_by_partner_id"/>
                            <field name="pass_id"/>
                            <field name="token" groups="belfry_pass.group_admin"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_belfry_invite_search" model="ir.ui.view">
        <field name="name">belfry.invite.search</field>
        <field name="model">belfry.invite</field>
        <field name="arch" type="xml">
            <search>
                <field name="note"/>
                <field name="steward_id"/>
                <field name="used_by_partner_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="used" string="Used" domain="[('state', '=', 'used')]"/>
                <filter name="mine" string="My invites" domain="[('steward_id', '=', uid)]"/>
                <group>
                    <filter name="group_steward" string="Steward" context="{'group_by': 'steward_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_belfry_invite" model="ir.actions.act_window">
        <field name="name">Invites</field>
        <field name="res_model">belfry.invite</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_belfry_invite_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate an invite</p>
            <p>Click New: the form shows the single-use link to send to the participant. It expires after 14 days by default.</p>
        </field>
    </record>
</odoo>
