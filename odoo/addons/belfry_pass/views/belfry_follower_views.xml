<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_belfry_follower_list" model="ir.ui.view">
        <field name="name">belfry.follower.list</field>
        <field name="model">belfry.follower</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="email"/>
                <field name="channel"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="frequency"/>
                <field name="confirmed_at"/>
                <field name="last_sent_at"/>
            </list>
        </field>
    </record>
    <record id="action_belfry_follower" model="ir.actions.act_window">
        <field name="name">Followers</field>
        <field name="res_model">belfry.follower</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p>People who follow the public announcements by e-mail, from the website.</p></field>
    </record>
</odoo>
