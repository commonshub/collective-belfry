<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Open Source Village look for every Odoo frontend page a participant sees: the invite page
         below, the payment page (portal) and the portal itself. Dark theme; the palette, fonts and
         logos are the repo's brand/ folder, served by the onboarding service at
         <belfry.public_url>/brand (brand/tokens.css holds the values repeated here as fallbacks).
         Odoo's back office (stewards' admin and accounting) is not touched. -->
    <template id="brand_frontend_layout" name="Open Source Village frontend layout" inherit_id="web.frontend_layout">
        <!-- Odoo falls back to the title "Odoo", which is what link previews (Signal, WhatsApp,
             mail clients) showed for a shared invite link. Pages may set title and share_description. -->
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Open Source Village'"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <t t-set="belfry_brand_url" t-value="(request.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/') + '/brand'"/>
            <meta property="og:site_name" content="Open Source Village"/>
            <meta property="og:type" content="website"/>
            <meta property="og:title" t-att-content="title or 'Open Source Village'"/>
            <meta property="og:description" t-att-content="share_description or 'Open Source Village, run by Belfry'"/>
            <meta name="description" t-att-content="share_description or 'Open Source Village, run by Belfry'"/>
            <meta property="og:image" t-att-content="belfry_brand_url + '/web-app-manifest-512x512.png'"/>
            <meta property="og:image:width" content="512"/>
            <meta property="og:image:height" content="512"/>
            <meta property="og:image:alt" content="Open Source Village"/>
            <meta name="twitter:card" content="summary"/>
            <meta name="color-scheme" content="dark"/>
            <meta name="theme-color" content="#2b3a31"/>
            <link rel="icon" type="image/svg+xml" t-att-href="belfry_brand_url + '/favicon.svg'"/>
            <link rel="stylesheet" t-att-href="belfry_brand_url + '/fonts.css'"/>
            <link rel="stylesheet" t-att-href="belfry_brand_url + '/tokens.css'"/>
            <style>
                body, #wrapwrap { background: var(--osv-background, #2b3a31); color: var(--osv-foreground, #fff); font-family: var(--osv-font-sans, Geist, system-ui, sans-serif); }
                body { --bs-body-bg: #2b3a31; --bs-body-color: #ffffff; --bs-secondary-color: #c9d1cb; --bs-tertiary-color: #8e9a91;
                       --bs-border-color: #44534a; --bs-tertiary-bg: #243128; --bs-secondary-bg: #1a231d; --bs-emphasis-color: #ffffff;
                       --bs-link-color: #d6ff52; --bs-link-hover-color: #c5ee41; --bs-link-color-rgb: 214, 255, 82; --bs-link-hover-color-rgb: 197, 238, 65; }
                h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 { color: #ffffff; font-family: var(--osv-font-sans, Geist, system-ui, sans-serif); letter-spacing: -0.01em; }
                .text-muted, .text-body-secondary, .form-text { color: #c9d1cb !important; }
                a { color: #d6ff52; } a:hover { color: #c5ee41; }
                .o_footer, footer, #footer { background: #1a231d !important; border-color: #44534a !important; color: #ffffff; }
                .navbar .nav-link, .navbar-brand, .o_portal_navbar a, .breadcrumb-item, .breadcrumb-item a { color: #ffffff !important; }
                .card, .o_portal_wrap .card, .list-group-item, .o_portal_sidebar .o_portal_html_view, .modal-content, .dropdown-menu, .table, .o_portal_wrap .table { background-color: #1a231d; color: #ffffff; border-color: #44534a; }
                .table > :not(caption) > * > * { background-color: transparent; color: #ffffff; border-color: #44534a; }
                /* Odoo's frontend forces black text on plain list-group items (specificity 0,3,0). */
                #wrapwrap .list-group-item, #wrapwrap .list-group-item strong { color: #ffffff; }
                /* The portal chatter boots a separate bundle with Odoo's light theme, and its messages
                   reach nobody (stewards do not work in Odoo). Hide it and the sidebar's "Send message". */
                #invoice_communication, .o_portal_chatter, a[href="#discussion"] { display: none !important; }
                /* No links out to odoo.com ("Powered by Odoo" in the footer and the invoice sidebar). */
                .o_brand_promotion, #wrapwrap div:has(> a[href*="www.odoo.com"]) { display: none !important; }
                .card-header, .card-footer, .bg-light, .text-bg-light, .bg-white, .bg-100, .bg-200, .bg-body, .o_portal_wrap .bg-light { background-color: #243128 !important; color: #ffffff !important; }
                .form-control, .form-select { background-color: #243128; color: #ffffff; border-color: #44534a; }
                .form-control:focus, .form-select:focus { background-color: #243128; color: #ffffff; border-color: #d6ff52; box-shadow: 0 0 0 .25rem rgba(214, 255, 82, .25); }
                .form-control::placeholder { color: #8e9a91; }
                .form-check-input { background-color: #243128; border-color: #8e9a91; }
                .form-check-input:checked { background-color: #d6ff52; border-color: #d6ff52; }
                .btn-primary, .btn-primary:disabled, .o_payment_form .btn-primary, a.btn.btn-primary { background-color: #d6ff52; border-color: #d6ff52; color: #1a231d; font-weight: 600; }
                .btn-primary:hover, .btn-primary:focus, .btn-primary:active, .btn-primary:first-child:active { background-color: #c5ee41; border-color: #c5ee41; color: #1a231d; }
                .btn-secondary, .btn-light, .btn-outline-secondary { background-color: #243128; border-color: #44534a; color: #ffffff; }
                .btn-link { color: #d6ff52; }
                .alert-success { background-color: rgba(214, 255, 82, .12); border-color: #d6ff52; color: #ffffff; }
                .alert-warning, .alert-danger { background-color: rgba(248, 155, 14, .14); border-color: #f89b0e; color: #ffffff; }
                .alert-info { background-color: #243128; border-color: #44534a; color: #ffffff; }
                .text-decoration-line-through { color: #8e9a91 !important; }
                hr { border-color: #44534a; opacity: 1; }
                /* The invoice preview (iframe) is a paper document: keep it white with dark text. */
                .o_portal_html_view, .o_portal_html_view.bg-white { background-color: #ffffff !important; color: #212529; }
                .bg-body-tertiary, .bg-body-secondary, .bg-light-subtle, .bg-secondary-subtle, .bg-dark-subtle, .o_payment_summary_separator, .modal-body .card { background-color: #243128 !important; color: #ffffff !important; }
                .modal-content, .modal-header, .modal-footer { background-color: #1a231d; color: #ffffff; border-color: #44534a; }
                /* After the .bg-* rules, which also carry !important. The navbar keeps the page background: the company logo is a PNG on #2b3a31 (brand/README.md). */
                header.o_header_standard, .navbar, .o_portal_wrap .o_portal_navbar { background: #2b3a31 !important; border-bottom: 1px solid #44534a !important; color: #ffffff; }
                .modal-header .btn-close { filter: invert(1) grayscale(1); }
                .o_portal_wrap .o_portal_my_home .o_portal_category .o_portal_doc_card, .o_payment_form .o_payment_option_card { background-color: #1a231d !important; border-color: #44534a !important; }
                .o_payment_form .o_payment_option_card.o_payment_option_card_checked, .o_payment_form input:checked + label { border-color: #d6ff52 !important; }
                .o_payment_form label, .o_payment_form .o_payment_option_label { color: #ffffff; }
                img.o_payment_logo, img.img-fluid.payment_icon, .o_payment_form img { background: #ffffff; border-radius: 4px; padding: 2px; }
            </style>
        </xpath>
        <!-- Test runs: belfry.test_notice (bootstrap, TEST_RUN_NOTICE) on every page a participant sees. -->
        <xpath expr="//div[@id='wrapwrap']/main" position="before">
            <t t-set="belfry_test_notice" t-value="request.env['ir.config_parameter'].sudo().get_param('belfry.test_notice')"/>
            <div t-if="belfry_test_notice" class="belfry-test-notice" role="note"
                 style="background: #f89b0e; color: #1a231d; font-weight: 600; text-align: center; padding: 8px 16px; font-size: 0.95rem;">
                <t t-esc="belfry_test_notice"/>
            </div>
        </xpath>
    </template>

    <!-- Participants have no Odoo login: the portal's links lead to Belfry, not to Odoo's home,
         /web/login (admin network only) or /my (needs a login). Applied after portal's own
         extensions (priority), which add the navbar and the breadcrumbs. -->
    <template id="belfry_portal_navbar" name="Open Source Village portal navbar" inherit_id="web.frontend_layout" priority="40">
        <xpath expr="//a[hasclass('navbar-brand')]" position="attributes">
            <attribute name="href"/>
            <attribute name="t-att-href">(request.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/') + '/'</attribute>
        </xpath>
    </template>

    <template id="belfry_sign_in" name="Open Source Village sign-in link" inherit_id="portal.user_sign_in" priority="40">
        <xpath expr="//a" position="replace">
            <a t-att-href="(request.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/') + '/me'" t-attf-class="#{_link_class}">Your pass</a>
        </xpath>
    </template>

    <template id="belfry_portal_breadcrumbs" name="Open Source Village portal breadcrumbs" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//a[@href='/my/home']" position="attributes">
            <attribute name="href"/>
            <attribute name="t-att-href">(request.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/') + '/'</attribute>
            <attribute name="aria-label">Open Source Village</attribute>
            <attribute name="title">Open Source Village</attribute>
        </xpath>
        <xpath expr="//li[@name='invoices_breadcrumb']/a" position="attributes">
            <attribute name="t-if">invoice and not request.env.user._is_public()</attribute>
        </xpath>
    </template>

    <!-- The invoice's salesperson is the onboarding service's user, which means nothing to a participant. -->
    <template id="belfry_invoice_page" name="Open Source Village invoice page" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[@t-if='invoice.invoice_user_id']" position="attributes">
            <attribute name="t-if">invoice.invoice_user_id and not request.env.user._is_public()</attribute>
        </xpath>
    </template>

    <template id="invite_layout" name="Open Source Village invite layout">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="pageName" t-value="'belfry_invite'"/>
            <t t-set="title" t-value="'You are invited to Open Source Village'"/>
            <t t-set="share_description" t-value="'%s invited you. Pick a pass to join the village.' % invite.inviter_name if invite and invite.inviter_name else 'An invitation to Open Source Village. Pick a pass to join the village.'"/>
            <t t-set="belfry_brand_url" t-value="(request.env['ir.config_parameter'].sudo().get_param('belfry.public_url') or '').rstrip('/') + '/brand'"/>
            <div id="wrap" class="oe_structure">
                <div class="container py-5" style="max-width: 760px;">
                    <p class="mb-4"><a href="https://opensourcevillage.org"><img t-att-src="belfry_brand_url + '/osv-logo-horizontal-white.svg'" alt="Open Source Village" style="height: 28px; width: auto;"/></a></p>
                    <h1 class="mb-1">Your pass</h1>
                    <p class="text-muted mb-4">Open Source Village, run by Belfry</p>
                    <t t-out="0"/>
                    <p class="mt-5 small" style="color: #8e9a91;">Open Source Village, run by Belfry</p>
                </div>
            </div>
        </t>
    </template>

    <template id="invite_error" name="Open Source Village invite error">
        <t t-call="belfry_pass.invite_layout">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Invite not available</h4>
                <p class="mb-0" t-esc="message"/>
            </div>
            <p class="text-muted small">Reason code: <span t-esc="reason"/></p>
        </t>
    </template>

    <template id="invite_page" name="Open Source Village invite page">
        <t t-call="belfry_pass.invite_layout">
            <p>
                You were invited by <strong t-esc="invite.inviter_name or 'a steward'"/>.
                Pick a pass and enter your billing details; you will be taken to the payment page next.
                This link can be used once and expires on
                <span t-esc="invite.expires_at" t-options="{'widget': 'date'}"/>.
            </p>
            <div t-if="early_bird" class="alert alert-success py-2" role="alert">
                Early-bird prices apply until <span t-esc="early_bird_until"/>.
            </div>
            <div t-if="error" class="alert alert-danger" role="alert" id="belfry_form_error">
                <t t-esc="error"/>
            </div>

            <form method="post" t-attf-action="/belfry/invite/#{invite.token}" id="belfry_invite_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <h5 class="mt-4">1. Your pass</h5>
                <div class="list-group mb-4" id="belfry_passes">
                    <t t-foreach="rows" t-as="row">
                        <label class="list-group-item d-flex align-items-start gap-3">
                            <input class="form-check-input mt-1" type="radio" name="product_id"
                                   t-att-value="row['template'].id"
                                   t-att-checked="'checked' if form.get('product_id') == row['template'].id else None"/>
                            <span class="flex-grow-1">
                                <strong t-esc="row['template'].name"/>
                                <br/>
                                <small class="text-muted" t-esc="row['template'].description_sale"/>
                            </span>
                            <span class="text-end">
                                <span class="fs-5">
                                    <t t-esc="row['price']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </span>
                                <t t-if="row['price'] &lt; row['list_price']">
                                    <br/>
                                    <small class="text-muted text-decoration-line-through">
                                        <t t-esc="row['list_price']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </small>
                                </t>
                                <br/>
                                <small class="text-muted">
                                    companies:
                                    <t t-esc="row['company_price']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </small>
                            </span>
                        </label>
                    </t>
                </div>

                <h5>2. Billing details</h5>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="belfry_name">Name</label>
                        <input class="form-control" type="text" id="belfry_name" name="name" required="required"
                               t-att-value="form.get('name')"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="belfry_email">Email</label>
                        <input class="form-control" type="email" id="belfry_email" name="email" required="required"
                               t-att-value="form.get('email')"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="belfry_company">Company (optional, +50%)</label>
                        <input class="form-control" type="text" id="belfry_company" name="company_name"
                               t-att-value="form.get('company_name')"/>
                        <div class="form-text">Fill in when the invoice goes to a company.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="belfry_vat">VAT number (optional)</label>
                        <input class="form-control" type="text" id="belfry_vat" name="vat"
                               t-att-value="form.get('vat')"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="belfry_promo">Discount code (optional)</label>
                        <input class="form-control" type="text" id="belfry_promo" name="promo_code"
                               t-att-value="form.get('promo_code')"/>
                    </div>
                </div>

                <h5>3. Your Nostr key (optional)</h5>
                <div class="mb-4" id="belfry_own_key_block">
                    <p class="text-muted mb-2">
                        Every participant gets a Nostr key for the community apps; Belfry keeps it
                        for you and can recover it. If you already use Nostr, you can join with
                        your own key instead: you then sign in to the apps with your own signer,
                        and Belfry never holds your key.
                    </p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="belfry_own_key" name="own_key" value="1"
                               t-att-checked="'checked' if form.get('own_key') else None"/>
                        <label class="form-check-label" for="belfry_own_key">
                            Join with my own Nostr key (needs a signer extension in this browser)
                        </label>
                    </div>
                    <input type="hidden" name="nostr_pubkey" id="belfry_nostr_pubkey"/>
                    <input type="hidden" name="nostr_proof" id="belfry_nostr_proof"/>
                    <p class="form-text mt-2" id="belfry_own_key_status" aria-live="polite"/>
                </div>

                <button type="submit" class="btn btn-primary btn-lg">Continue to payment</button>
            </form>
            <script src="/belfry_pass/static/src/js/own_key.js" defer="defer"/>
        </t>
    </template>
</odoo>
