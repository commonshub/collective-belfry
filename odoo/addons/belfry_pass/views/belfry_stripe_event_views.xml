<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_belfry_stripe_event_list" model="ir.ui.view">
        <field name="name">belfry.stripe.event.list</field>
        <field name="model">belfry.stripe.event</field>
        <field name="arch" type="xml">
            <list default_order="received_at desc" create="false" edit="false">
                <field name="received_at"/>
                <field name="event_id"/>
                <field name="type"/>
                <field name="pass_id"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_belfry_stripe_event_form" model="ir.ui.view">
        <field name="name">belfry.stripe.event.form</field>
        <field name="model">belfry.stripe.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="event_id"/>
                        <field name="type"/>
                        <field name="received_at"/>
                        <field name="pass_id"/>
                        <field name="result"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_belfry_stripe_event" model="ir.actions.act_window">
        <field name="name">Stripe events</field>
        <field name="res_model">belfry.stripe.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Stripe events recorded</p>
            <p>The onboarding service records the Stripe dispute events it processed here.</p>
        </field>
    </record>
</odoo>
