#!/usr/bin/env bash
# belfry: run a Belfry installed by install.sh (linked as /usr/local/bin/belfry).
#
#   belfry status                    containers, public checks, what is configured (no secrets shown)
#   belfry config [FILE]             apply BELFRY_* settings from FILE (KEY=VALUE lines) or the
#                                    environment to infra/.env and infra/secrets/, then `belfry apply`
#   belfry apply                     start or update the stack: up, bootstrap, apps, onboarding restart
#   belfry add-steward EMAIL [NAME]  let someone use the steward pages (and give them a pass)
#   belfry smoke                     the end-to-end test over HTTPS (creates a test participant)
#   belfry update [REF]              fetch REF (default: the checked-out branch), rebuild, apply
#   belfry version                   the code this belfry runs, and whether a newer one is out
#   belfry update-request            run an update asked for in the admin console (belfry-update.path)
#   belfry homepage publish DIR [--title T]   publish a built static site as the homepage (nsite)
#   belfry homepage status           what the apex serves
#   belfry setup-code [NAME]         a link to https://belfry.<domain>/setup with a code in it, for
#                                    NAME (valid 24 h); a new belfry's link creates its first admin
#   belfry setup-apply               apply what the setup page saved (run by belfry-setup.path)
#   belfry setup-units               install the systemd units that watch the setup page (root)
#   belfry theme set DIR | show | reset   the community's own look (custom.css, logo, theme.json)
#   belfry logs [SERVICE]            follow the logs
#   (apply and update pull prebuilt images when GitHub has them for this code; BELFRY_BUILD_LOCAL=1
#   builds everything here)
#   belfry app install NAME DIR      serve a built web app at apps.<domain>/NAME/ (list, remove NAME;
#                                    the shipped ones, chat, come with belfry apply)
#   belfry compose ARGS…             docker compose with the right files and profile
#
# Settings `belfry config` understands (the same names install.sh takes; docs: infra/DEPLOY.md):
#   BELFRY_NAME                      community name (start page, belfry.json, mails)
#   BELFRY_THEME                     belfry (the only base look; own files: belfry theme)
#   BELFRY_EXTRA_APPS                apps added on apps.<domain>: calendar vote wallet groups village
#   BELFRY_REGISTER                  belfry | odoo: who is who lives in the belfry's own register
#                                    (no Odoo) or in Odoo (the add-on: billing, shifts, CRM)
#   BELFRY_GIT_REPO                  code shown at /git: nostr://<npub>/<relay>/<repo> or https://
#   BELFRY_MAIL_FROM                 sender address; its domain must allow the mail provider
#   BELFRY_RESEND_API_KEY            secret: mail through Resend (SMTP smtp.resend.com:587)
#   BELFRY_LETTERMINT_API_KEY        secret: mail through Lettermint, in the EU (a project's API
#                                    token; SMTP smtp.lettermint.co:587, user lettermint)
#   BELFRY_SMTP_HOST, _PORT, _USER, _ENCRYPTION (none|starttls|ssl), BELFRY_SMTP_PASSWORD (secret)
#   BELFRY_STRIPE_PUBLISHABLE_KEY    pk_test_… / pk_live_…
#   BELFRY_STRIPE_SECRET_KEY         secret: sk_… or a restricted rk_…
#   BELFRY_MOLLIE_API_KEY            secret: test_… / live_…
#   BELFRY_ACCOUNTING_ODOO_URL, _DB, _ISSUER, BELFRY_ACCOUNTING_ODOO_API_KEY (secret): book paid
#                                    passes in another organisation's Odoo (the bundled Odoo needs
#                                    nothing)
#   BELFRY_ENV_<NAME>=<value>        any other infra/.env setting, e.g. BELFRY_ENV_ACCOUNTING_JOURNAL=7
# Secrets are written to infra/secrets/ and never printed; status shows only whether they are set.
# Changes are recorded in the changelog (/changelog) with who started them: BELFRY_BY names who
# ("Ana via Claude"), else the sudo user.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"
INFRA="$ROOT/infra"
ENV_FILE="$INFRA/.env"
SECRETS="$INFRA/secrets"

die() { echo "belfry: $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Everything runs as the owner of the checkout (HOST_UID: the signer's files belong to it).
OWNER=$(stat -c %U "$ROOT")
if [[ "$(id -un)" != "$OWNER" && "${1:-}" != setup-units ]]; then
  [[ "$(id -u)" -eq 0 ]] || die "run as $OWNER or root"
  exec runuser -u "$OWNER" -- "$SELF" "$@"
fi
cd "$ROOT"

COMPOSE_FILES=(-f infra/docker-compose.yml -f infra/docker-compose.prod.yml)
[[ -f infra/.nginx ]] && COMPOSE_FILES+=(-f infra/docker-compose.nginx.yml)

# Prebuilt images (docker-compose.images.yml): each tag is the git tree hash of its build context,
# so the image is the one GitHub built from exactly this code. infra/.images marks that the last
# `belfry apply` found them; without it everything is built here, as before.
PREBUILT_SERVICES=(keycast keycast-migrate proxy groups-relay onboarding git)
export BELFRY_KEYCAST_TAG BELFRY_PROXY_TAG BELFRY_GROUPS_RELAY_TAG BELFRY_ONBOARDING_TAG BELFRY_GIT_TAG
image_tags() {
  t() { printf 'tree-%s' "$(git -c safe.directory="$ROOT" -C "$ROOT" rev-parse --short=12 "HEAD:$1")"; }
  BELFRY_KEYCAST_TAG=$(t infra/keycast/build)
  BELFRY_PROXY_TAG=$(t infra/proxy)
  BELFRY_GROUPS_RELAY_TAG=$(t infra/groups-relay)
  BELFRY_ONBOARDING_TAG=$(t services/onboarding)
  BELFRY_GIT_TAG=$(t infra/git)
}
image_tags
# a build context with local changes has no prebuilt image
local_changes() { [[ -n "$(git -c safe.directory="$ROOT" -C "$ROOT" status --porcelain -- infra/keycast/build infra/proxy infra/groups-relay services/onboarding infra/git)" ]]; }
use_images() { [[ -f infra/.images ]] && ! local_changes; }
# REGISTER=belfry: no Odoo (the belfry's own register; docker-compose.noodoo.yml)
no_odoo() { [[ -f "$ENV_FILE" ]] && [[ "$(env_get REGISTER)" == belfry ]]; }

# Open Source Village's app suite (chat., calendar., vote., wallet., people., market., photos.,
# programme., groups.): compose profile osv-apps, only with OSV_APPS=1 in .env.
OSV_SERVICES=(chat calendar groups village vote wallet)
osv_apps() { [[ "$(env_get OSV_APPS)" == 1 ]]; }
# …or only the ones an admin added on apps.<domain> (EXTRA_APPS; compose profiles app-<name>)
EXTRA_KEYS=(calendar vote wallet groups village)
extra_apps() { local a; for a in $(env_get EXTRA_APPS); do [[ " ${EXTRA_KEYS[*]} " == *" $a "* ]] && echo "$a"; done; }

compose() {
  local files=("${COMPOSE_FILES[@]}")
  if no_odoo; then files+=(-f infra/docker-compose.noodoo.yml); fi
  if osv_apps; then files+=(--profile osv-apps)
  else local a; for a in $(extra_apps); do files+=(--profile "app-$a"); done; fi
  if use_images; then docker compose "${files[@]}" -f infra/docker-compose.images.yml "$@"
  else docker compose "${files[@]}" "$@"; fi
}

env_get() { sed -nE "s/^$1=\"?([^\"#]*)\"?.*/\1/p" "$ENV_FILE" | tail -n1 | sed 's/[[:space:]]*$//'; }

# env_set KEY VALUE…: replace or append KEY=VALUE in infra/.env (quoted when it has spaces).
env_set() {
  python3 - "$ENV_FILE" "$@" <<'PY'
import re, sys
path, pairs = sys.argv[1], sys.argv[2:]
values = dict(zip(pairs[::2], pairs[1::2]))
def fmt(v):
    return f'"{v}"' if re.search(r'[\s#"\']', v) else v
lines = open(path).read().splitlines(keepends=True)
seen = set()
for i, line in enumerate(lines):
    m = re.match(r"^([A-Z0-9_]+)=", line)
    if m and m.group(1) in values:
        if m.group(1) in seen:
            lines[i] = ""
            continue
        lines[i] = f"{m.group(1)}={fmt(values[m.group(1)])}\n"
        seen.add(m.group(1))
missing = [k for k in values if k not in seen]
if missing:
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    lines.append("\n# --- belfry config\n")
    lines += [f"{k}={fmt(values[k])}\n" for k in missing]
open(path, "w").write("".join(lines))
PY
}

# secret_set NAME VALUE: infra/secrets/<name>, in place (a running container's mount keeps the
# inode), mode 640; perms-init gives it group 10001 at the next start.
secret_set() {
  [[ "$1" =~ ^[a-z0-9_]+$ ]] || die "bad secret name $1"
  (umask 027; printf '%s' "$2" > "$SECRETS/$1")
  say "  secret $1 (${#2} characters)"
  changes+=("secret $1")
}

# record "<summary>": an operation in the changelog (infra/scripts/changelog.sh), when present
record() {
  if [[ -x infra/scripts/changelog.sh ]]; then
    BELFRY_BY=${BELFRY_BY:-${SUDO_USER:-$(id -un)}} infra/scripts/changelog.sh record "$1" >/dev/null || true
  fi
}

secret_state() { [[ -s "$SECRETS/$1" ]] && echo set || echo "not set"; }

cmd_config() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE missing: run install.sh first"
  if [[ -n "${1:-}" ]]; then
    [[ -r "$1" ]] || die "cannot read $1"
    # KEY=VALUE lines; only BELFRY_* keys, values taken literally (no shell evaluation)
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
      [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?(BELFRY_[A-Z0-9_]+)=(.*)$ ]] || die "not a BELFRY_ setting: ${line%%=*}"
      local k=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
      v=${v%$'\r'}
      # a trailing comment after an unquoted value; surrounding blanks; quotes
      if [[ ! "$v" =~ ^[\"\'] ]]; then v=${v%%[[:space:]]#*}; fi
      v=${v%"${v##*[![:space:]]}"}
      if [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]]; then v=${BASH_REMATCH[1]}; fi
      export "$k=$v"
    done < "$1"
  fi
  local -a pairs=() changes=()
  local changed=0
  say "Settings"
  if [[ -n "${BELFRY_DOMAIN:-}" && -n "$(env_get BELFRY_DOMAIN)" && "$BELFRY_DOMAIN" != "$(env_get BELFRY_DOMAIN)" ]]; then
    die "this Belfry runs on $(env_get BELFRY_DOMAIN); moving it to another domain is not supported by config (certificates and passes carry the name)"
  fi
  if [[ -n "${BELFRY_NAME:-}" ]]; then pairs+=(COMMUNITY_NAME "$BELFRY_NAME" COMPANY_NAME "$BELFRY_NAME"); fi
  if [[ -n "${BELFRY_MAIL_FROM:-}" ]]; then pairs+=(MAIL_FROM "$BELFRY_MAIL_FROM"); fi
  if [[ -n "${BELFRY_THEME:-}" ]]; then
    [[ "$BELFRY_THEME" == belfry ]] || die "BELFRY_THEME is belfry: any other look is a theme folder (belfry theme set DIR)"
    pairs+=(THEME "$BELFRY_THEME")
  fi
  if [[ -n "${BELFRY_REGISTER:-}" ]]; then
    [[ "$BELFRY_REGISTER" =~ ^(belfry|odoo)$ ]] || die "BELFRY_REGISTER is belfry or odoo"
    pairs+=(REGISTER "$BELFRY_REGISTER")
  fi
  if [[ -n "${BELFRY_EXTRA_APPS+set}" ]]; then  # may be empty: none added
    local a
    for a in $BELFRY_EXTRA_APPS; do
      [[ " ${EXTRA_KEYS[*]} " == *" $a "* ]] || die "BELFRY_EXTRA_APPS: $a is not one of ${EXTRA_KEYS[*]}"
    done
    pairs+=(EXTRA_APPS "$(echo $BELFRY_EXTRA_APPS)")
  fi
  if [[ -n "${BELFRY_GIT_REPO:-}" ]]; then
    [[ "$BELFRY_GIT_REPO" =~ ^(nostr|https):// ]] || die "BELFRY_GIT_REPO is a nostr:// (ngit) or https:// URL"
    pairs+=(GIT_REPO "$BELFRY_GIT_REPO")
  fi
  if [[ -n "${BELFRY_RESEND_API_KEY:-}" ]]; then
    [[ "$BELFRY_RESEND_API_KEY" == re_* ]] || say "  warning: a Resend API key starts with re_"
    pairs+=(SMTP_HOST smtp.resend.com SMTP_PORT 587 SMTP_USER resend SMTP_ENCRYPTION starttls)
    secret_set smtp_password "$BELFRY_RESEND_API_KEY"; changed=1
  fi
  if [[ -n "${BELFRY_LETTERMINT_API_KEY:-}" ]]; then
    pairs+=(SMTP_HOST smtp.lettermint.co SMTP_PORT 587 SMTP_USER lettermint SMTP_ENCRYPTION starttls)
    secret_set smtp_password "$BELFRY_LETTERMINT_API_KEY"; changed=1
  fi
  local v
  for v in HOST PORT USER ENCRYPTION; do
    local n="BELFRY_SMTP_$v"
    if [[ -n "${!n:-}" ]]; then pairs+=("SMTP_$v" "${!n}"); fi
  done
  if [[ -n "${BELFRY_SMTP_PASSWORD:-}" ]]; then secret_set smtp_password "$BELFRY_SMTP_PASSWORD"; changed=1; fi
  if [[ -n "${BELFRY_STRIPE_PUBLISHABLE_KEY:-}" ]]; then
    [[ "$BELFRY_STRIPE_PUBLISHABLE_KEY" == pk_* ]] || die "BELFRY_STRIPE_PUBLISHABLE_KEY must start with pk_"
    pairs+=(STRIPE_PUBLISHABLE_KEY "$BELFRY_STRIPE_PUBLISHABLE_KEY")
  fi
  if [[ -n "${BELFRY_STRIPE_SECRET_KEY:-}" ]]; then
    [[ "$BELFRY_STRIPE_SECRET_KEY" =~ ^(sk|rk)_(test|live)_ ]] || die "BELFRY_STRIPE_SECRET_KEY must start with sk_ or rk_ (test or live)"
    secret_set stripe_secret_key "$BELFRY_STRIPE_SECRET_KEY"; changed=1
  fi
  if [[ -n "${BELFRY_MOLLIE_API_KEY:-}" ]]; then
    [[ "$BELFRY_MOLLIE_API_KEY" =~ ^(test|live)_ ]] || die "BELFRY_MOLLIE_API_KEY must start with test_ or live_"
    secret_set mollie_api_key "$BELFRY_MOLLIE_API_KEY"; changed=1
  fi
  for v in URL DB ISSUER; do
    local n="BELFRY_ACCOUNTING_ODOO_$v"
    if [[ -n "${!n:-}" ]]; then
      case $v in URL) pairs+=(ACCOUNTING_ODOO_URL "${!n}") ;; DB) pairs+=(ACCOUNTING_ODOO_DB "${!n}") ;; ISSUER) pairs+=(ACCOUNTING_ISSUER "${!n}") ;; esac
    fi
  done
  if [[ -n "${BELFRY_ACCOUNTING_ODOO_API_KEY:-}" ]]; then secret_set accounting_odoo_api_key "$BELFRY_ACCOUNTING_ODOO_API_KEY"; changed=1; fi
  local name
  while IFS= read -r name; do
    pairs+=("${name#BELFRY_ENV_}" "${!name}")
  done < <(compgen -e | grep -E '^BELFRY_ENV_[A-Z0-9_]+$' || true)
  if [[ ${#pairs[@]} -gt 0 ]]; then
    env_set "${pairs[@]}"
    local i
    for ((i = 0; i < ${#pairs[@]}; i += 2)); do say "  ${pairs[i]}=${pairs[i+1]}"; changes+=("${pairs[i]}"); done
    changed=1
  fi
  [[ $changed -eq 1 ]] || { say "  nothing to change (see belfry help)"; return 0; }
  record "Settings changed: $(IFS=,; echo "${changes[*]}" | sed 's/,/, /g')"
  setup_status
  if [[ "${BELFRY_NO_APPLY:-}" == 1 ]]; then return 0; fi
  if compose ps --status running -q proxy 2>/dev/null | grep -q .; then cmd_apply; else say "The stack is not running; start it with: belfry apply"; fi
}

bootstrap_env() {
  local d prefix
  d=$(env_get BELFRY_DOMAIN); [[ -n "$d" ]] || die "BELFRY_DOMAIN is not set in $ENV_FILE"
  prefix=$(env_get ODOO_HOST_PREFIX); prefix=${prefix:-shop}
  export ODOO_URL="https://$prefix.$d" AK_URL="https://login.$d" KC_URL="https://apps.$d"
}

free_gb() { df -Pk "$ROOT" | awk 'NR==2 {printf "%d", $4/1048576}'; }

# Little disk (under 25 GB free): build one image at a time and empty the build cache after each,
# so the peak is one build instead of all of them (a 20 GB server fits). An image is rebuilt only
# when its sources changed: each build is tagged with the git tree hash of its sources (the
# Dockerfile's folder when the context is the whole repository). BELFRY_REBUILD=1 rebuilds all.
lean_build() {
  local svc image src tree repo
  say "Little disk ($(free_gb) GB free): building one image at a time"
  while read -r svc image src; do
    [[ -n "$svc" ]] || continue
    tree=$(git -c safe.directory="$ROOT" -C "$ROOT" rev-parse --short=12 "HEAD:$src" 2>/dev/null || echo unknown)
    # each build is also tagged <repo>:tree-<hash of its sources>, so a reinstall or another
    # checkout of the same code finds it (BELFRY_REBUILD=1 rebuilds anyway)
    repo=$image; [[ "${image##*/}" == *:* ]] && repo=${image%:*}
    if [[ "${BELFRY_REBUILD:-}" != 1 && "$tree" != unknown ]] && docker image inspect "$repo:tree-$tree" >/dev/null 2>&1; then
      docker tag "$repo:tree-$tree" "$image"
      say "  $svc: up to date"
      continue
    fi
    say "  $svc: building $image"
    compose --profile app build "$svc"
    docker builder prune -af >/dev/null
    [[ "$tree" == unknown ]] || docker tag "$image" "$repo:tree-$tree"
  done < <(compose --profile app config --format json | python3 -c '
import json, os, sys
root = sys.argv[1]
seen = set()
for name, s in json.load(sys.stdin)["services"].items():
    b = s.get("build")
    image = s.get("image") or f"belfry-{name}"  # Compose names it <project>-<service>
    if not b or image in seen:
        continue
    seen.add(image)
    ctx = os.path.relpath(b.get("context", "."), root)
    if ctx == ".":  # the whole repository: the folder of the Dockerfile says what this is
        ctx = os.path.dirname(b.get("dockerfile", "Dockerfile")) or "."
    print(name, image, ctx)
' "$ROOT")
}

# Settings that used to follow the look (THEME): a belfry in Belfry's look runs without the Open
# Source Village apps and signs in on its own page; any other keeps both as they were.
legacy_settings() {
  local belfry=0; [[ "$(env_get THEME)" == belfry ]] && belfry=1
  if [[ -z "$(env_get OSV_APPS)" ]]; then env_set OSV_APPS "$([[ $belfry == 1 ]] && echo 0 || echo 1)"; fi
  if [[ -z "$(env_get PASS_SIGNIN)" ]]; then env_set PASS_SIGNIN "$([[ $belfry == 1 ]] && echo belfry || echo authentik)"; fi
  if ! osv_apps; then
    local svc off=()
    for svc in "${OSV_SERVICES[@]}"; do
      [[ " $(extra_apps | tr '\n' ' ') " == *" $svc "* ]] || off+=("$svc")
    done
    [[ ${#off[@]} -eq 0 ]] || compose --profile osv-apps rm -sf "${off[@]}" >/dev/null 2>&1 || true
  fi
}

cmd_apply() {
  bootstrap_env
  legacy_settings
  mkdir -p infra/data/changelog infra/data/theme "$SETUP_DIR"
  if [[ "${BELFRY_BUILD_LOCAL:-}" == 1 ]] || local_changes; then
    rm -f infra/.images
    say "Building every image here (BELFRY_BUILD_LOCAL=1 or local changes)"
  elif docker compose "${COMPOSE_FILES[@]}" -f infra/docker-compose.images.yml --profile app pull -q "${PREBUILT_SERVICES[@]}"; then
    : > infra/.images
    say "Prebuilt images for the signer, proxy, groups relay, git server and onboarding service ($BELFRY_KEYCAST_TAG …)"
  else
    rm -f infra/.images
    say "No prebuilt images for this version of the code: building them here (the signer takes 15 to 30 minutes)"
  fi
  shipped_apps
  say "Starting the stack"
  if [[ "$(free_gb)" -lt 25 ]]; then
    lean_build
    compose up -d
  else
    compose up -d --build
  fi
  say "Bootstrap (Odoo, Authentik, the signer, Stripe and Mollie when their keys are set)"
  infra/scripts/bootstrap.sh
  say "The onboarding service and the apps"
  if [[ "$(free_gb)" -lt 25 ]]; then compose --profile app up -d; else compose --profile app up -d --build; fi
  compose --profile app restart onboarding
  reload_proxy  # a running proxy keeps its old Caddyfile until told
  [[ -x infra/scripts/changelog.sh ]] && { infra/scripts/changelog.sh build || true; }
  write_version fetch || true
  say "Done. belfry status shows the state."
}

cmd_status() {
  local d; d=$(env_get BELFRY_DOMAIN)
  say "Belfry at https://$d ($(git -C "$ROOT" rev-parse --abbrev-ref HEAD) $(git -C "$ROOT" rev-parse --short HEAD))"
  compose --profile app ps --format 'table {{.Service}}\t{{.Status}}'
  say ""
  say "Public checks"
  local u code
  for u in "https://$d/" "https://pass.$d/status/1" "https://login.$d/application/o/keycast/.well-known/openid-configuration" "https://$d/.well-known/belfry.json"; do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$u" || true)
    printf '  %s  %s\n' "${code:-000}" "$u"
  done
  say ""
  say "Configured"
  local smtp; smtp=$(env_get SMTP_HOST)
  printf '  mail         %s (password %s), from %s\n' "${smtp:-none}" "$(secret_state smtp_password)" "$(env_get MAIL_FROM)"
  printf '  stripe       publishable %s, secret %s\n' "$( [[ -n "$(env_get STRIPE_PUBLISHABLE_KEY)" ]] && echo set || echo 'not set')" "$(secret_state stripe_secret_key)"
  printf '  mollie       %s\n' "$(secret_state mollie_api_key)"
  printf '  accounting   %s (key %s)\n' "$(env_get ACCOUNTING_ODOO_URL || true)" "$(secret_state accounting_odoo_api_key)"
  local seeddir; seeddir=$(env_get CUSTODY_SEED_DIR)
  if [[ -z "$seeddir" ]]; then
    printf '  custody seed on this disk (infra/secrets/custody); move it under YubiKeys: infra/DEPLOY.md\n'
  elif [[ -s "$seeddir/custody-seed" ]]; then
    printf '  custody seed unlocked in %s\n' "$seeddir"
  else
    printf '  custody seed LOCKED: new members wait until a steward runs custody-seed.sh unlock\n'
  fi
}

cmd_update() {
  local ref=${1:-$(git rev-parse --abbrev-ref HEAD)}
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "the checkout has local changes; commit or stash them first"
  git fetch -q origin "$ref"
  git checkout -q "$ref" 2>/dev/null || git checkout -q -b "$ref" "origin/$ref"
  if ! git merge -q --ff-only "origin/$ref" 2>/dev/null; then
    # the branch was rewritten upstream (rebased): an install never commits, so it follows the
    # branch, unless this checkout holds commits of its own
    local own; own=$(git cherry "origin/$ref" HEAD 2>/dev/null | grep -c '^+' || true)
    [[ "$own" -eq 0 ]] || die "this checkout has $own commit(s) of its own that $ref does not have; update by hand"
    git reset -q --hard "origin/$ref"
  fi
  say "At $(git rev-parse --short HEAD)"
  record "Updated the code to $(git rev-parse --short HEAD) ($ref)"
  infra/scripts/gen-secrets.sh >/dev/null
  cmd_apply
}

# version.json in the setup folder: what the admin console shows (Status) and belfry.json reports
write_version() {
  [[ -d "$SETUP_DIR" ]] || return 0
  local ref latest behind
  ref=$(git rev-parse --abbrev-ref HEAD)
  if [[ "${1:-}" == fetch ]]; then git fetch -q origin "$ref" 2>/dev/null || true; fi
  latest=$(git rev-parse --short "origin/$ref" 2>/dev/null || true)
  behind=$(git rev-list --count "HEAD..origin/$ref" 2>/dev/null || echo 0)
  python3 - "$SETUP_DIR/version.json" "$ref" "$(git rev-parse HEAD)" "$(git log -1 --format=%cI)" \
    "$(git log -1 --format=%s)" "${latest:-}" "$behind" "$(git log --format=%s -n 5 "HEAD..origin/$ref" 2>/dev/null || true)" <<'PY'
import datetime, json, os, sys
path, ref, commit, date, subject, latest, behind, newer = sys.argv[1:9]
data = {"branch": ref, "commit": commit, "short": commit[:7], "date": date, "subject": subject,
        "latest": latest, "behind": int(behind or 0), "newer": [x for x in newer.splitlines() if x],
        "checked_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f)
os.chmod(tmp, 0o664)
os.replace(tmp, path)
PY
}

cmd_version() {
  write_version fetch
  python3 - "$SETUP_DIR/version.json" <<'PY'
import json, sys
v = json.load(open(sys.argv[1]))
print(f"Belfry {v['short']} ({v['branch']}, {v['date'][:10]}): {v['subject']}")
if v["behind"]:
    print(f"{v['behind']} newer commit(s) on {v['branch']} (latest {v['latest']}); update with: belfry update")
    for s in v["newer"]:
        print("  - " + s)
else:
    print("Up to date.")
PY
}

# An update asked for in the admin console: the page writes update.request into the setup folder,
# belfry-update.path runs this; update.json tells the page how it went.
update_status() {
  python3 - "$SETUP_DIR/update.json" "$@" <<'PY'
import datetime, json, os, sys
path, state, frm, to, msg = (sys.argv[1:] + ["", "", "", ""])[:5]
data = {"state": state, "from": frm, "to": to, "message": msg[:400],
        "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f)
os.chmod(tmp, 0o664)
os.replace(tmp, path)
PY
}

cmd_update_request() {
  local req="$SETUP_DIR/update.request" from log
  [[ -f "$req" ]] || return 0
  rm -f "$req"
  from=$(git rev-parse --short HEAD)
  update_status running "$from"
  log=$(mktemp)
  if ( BELFRY_BY=console cmd_update ) >"$log" 2>&1; then
    update_status ok "$from" "$(git rev-parse --short HEAD)" "$(tail -n 1 "$log")"
  else
    update_status failed "$from" "$(git rev-parse --short HEAD)" "$(grep -v '^[[:space:]]*$' "$log" | tail -n 3 | tr '\n' ' ')"
  fi
  rm -f "$log"
  write_version
}

cmd_smoke() {
  local d; d=$(env_get BELFRY_DOMAIN)
  bootstrap_env
  export ONB_URL="https://pass.$d" BLOSSOM_URL="https://blossom.$d" WALLET_MAP="" BUNKER_MAP="" ONB_ADMIN_EXEC=1
  infra/scripts/smoke.sh
}

cmd_homepage() {
  case "${1:-status}" in
    publish)
      local dir=${2:?usage: belfry homepage publish DIR [--title TITLE]}; shift 2
      [[ -f "$dir/index.html" ]] || die "$dir has no index.html"
      tar -C "$dir" -c . | compose --profile app exec -T onboarding python -m belfry_onboarding homepage-publish "$@"
      record "Homepage published from $(basename "$(readlink -f "$dir")")"
      [[ "$(env_get HOMEPAGE)" == nsite* ]] || say "To show it on the apex: BELFRY_ENV_HOMEPAGE=nsite in a file, then belfry config FILE"
      ;;
    status) compose --profile app exec -T onboarding python -m belfry_onboarding homepage-status ;;
    *) die "usage: belfry homepage publish DIR | status" ;;
  esac
}

# ── the setup page (belfry.<domain>/setup, services/onboarding/belfry_onboarding/setup.py) ──
# The page writes infra/data/setup/pending.env; belfry-setup.path runs `belfry setup-apply`,
# which takes only these keys (the page's fields) and runs `belfry config` on them.
SETUP_DIR="$INFRA/data/setup"
SETUP_KEYS=(BELFRY_RESEND_API_KEY BELFRY_LETTERMINT_API_KEY BELFRY_MAIL_FROM BELFRY_NAME BELFRY_THEME BELFRY_ENV_HOMEPAGE
  BELFRY_GIT_REPO BELFRY_STRIPE_PUBLISHABLE_KEY BELFRY_STRIPE_SECRET_KEY BELFRY_MOLLIE_API_KEY
  BELFRY_ACCOUNTING_ODOO_URL BELFRY_ACCOUNTING_ODOO_DB BELFRY_ACCOUNTING_ODOO_ISSUER
  BELFRY_ACCOUNTING_ODOO_API_KEY BELFRY_EXTRA_APPS)

setup_folder() {
  mkdir -p "$SETUP_DIR"
  # the onboarding container (uid 1000) writes pending.env; this user reads it (setgid group)
  chmod 2770 "$SETUP_DIR" 2>/dev/null || true
}

# setup_status [APPLYING] [LAST_JSON]: status.json for the page; whether each setting is set and
# the values that are not secrets. Never a secret's value.
setup_status() {
  [[ -d "$SETUP_DIR" ]] || return 0
  python3 - "$SETUP_DIR/status.json" "$ENV_FILE" "$SECRETS" "${1:-${BELFRY_SETUP_APPLYING:-}}" "${2:-}" <<'PY' || true
import json, os, re, sys, time
path, env_file, secrets_dir, applying, last = sys.argv[1:6]
env = {}
for line in open(env_file):
    m = re.match(r'^([A-Z0-9_]+)=(.*)$', line.rstrip("\n"))
    if m:
        v = m.group(2).strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        env[m.group(1)] = v
def secret(n):
    p = os.path.join(secrets_dir, n)
    return os.path.isfile(p) and os.path.getsize(p) > 0
names = {"BELFRY_NAME": "COMMUNITY_NAME", "BELFRY_MAIL_FROM": "MAIL_FROM", "BELFRY_THEME": "THEME",
         "BELFRY_ENV_HOMEPAGE": "HOMEPAGE", "BELFRY_GIT_REPO": "GIT_REPO", "BELFRY_EXTRA_APPS": "EXTRA_APPS",
         "BELFRY_STRIPE_PUBLISHABLE_KEY": "STRIPE_PUBLISHABLE_KEY",
         "BELFRY_ACCOUNTING_ODOO_URL": "ACCOUNTING_ODOO_URL",
         "BELFRY_ACCOUNTING_ODOO_DB": "ACCOUNTING_ODOO_DB",
         "BELFRY_ACCOUNTING_ODOO_ISSUER": "ACCOUNTING_ISSUER"}
values = {k: env.get(v, "") for k, v in names.items()}
is_set = {k: bool(v) for k, v in values.items()}
is_set.update({
    "BELFRY_RESEND_API_KEY": env.get("SMTP_HOST") == "smtp.resend.com" and secret("smtp_password"),
    "BELFRY_LETTERMINT_API_KEY": env.get("SMTP_HOST") == "smtp.lettermint.co" and secret("smtp_password"),
    "BELFRY_STRIPE_SECRET_KEY": secret("stripe_secret_key"),
    "BELFRY_MOLLIE_API_KEY": secret("mollie_api_key"),
    "BELFRY_ACCOUNTING_ODOO_API_KEY": secret("accounting_odoo_api_key"),
})
try:
    old = json.load(open(path))
except (OSError, ValueError):
    old = {}
data = {"set": is_set, "values": values, "applying": applying == "1",
        "last": json.loads(last) if last else old.get("last", {}), "at": int(time.time())}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

# belfry setup-code [NAME]: a code for https://belfry.<domain>/setup, made for one person (the
# changelog names them for what they change). Several people can hold codes at once.
cmd_setup_code() {
  local who="${1:-}"
  if [[ -z "$who" && -t 0 ]]; then read -r -p "Who is this code for (their name)? " who; fi
  setup_folder
  local code
  code=$(python3 - "$SETUP_DIR/code.json" "${BELFRY_SETUP_HOURS:-24}" "$who" <<'PY'
import hashlib, json, os, secrets, sys, time
path, hours, who = sys.argv[1], float(sys.argv[2]), " ".join(sys.argv[3].split())[:120]
alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
raw = "".join(secrets.choice(alphabet) for _ in range(16))
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = {}
codes = data.get("codes") if isinstance(data.get("codes"), list) else []
now = time.time()
# keep the others' codes that still work; a new code for the same person replaces theirs
codes = [c for c in codes if c.get("expires", 0) > now and (not who or c.get("for") != who)]
codes.append({"sha256": hashlib.sha256(raw.encode()).hexdigest(),
              "expires": int(now + hours * 3600), "for": who})
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({"codes": codes}, f)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
print("-".join(raw[i:i + 4] for i in range(0, 16, 4)))
PY
)
  setup_status
  say "Setup link${who:+ for $who} (valid ${BELFRY_SETUP_HOURS:-24} hours; whoever opens it can change the settings):"
  say "  https://belfry.$(env_get BELFRY_DOMAIN)/setup?code=$code"
}

cmd_setup_apply() {
  local pending="$SETUP_DIR/pending.env" work log keys=() line k ok=true msg=""
  [[ -f "$pending" ]] || return 0
  work=$(mktemp); log=$(mktemp)
  # take the file first, so a new save while this runs starts a new round
  mv "$pending" "$work.in"
  while IFS= read -r line || [[ -n "$line" ]]; do
    k=${line%%=*}
    if [[ "$k" == BELFRY_BY ]] || printf '%s\n' "${SETUP_KEYS[@]}" | grep -qxF "$k"; then
      printf '%s\n' "$line" >> "$work"
      [[ "$k" == BELFRY_BY ]] || keys+=("$k")
    else
      echo "ignored: $k" >> "$log"
    fi
  done < "$work.in"
  rm -f "$work.in"
  setup_status 1
  if ! (BELFRY_SETUP_APPLYING=1 cmd_config "$work") >> "$log" 2>&1; then ok=false; fi
  rm -f "$work"
  msg=$(grep -v "^  secret " "$log" | tail -n 3 | tr '\n' ' ' | cut -c1-300)
  rm -f "$log"
  setup_status 0 "$(python3 -c 'import json,sys,datetime; print(json.dumps({"ok": sys.argv[1]=="true", "keys": sys.argv[3:], "message": sys.argv[2], "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")}))' "$ok" "$msg" "${keys[@]}")"
  $ok || die "setup: applying failed: $msg"
}

cmd_setup_units() {
  [[ "$(id -u)" -eq 0 ]] || die "setup-units installs systemd units: run as root"
  cat > /etc/systemd/system/belfry-setup.path <<EOF
[Unit]
Description=Belfry: watch the setup page's saved settings

[Path]
PathExists=$SETUP_DIR/pending.env
Unit=belfry-setup.service

[Install]
WantedBy=multi-user.target
EOF
  cat > /etc/systemd/system/belfry-setup.service <<EOF
[Unit]
Description=Belfry: apply the settings saved on the setup page

[Service]
Type=oneshot
ExecStart=/usr/local/bin/belfry setup-apply
EOF
  cat > /etc/systemd/system/belfry-update.path <<EOF
[Unit]
Description=Belfry: watch for an update asked for in the admin console

[Path]
PathExists=$SETUP_DIR/update.request
Unit=belfry-update.service

[Install]
WantedBy=multi-user.target
EOF
  cat > /etc/systemd/system/belfry-update.service <<EOF
[Unit]
Description=Belfry: update the code (asked for in the admin console)

[Service]
Type=oneshot
TimeoutStartSec=3h
ExecStart=/usr/local/bin/belfry update-request
EOF
  systemctl daemon-reload
  systemctl enable --now belfry-setup.path belfry-update.path >/dev/null
  say "belfry-setup.path watches $SETUP_DIR/pending.env, belfry-update.path $SETUP_DIR/update.request"
}

# ── the community's own look (infra/data/theme, served at /theme/custom/; theme.py) ──
THEME_DIR="$INFRA/data/theme"
cmd_theme() {
  case "${1:-show}" in
    set)
      local src=${2:?usage: belfry theme set DIR}
      [[ -d "$src" ]] || die "$src is not a folder"
      local f n=0
      mkdir -p "$THEME_DIR.new"
      for f in "$src"/*; do
        [[ -f "$f" ]] || continue
        case "${f##*.}" in
          css|svg|png|jpg|jpeg|webp|ico|woff2|woff|gif|json) install -m 644 "$f" "$THEME_DIR.new/"; n=$((n+1)) ;;
          *) say "  skipped $(basename "$f")" ;;
        esac
      done
      [[ $n -gt 0 ]] || { rm -rf "$THEME_DIR.new"; die "$src has no theme files (custom.css, logo.svg, favicon.svg, theme.json, fonts)"; }
      if [[ -f "$THEME_DIR.new/theme.json" ]]; then python3 -m json.tool "$THEME_DIR.new/theme.json" >/dev/null || die "theme.json is not valid JSON"; fi
      rm -rf "$THEME_DIR.old"; [[ -d "$THEME_DIR" ]] && mv "$THEME_DIR" "$THEME_DIR.old"
      mv "$THEME_DIR.new" "$THEME_DIR"
      say "Theme: $n files in $THEME_DIR (the previous ones in $THEME_DIR.old)"
      record "Theme changed ($n files)"
      compose --profile app restart onboarding >/dev/null
      ;;
    reset)
      [[ -d "$THEME_DIR" ]] || { say "No theme files"; return 0; }
      rm -rf "$THEME_DIR.old"; mv "$THEME_DIR" "$THEME_DIR.old"; mkdir -p "$THEME_DIR"
      record "Theme reset to the base theme"
      compose --profile app restart onboarding >/dev/null
      say "Back to the base theme ($(env_get THEME)); the files are in $THEME_DIR.old"
      ;;
    show)
      say "Base theme: belfry"
      say "Community name: $(env_get COMMUNITY_NAME)"
      if [[ -d "$THEME_DIR" ]] && [[ -n "$(ls -A "$THEME_DIR")" ]]; then ls -l "$THEME_DIR"; else say "No own files in $THEME_DIR"; fi
      ;;
    *) die "usage: belfry theme set DIR | show | reset" ;;
  esac
}

# ── a belfry's own static apps: apps.<domain>/<name>/ (infra/data/apps/<name>/) ──
# Data, like the theme: `belfry update` never touches them. Each installed app gets a route file
# in infra/data/apps/_routes/, which the proxy imports into the apps.<domain> site. The apps share
# their origin with the signer (Keycast) on apps.<domain>: install only apps the admins trust.
APPS_DIR="$INFRA/data/apps"
# names an app can't take: the signer's paths on apps.<domain>, and the community domain's own
# (the pages served there, and its shortcuts to the other apps)
APP_RESERVED=" api admin auth login logout register dashboard settings keys oauth static assets health well-known _routes 
 me git drop follow help proposals changelog monitor invite theme brand skills status apply feedback rules privacy terms refunds 
 connect door claim pass groups calendar programme vote people market photos wallet apps shop "
reload_proxy() {
  compose exec -T proxy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 \
    || compose restart proxy >/dev/null
}
app_route() {
  local name=$1
  if [[ "$name" == chat ]]; then  # the chat has its own host, chat.<domain> (Caddyfile)
    local kill="self.addEventListener('install',()=>self.skipWaiting());self.addEventListener('activate',e=>e.waitUntil((async()=>{for(const k of await caches.keys())await caches.delete(k);await self.registration.unregister();for(const c of await self.clients.matchAll({type:'window'}))c.navigate(c.url)})()));"
    printf '%s\n' \
      "# <domain>/chat: the chat lives at chat.<domain>; written by 'belfry app install chat'." \
      "redir /chat https://chat.{\$BELFRY_DOMAIN}/ 302" \
      "# the copy a phone kept of <domain>/chat/ empties itself and unregisters (then the redirect)" \
      "handle /chat/sw.js {" \
      "	header Content-Type \"text/javascript; charset=utf-8\"" \
      "	header Cache-Control \"no-store\"" \
      "	respond \`$kill\` 200" \
      "}" \
      "handle_path /chat/* {" \
      "	redir https://chat.{\$BELFRY_DOMAIN}{uri} 302" \
      "}"
    return
  fi
  local csp="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.{\$BELFRY_DOMAIN} wss://*.{\$BELFRY_DOMAIN} https://{\$BELFRY_DOMAIN}; worker-src 'self'; manifest-src 'self'; form-action 'self'"
  printf '%s\n' \
    "# <domain>/$name/: written by 'belfry app install $name'; do not edit." \
    "redir /$name /$name/ 308" \
    "handle /$name/* {" \
    "	import csp \"$csp\"" \
    "	@fresh path /$name/ /$name/index.html /$name/sw.js" \
    "	header @fresh Cache-Control \"no-cache\"" \
    "	root * /srv/apps" \
    "	try_files {path} /$name/index.html" \
    "	file_server" \
    "}"
}
# The apps a belfry ships (infra/shipped-apps/<name>/, built elsewhere: chat = the village app's
# belfry-chat build, its commit in .build). `belfry apply` installs each one that is missing, and
# updates the ones it installed itself when the shipped build changes; an app an admin removed
# (infra/data/apps/_removed/<name>) or replaced with their own build stays as it is.
SHIPPED_APPS="$INFRA/shipped-apps"
app_brand() {  # the community's name instead of the village's, and its own stylesheet
  local dir=$1
  BELFRY_NAME="$(env_get COMMUNITY_NAME)" python3 - "$dir" <<'PY' || true
import html, json, os, pathlib, sys
d, name = pathlib.Path(sys.argv[1]), os.environ.get("BELFRY_NAME", "")
idx = d / "index.html"
if idx.is_file():
    t = idx.read_text(encoding="utf-8")
    if name:
        t = t.replace("Open Source Village", html.escape(name)).replace('content="Village"', 'content="' + html.escape(name, quote=True) + '"')
    # the theme folder's custom.css (empty without one), last so it wins: skills/belfry-theme
    link = '<link rel="stylesheet" href="/theme/custom/own.css">'
    if link not in t and "</head>" in t:
        t = t.replace("</head>", link + "</head>", 1)
    idx.write_text(t, encoding="utf-8")
man = d / "manifest.webmanifest"
if name and man.is_file():
    m = json.loads(man.read_text(encoding="utf-8"))
    if m.get("name") == "Open Source Village":
        m["name"], m["short_name"] = name, name[:12]
    man.write_text(json.dumps(m, indent=2), encoding="utf-8")
PY
}
app_put() {  # NAME SRC: copy SRC into place and write its route (no proxy reload)
  local name=$1 src=$2
  mkdir -p "$APPS_DIR/_routes"
  rm -rf "${APPS_DIR:?}/.$name.new"
  cp -R "$src/." "$APPS_DIR/.$name.new/"
  app_brand "$APPS_DIR/.$name.new"
  chmod -R u=rwX,go=rX "$APPS_DIR/.$name.new"
  rm -rf "${APPS_DIR:?}/.$name.old"
  if [[ -d "$APPS_DIR/$name" ]]; then mv "$APPS_DIR/$name" "$APPS_DIR/.$name.old"; fi
  mv "$APPS_DIR/.$name.new" "$APPS_DIR/$name"
  app_route "$name" > "$APPS_DIR/_routes/$name.caddy"
  chmod 644 "$APPS_DIR/_routes/$name.caddy"
  rm -f "$APPS_DIR/_removed/$name"
}
shipped_apps() {
  local src name have
  for src in "$SHIPPED_APPS"/*/; do
    [[ -f "$src/index.html" ]] || continue
    name=$(basename "$src")
    [[ -e "$APPS_DIR/_removed/$name" ]] && continue
    if [[ -d "$APPS_DIR/$name" ]]; then
      have=$(cat "$APPS_DIR/$name/.build" 2>/dev/null || true)
      [[ -n "$have" ]] || continue  # an admin's own build
      if [[ "$have" == "$(cat "$src/.build" 2>/dev/null)" ]] && grep -q /theme/custom/own.css "$APPS_DIR/$name/index.html"; then continue; fi
      say "Updating the shipped app $name"
    else
      say "Installing the shipped app $name at apps.$(env_get BELFRY_DOMAIN)/$name/"
    fi
    app_put "$name" "$src"
  done
}
cmd_app() {
  case "${1:-list}" in
    install)
      local name=${2:?usage: belfry app install NAME DIR} src=${3:?usage: belfry app install NAME DIR}
      [[ "$name" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "an app name is 2 to 31 lowercase letters, digits or dashes"
      [[ "$APP_RESERVED" != *" $name "* ]] || die "$name is a path the signer uses on apps.<domain>; pick another name"
      [[ -f "$src/index.html" ]] || die "$src has no index.html (give the built app: its dist/ folder)"
      app_put "$name" "$src"
      reload_proxy
      record "App $name installed at apps.$(env_get BELFRY_DOMAIN)/$name/"
      say "https://apps.$(env_get BELFRY_DOMAIN)/$name/"
      ;;
    remove)
      local name=${2:?usage: belfry app remove NAME}
      [[ "$name" =~ ^[a-z][a-z0-9-]{1,30}$ && -d "$APPS_DIR/$name" ]] || die "no app $name"
      rm -f "$APPS_DIR/_routes/$name.caddy"
      mkdir -p "$APPS_DIR/_removed"; : > "$APPS_DIR/_removed/$name"  # a shipped app stays removed
      rm -rf "${APPS_DIR:?}/.$name.old"
      mv "$APPS_DIR/$name" "$APPS_DIR/.$name.old"
      reload_proxy
      record "App $name removed"
      say "Removed $name (its files are in $APPS_DIR/.$name.old)"
      ;;
    list)
      local f any=0
      for f in "$APPS_DIR"/_routes/*.caddy; do
        [[ -f "$f" ]] || continue
        any=1; f=$(basename "$f" .caddy)
        say "$f  https://apps.$(env_get BELFRY_DOMAIN)/$f/"
      done
      [[ $any = 1 ]] || say "No apps installed (belfry app install NAME DIR)"
      ;;
    *) die "usage: belfry app install NAME DIR | remove NAME | list" ;;
  esac
}

case "${1:-help}" in
  status) cmd_status ;;
  config) shift; cmd_config "$@" ;;
  apply) cmd_apply ;;
  add-steward) shift; [[ -n "${1:-}" ]] || die "usage: belfry add-steward EMAIL [NAME]"
    compose --profile app exec -T onboarding python -m belfry_onboarding add-steward "$@" ;;
  smoke) cmd_smoke ;;
  update) shift; cmd_update "$@" ;;
  version) cmd_version ;;
  update-request) cmd_update_request ;;
  homepage) shift; cmd_homepage "$@" ;;
  setup-code) shift; cmd_setup_code "$@" ;;
  setup-apply) cmd_setup_apply ;;
  setup-units) cmd_setup_units ;;
  theme) shift; cmd_theme "$@" ;;
  app) shift; cmd_app "$@" ;;
  logs) shift; compose --profile app logs -f --tail=100 "$@" ;;
  compose) shift; compose "$@" ;;
  help|-h|--help) sed -n '2,/^set -euo/p' "$SELF" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown command $1 (belfry help)" ;;
esac
