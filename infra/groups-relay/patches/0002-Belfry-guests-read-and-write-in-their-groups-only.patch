 zooid/groups.go      | 69 +++++++++++++++++++++++++++++++++++++++++
 zooid/guests_test.go | 74 ++++++++++++++++++++++++++++++++++++++++++++
 zooid/instance.go    | 15 +++++++--
 4 files changed, 159 insertions(+), 2 deletions(-)
 create mode 100644 zooid/guests_test.go

