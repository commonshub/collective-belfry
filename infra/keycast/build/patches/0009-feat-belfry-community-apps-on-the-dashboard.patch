diff --git a/api/src/api/http/apps.rs b/api/src/api/http/apps.rs
new file mode 100644
index 0000000..b37c59e
--- /dev/null
+++ b/api/src/api/http/apps.rs
@@ -0,0 +1,71 @@
+//! Belfry: the community apps the dashboard links to, so a participant who signs in here finds
+//! the chat and the calendar.
+//!
+//! | Variable | Meaning |
+//! | --- | --- |
+//! | `BELFRY_COMMUNITY_APPS` | `Name|URL|Description` entries separated by `;`, e.g. `Chat|https://chat.example|Messages;Calendar|https://calendar.example|Events`. Unset or empty: no apps, the card is hidden. |
+//!
+//! Entries without a name or with a URL that is not `http(s)://` are skipped.
+
+use axum::{
+    http::header,
+    response::{IntoResponse, Response},
+    Json,
+};
+use once_cell::sync::Lazy;
+use serde::Serialize;
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub(crate) struct CommunityApp {
+    name: String,
+    url: String,
+    description: String,
+}
+
+pub(crate) fn parse_apps(raw: &str) -> Vec<CommunityApp> {
+    raw.split(';')
+        .filter_map(|entry| {
+            let mut parts = entry.splitn(3, '|').map(str::trim);
+            let name = parts.next().filter(|n| !n.is_empty())?;
+            let url = parts
+                .next()
+                .filter(|u| u.starts_with("https://") || u.starts_with("http://"))?;
+            Some(CommunityApp {
+                name: name.to_string(),
+                url: url.to_string(),
+                description: parts.next().unwrap_or("").to_string(),
+            })
+        })
+        .collect()
+}
+
+static APPS: Lazy<Vec<CommunityApp>> =
+    Lazy::new(|| parse_apps(&std::env::var("BELFRY_COMMUNITY_APPS").unwrap_or_default()));
+
+/// `GET /api/user/apps`: the configured community apps (public configuration, no secrets).
+pub async fn get_apps() -> Response {
+    (
+        [(header::CACHE_CONTROL, "public, max-age=300")],
+        Json(serde_json::json!({ "apps": &*APPS })),
+    )
+        .into_response()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::parse_apps;
+
+    #[test]
+    fn parses_entries_and_skips_bad_ones() {
+        let apps = parse_apps(
+            " Chat | https://chat.x | Messages ;Calendar|https://cal.x;|https://nameless.x;Bad|javascript:alert(1)|x;;",
+        );
+        assert_eq!(apps.len(), 2);
+        assert_eq!(apps[0].name, "Chat");
+        assert_eq!(apps[0].url, "https://chat.x");
+        assert_eq!(apps[0].description, "Messages");
+        assert_eq!(apps[1].name, "Calendar");
+        assert_eq!(apps[1].description, "");
+        assert!(parse_apps("").is_empty());
+    }
+}
