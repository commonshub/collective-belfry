+
+    // Belfry: silent sign-in. Signed in but not approved: consent_required. Not signed in: try
+    // the upstream provider with prompt=none once (it comes back here with a session, or with
+    // oidc_failed set), then login_required.
+    if silent {
+        if user_pubkey.is_some() {
+            return Ok(silent_error(&params, "consent_required"));
+        }
+        if params.oidc_failed.is_none() && super::oidc::provider().is_some() {
+            let return_to = authorize_return_path(&original_uri);
+            let start = redirect_with_params(
+                "http://sentinel.invalid/api/auth/oidc/start",
+                &[("prompt", Some("none")), ("return_to", Some(&return_to))],
+            );
+            let start = start.trim_start_matches("http://sentinel.invalid");
+            let mut response = Redirect::to(start).into_response();
+            if clear_cookie {
+                response.headers_mut().append(
+                    axum::http::header::SET_COOKIE,
+                    axum::http::HeaderValue::from_static(
+                        "keycast_session=; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=0",
+                    ),
+                );
+            }
+            return Ok(response);
+        }
+        return Ok(silent_error(&params, "login_required"));
+    }
+
+    // Belfry: a trusted app's button goes straight to the upstream login when it is the only
+    // login (OIDC_HIDE_PASSWORD_LOGIN), instead of a page with a second "Sign in with …" button.
+    if user_pubkey.is_none() && !force_login && !has_byok_pubkey {
+        let oidc_only = super::oidc::provider().is_some_and(|p| p.config.hide_password_login);
+        if oidc_only && is_trusted_client(pool, &params.client_id, tenant_id).await? {
+            let return_to = authorize_return_path(&original_uri);
+            let start = redirect_with_params(
+                "http://sentinel.invalid/api/auth/oidc/start",
+                &[("return_to", Some(&return_to))],
+            );
+            return Ok(
+                Redirect::to(start.trim_start_matches("http://sentinel.invalid")).into_response(),
+            );
+        }
+    }
