+// ---------------------------------------------------------------------------------------------
+// Belfry: silent sign-in (prompt=none) and trusted first-party clients
+// ---------------------------------------------------------------------------------------------
+
+/// Client ids whose consent screen is skipped (`KEYCAST_TRUSTED_CLIENTS`, comma separated).
+/// A listed client only counts as trusted while it is also a registered client with at least
+/// one allowed redirect URI, so a trusted id can never send codes to an arbitrary origin.
+static TRUSTED_CLIENTS: once_cell::sync::Lazy<Vec<String>> = once_cell::sync::Lazy::new(|| {
+    parse_trusted_clients(std::env::var("KEYCAST_TRUSTED_CLIENTS").ok().as_deref())
+});
+
+pub fn parse_trusted_clients(raw: Option<&str>) -> Vec<String> {
+    raw.unwrap_or("")
+        .split(',')
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .map(str::to_string)
+        .collect()
+}
+
+async fn is_trusted_client(
+    pool: &sqlx::PgPool,
+    client_id: &str,
+    tenant_id: i64,
+) -> Result<bool, OAuthError> {
+    if !TRUSTED_CLIENTS.iter().any(|c| c == client_id) {
+        return Ok(false);
+    }
+    let repo = keycast_core::repositories::RegisteredClientRepository::new(pool.clone());
+    let registered = repo
+        .get_allowed_redirect_uris(client_id, tenant_id)
+        .await
+        .map_err(|e| OAuthError::ServerError(format!("registered client lookup: {e}")))?;
+    let trusted = registered.is_some_and(|uris| !uris.is_empty());
+    if !trusted {
+        tracing::warn!(
+            client_id,
+            "client is in KEYCAST_TRUSTED_CLIENTS but not registered with redirect URIs; consent stays on"
+        );
+    }
+    Ok(trusted)
+}
+
+/// `redirect_uri` with the given query parameters appended (properly encoded, keeping any
+/// query the URI already has).
+pub fn redirect_with_params(redirect_uri: &str, params: &[(&str, Option<&str>)]) -> String {
+    match reqwest::Url::parse(redirect_uri) {
+        Ok(mut url) => {
+            {
+                let mut q = url.query_pairs_mut();
+                for (k, v) in params {
+                    if let Some(v) = v {
+                        q.append_pair(k, v);
+                    }
+                }
+            }
+            url.to_string()
+        }
+        Err(_) => redirect_uri.to_string(),
+    }
+}
+
+/// The OAuth error answer of a silent request: back to the (already validated) redirect URI.
+fn silent_error(params: &AuthorizeRequest, error: &str) -> Response {
+    tracing::info!(client_id = %params.client_id, error, "prompt=none: answering with an error");
+    Redirect::to(&redirect_with_params(
+        &params.redirect_uri,
+        &[("error", Some(error)), ("state", params.state.as_deref())],
+    ))
+    .into_response()
+}
+
+/// The authorize request as a same-origin path, for the upstream login to come back to.
+fn authorize_return_path(uri: &axum::http::Uri) -> String {
+    let path = uri.path();
+    match uri.query() {
+        Some(q) => format!("{path}?{q}"),
+        None => path.to_string(),
+    }
+}
+
