diff --git a/api/src/custody.rs b/api/src/custody.rs
new file mode 100644
index 0000000..919da60
--- /dev/null
+++ b/api/src/custody.rs
@@ -0,0 +1,122 @@
+// ABOUTME: Belfry: participant keys derived from a custody seed (recoverable from the seed + Odoo)
+// ABOUTME: The seed is read from a file in memory on every use, so a steward can unlock it live
+
+//! Derived participant keys (decision of 2026-10-24).
+//!
+//! With `KEYCAST_CUSTODY_SEED_FILE` set, preload-user creates a participant's key as
+//!
+//! `HKDF-SHA256(salt "belfry/custody/v1", IKM = seed, info "belfry/nostr/v1/<vine_id>/<version>")`
+//!
+//! (the version comes from Odoo; a leaked key is replaced by raising it). The file holds the
+//! 32-byte seed as 64 hex characters and lives in memory only (tmpfs, `/run/belfry` on the VM),
+//! unlocked by a steward with a YubiKey (`infra/scripts/custody-seed.sh`). It is read on every
+//! use: unlocking needs no restart, and a locked seed makes preload answer 503 instead of
+//! creating a random key that could not be recovered. Keys are still stored encrypted
+//! (`personal_keys`) for signing; the seed is only needed to create or recover them.
+//!
+//! Unset: keys are random, as upstream. Belfry can always recompute a derived key, so
+//! self-custody means moving to a new key (`self_custody.rs` refuses "keep this key").
+
+use hkdf::Hkdf;
+use nostr_sdk::{Keys, SecretKey};
+use sha2::Sha256;
+
+const SALT: &[u8] = b"belfry/custody/v1";
+
+/// True when derived keys are configured (whether or not the seed is unlocked right now).
+pub fn configured() -> bool {
+    seed_file().is_some()
+}
+
+fn seed_file() -> Option<String> {
+    std::env::var("KEYCAST_CUSTODY_SEED_FILE")
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum SeedError {
+    /// Configured, but the file is not there: a steward has to unlock the seed.
+    Locked,
+    /// The file does not hold 64 hex characters.
+    Malformed,
+}
+
+/// The seed: `Ok(None)` when derived keys are not configured.
+pub fn seed() -> Result<Option<[u8; 32]>, SeedError> {
+    let Some(path) = seed_file() else {
+        return Ok(None);
+    };
+    let text = std::fs::read_to_string(&path).map_err(|_| SeedError::Locked)?;
+    parse_seed(&text).map(Some)
+}
+
+fn parse_seed(text: &str) -> Result<[u8; 32], SeedError> {
+    let bytes = hex::decode(text.trim()).map_err(|_| SeedError::Malformed)?;
+    bytes.try_into().map_err(|_| SeedError::Malformed)
+}
+
+/// The participant's key for `vine_id` and `version`.
+pub fn derive_keys(seed: &[u8; 32], vine_id: &str, version: u32) -> Keys {
+    let hk = Hkdf::<Sha256>::new(Some(SALT), seed);
+    // A value outside the curve order (probability ~2^-128) moves on to the next counter.
+    for counter in 0u32.. {
+        let info = if counter == 0 {
+            format!("belfry/nostr/v1/{vine_id}/{version}")
+        } else {
+            format!("belfry/nostr/v1/{vine_id}/{version}#{counter}")
+        };
+        let mut out = [0u8; 32];
+        hk.expand(info.as_bytes(), &mut out)
+            .expect("32 bytes is a valid HKDF-SHA256 output length");
+        if let Ok(secret) = SecretKey::from_slice(&out) {
+            return Keys::new(secret);
+        }
+    }
+    unreachable!("the counter space is never exhausted")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn derivation_follows_the_documented_hkdf() {
+        // Reproducible with any HKDF-SHA256: seed 32 x 0x07, salt "belfry/custody/v1",
+        // info "belfry/nostr/v1/odoo-partner-42/0" (infra/scripts/custody-seed.sh derive).
+        let seed = [7u8; 32];
+        let keys = derive_keys(&seed, "odoo-partner-42", 0);
+        assert_eq!(
+            keys.secret_key().to_secret_hex(),
+            "67fe87d7cdac7cb85d61f170f6d898a157f6450f5b0c750a29442899fc186392"
+        );
+        // stable, per partner, per version
+        assert_eq!(
+            derive_keys(&seed, "odoo-partner-42", 0).public_key(),
+            keys.public_key()
+        );
+        assert_ne!(
+            derive_keys(&seed, "odoo-partner-43", 0).public_key(),
+            keys.public_key()
+        );
+        assert_ne!(
+            derive_keys(&seed, "odoo-partner-42", 1).public_key(),
+            keys.public_key()
+        );
+        assert_ne!(
+            derive_keys(&[8u8; 32], "odoo-partner-42", 0).public_key(),
+            keys.public_key()
+        );
+    }
+
+    #[test]
+    fn seed_files_are_64_hex_characters() {
+        assert_eq!(
+            parse_seed(&format!("{}\n", "ab".repeat(32))),
+            Ok([0xab; 32])
+        );
+        assert_eq!(parse_seed("abc"), Err(SeedError::Malformed));
+        assert_eq!(parse_seed(&"zz".repeat(32)), Err(SeedError::Malformed));
+    }
+}
