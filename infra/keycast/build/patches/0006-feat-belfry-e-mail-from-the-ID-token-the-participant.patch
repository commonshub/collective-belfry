diff --git a/api/src/api/http/pass.rs b/api/src/api/http/pass.rs
new file mode 100644
index 0000000..5359863
--- /dev/null
+++ b/api/src/api/http/pass.rs
@@ -0,0 +1,137 @@
+//! Belfry: the signed-in participant's pass (tier, validity, state, claim link), read server to
+//! server from the onboarding service so the dashboard can show it before and after the claim.
+//!
+//! | Variable | Meaning |
+//! | --- | --- |
+//! | `BELFRY_PASS_INFO_URL` | Base URL of the onboarding service, e.g. `http://onboarding:8100`. Unset: `GET /api/user/pass` answers 503. |
+//! | `PASS_INFO_TOKEN` | Bearer token for `GET <base>/admin/partners/<id>/pass`. |
+//!
+//! The account's `vine_id` is `odoo-partner-<id>`; the id is the partner the pass belongs to.
+//! The onboarding service's JSON is passed through unchanged: `state`, `tier`, `tier_name`,
+//! `date_start`, `date_end`, `member_number`, `npub`, `claim_url` (null once claimed or closed).
+
+use axum::{
+    extract::State,
+    http::{header, HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+    Json,
+};
+use once_cell::sync::Lazy;
+use sqlx::PgPool;
+use std::time::Duration;
+
+use super::auth::AuthError;
+
+struct PassInfoConfig {
+    base_url: String,
+    token: String,
+    client: reqwest::Client,
+}
+
+static CONFIG: Lazy<Option<PassInfoConfig>> = Lazy::new(|| {
+    let get = |name: &str| {
+        std::env::var(name)
+            .ok()
+            .map(|v| v.trim().to_string())
+            .filter(|v| !v.is_empty())
+    };
+    let (Some(base_url), Some(token)) = (get("BELFRY_PASS_INFO_URL"), get("PASS_INFO_TOKEN"))
+    else {
+        tracing::warn!("BELFRY_PASS_INFO_URL/PASS_INFO_TOKEN unset: /api/user/pass is unavailable");
+        return None;
+    };
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(5))
+        .build()
+        .expect("reqwest client");
+    Some(PassInfoConfig {
+        base_url: base_url.trim_end_matches('/').to_string(),
+        token,
+        client,
+    })
+});
+
+/// The Odoo partner id behind a `vine_id`, if it has Belfry's shape.
+pub(crate) fn partner_id(vine_id: &str) -> Option<&str> {
+    vine_id
+        .strip_prefix("odoo-partner-")
+        .filter(|id| !id.is_empty() && id.bytes().all(|b| b.is_ascii_digit()))
+}
+
+fn json_status(status: StatusCode, error: &str) -> Response {
+    (
+        status,
+        [(header::CACHE_CONTROL, "no-store")],
+        Json(serde_json::json!({ "error": error })),
+    )
+        .into_response()
+}
+
+/// `GET /api/user/pass` (session cookie or bearer): the participant's pass, 404 without one.
+pub async fn get_pass(
+    tenant: crate::api::tenant::TenantExtractor,
+    State(pool): State<PgPool>,
+    headers: HeaderMap,
+) -> Result<Response, AuthError> {
+    let tenant_id = tenant.0.id;
+    let pubkey = super::auth::extract_user_from_token(&headers, tenant_id).await?;
+    let Some(cfg) = CONFIG.as_ref() else {
+        return Ok(json_status(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "pass_info_not_configured",
+        ));
+    };
+    let vine_id: Option<Option<String>> =
+        sqlx::query_scalar("SELECT vine_id FROM users WHERE pubkey = $1 AND tenant_id = $2")
+            .bind(&pubkey)
+            .bind(tenant_id)
+            .fetch_optional(&pool)
+            .await
+            .map_err(AuthError::Database)?;
+    let Some(partner) = vine_id.flatten().as_deref().and_then(partner_id).map(str::to_owned)
+    else {
+        return Ok(json_status(StatusCode::NOT_FOUND, "no_pass"));
+    };
+    let url = format!("{}/admin/partners/{}/pass", cfg.base_url, partner);
+    let resp = cfg
+        .client
+        .get(&url)
+        .bearer_auth(&cfg.token)
+        .send()
+        .await
+        .map_err(|e| AuthError::Internal(format!("pass info service: {e}")))?;
+    match resp.status() {
+        StatusCode::OK => {
+            let body: serde_json::Value = resp
+                .json()
+                .await
+                .map_err(|e| AuthError::Internal(format!("pass info service: {e}")))?;
+            Ok((
+                StatusCode::OK,
+                [(header::CACHE_CONTROL, "no-store")],
+                Json(body),
+            )
+                .into_response())
+        }
+        StatusCode::NOT_FOUND => Ok(json_status(StatusCode::NOT_FOUND, "no_pass")),
+        status => {
+            tracing::warn!(%status, "pass info service answered");
+            Err(AuthError::Internal(format!(
+                "pass info service answered {status}"
+            )))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::partner_id;
+
+    #[test]
+    fn partner_id_accepts_belfry_shape_only() {
+        assert_eq!(partner_id("odoo-partner-42"), Some("42"));
+        assert_eq!(partner_id("odoo-partner-"), None);
+        assert_eq!(partner_id("odoo-partner-4/../x"), None);
+        assert_eq!(partner_id("vine-123"), None);
+    }
+}
