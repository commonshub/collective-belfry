+const PASS_STATE_LABELS: Record<string, string> = {
+	active: 'Active',
+	pending: 'Awaiting payment',
+	revoked: 'Revoked',
+	expired: 'Expired'
+};
+
+function passStateLabel(state: string): string {
+	return PASS_STATE_LABELS[state] ?? state;
