+    /// Store an e-mail the OpenID Provider vouched for (Belfry: the participant signed in through a
+    /// magic link to that address), already verified. Returns `false` when nothing changed: the
+    /// row already holds the verified address, or another account of the tenant holds it (the
+    /// unique index would refuse the update).
+    pub async fn set_email_from_idp(
+        &self,
+        pubkey: &str,
+        email: &str,
+        tenant_id: i64,
+    ) -> Result<bool, RepositoryError> {
+        let result = sqlx::query(
+            "UPDATE users
+             SET email = $1, email_verified = true, updated_at = $2
+             WHERE pubkey = $3 AND tenant_id = $4
+               AND (email IS DISTINCT FROM $1 OR email_verified IS NOT TRUE)
+               AND NOT EXISTS (
+                   SELECT 1 FROM users o WHERE o.tenant_id = $4 AND o.email = $1 AND o.pubkey <> $3
+               )",
+        )
+        .bind(email)
+        .bind(Utc::now())
+        .bind(pubkey)
+        .bind(tenant_id)
+        .execute(&self.pool)
+        .await?;
+        Ok(result.rows_affected() > 0)
+    }
