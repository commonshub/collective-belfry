From c500a45b5c6a053b7453630d30be07e3a9b1183a Mon Sep 17 00:00:00 2001
From: friedger <mail@friedger.de>
Date: Sat, 24 Oct 2026 13:21:14 +0200
Subject: [PATCH] feat(belfry): derive_secret, per-purpose secrets from the
 user's key

The village wallet's backup seed and its nutzap receiving key derive from
the participant's Nostr key, so signing in on a new device restores the
wallet; NIP-61 forbids receiving on the main key itself.

HTTP RPC method derive_secret [purpose] returns HKDF-SHA256(IKM = the
32-byte secret key, salt "keycast/derive/v1", info = purpose) as hex.
Allowed only for OAuth clients and purposes listed in
KEYCAST_DERIVE_SECRETS (client:purpose|purpose;...), e.g.
belfry-wallet:cashu-wallet-v1|cashu-nutzap-v1. Unset: refused for all.
Anyone holding the key reproduces the secrets, so a participant who takes
custody of the key keeps them.
---
 api/src/api/http/nostr_rpc.rs        | 101 +++++++++++++++++++++++++++
 api/src/handlers/http_rpc_handler.rs |  10 +++
 core/src/signing_session.rs          |  40 +++++++++++
 3 files changed, 151 insertions(+)

diff --git a/api/src/api/http/nostr_rpc.rs b/api/src/api/http/nostr_rpc.rs
index b5c4a57..cd36fc6 100644
--- a/api/src/api/http/nostr_rpc.rs
+++ b/api/src/api/http/nostr_rpc.rs
@@ -331,6 +331,49 @@ async fn nostr_rpc_inner(
             JsonValue::String(plaintext.expose_secret().to_string())
         }
 
+        "derive_secret" => {
+            // Belfry: per-purpose secrets for first-party apps (the village wallet's seed and
+            // nutzap key), allowed per OAuth client by KEYCAST_DERIVE_SECRETS.
+            let purpose = req
+                .params
+                .first()
+                .and_then(|v| v.as_str())
+                .ok_or_else(|| RpcError::InvalidParams("Missing purpose parameter".into()))?;
+            let client_id = if handler.is_oauth() {
+                i32::try_from(handler.authorization_id())
+                    .ok()
+                    .map(|id| (id, pool.clone()))
+            } else {
+                None
+            };
+            let client_id = match client_id {
+                Some((id, pool)) => {
+                    keycast_core::types::oauth_authorization::OAuthAuthorization::find(
+                        &pool, tenant_id, id,
+                    )
+                    .await
+                    .ok()
+                    .and_then(|a| a.client_id)
+                }
+                None => None,
+            };
+            if !derive_allowed(&DERIVE_SECRETS, client_id.as_deref(), purpose) {
+                tracing::warn!(
+                    client_id = client_id.as_deref().unwrap_or("-"),
+                    purpose,
+                    "derive_secret refused"
+                );
+                return Err(RpcError::Auth(AuthError::Forbidden(
+                    "This app may not derive that secret".to_string(),
+                )));
+            }
+            let secret = handler
+                .derive_secret(purpose)
+                .map_err(|_| RpcError::Auth(AuthError::InvalidToken))?;
+            log_activity(&auth_state, handler.is_oauth(), handler.authorization_id());
+            JsonValue::String(hex::encode(secret))
+        }
+
         "nip17_unwrap_batch" => {
             // Size cap keeps the request under axum's 2 MB default body limit and
             // bounds per-request work (mirrors the batch_lookup_users cap precedent).
@@ -1507,6 +1550,38 @@ fn parse_decrypt_params(params: &[JsonValue]) -> Result<(PublicKey, String), Rpc
     Ok((pubkey, ciphertext.to_string()))
 }
 
+/// Belfry: `KEYCAST_DERIVE_SECRETS` = `client:purpose|purpose;client:purpose`, e.g.
+/// `belfry-wallet:cashu-wallet-v1|cashu-nutzap-v1`. Unset: no client may derive.
+static DERIVE_SECRETS: once_cell::sync::Lazy<Vec<(String, Vec<String>)>> =
+    once_cell::sync::Lazy::new(|| {
+        parse_derive_secrets(&std::env::var("KEYCAST_DERIVE_SECRETS").unwrap_or_default())
+    });
+
+fn parse_derive_secrets(raw: &str) -> Vec<(String, Vec<String>)> {
+    raw.split(';')
+        .filter_map(|entry| {
+            let (client, purposes) = entry.split_once(':')?;
+            let purposes: Vec<String> = purposes
+                .split('|')
+                .map(str::trim)
+                .filter(|p| !p.is_empty())
+                .map(str::to_string)
+                .collect();
+            let client = client.trim();
+            (!client.is_empty() && !purposes.is_empty()).then(|| (client.to_string(), purposes))
+        })
+        .collect()
+}
+
+fn derive_allowed(rules: &[(String, Vec<String>)], client_id: Option<&str>, purpose: &str) -> bool {
+    let Some(client_id) = client_id else {
+        return false;
+    };
+    rules
+        .iter()
+        .any(|(c, purposes)| c == client_id && purposes.iter().any(|p| p == purpose))
+}
+
 /// Parse sign_canonical params: [base64_payload]
 fn parse_canonical_payload_params(params: &[JsonValue]) -> Result<Vec<u8>, RpcError> {
     if params.len() != 1 {
@@ -1723,6 +1798,32 @@ mod tests {
     use p256::ecdsa::{Signature as P256Signature, SigningKey};
     use rand::rngs::OsRng;
 
+    #[test]
+    fn derive_secrets_are_allowed_per_client_and_purpose() {
+        let rules = parse_derive_secrets(
+            " belfry-wallet:cashu-wallet-v1| cashu-nutzap-v1 ;other: ;:x;broken",
+        );
+        assert_eq!(rules.len(), 1);
+        assert!(derive_allowed(
+            &rules,
+            Some("belfry-wallet"),
+            "cashu-wallet-v1"
+        ));
+        assert!(derive_allowed(
+            &rules,
+            Some("belfry-wallet"),
+            "cashu-nutzap-v1"
+        ));
+        assert!(!derive_allowed(&rules, Some("belfry-wallet"), "other"));
+        assert!(!derive_allowed(
+            &rules,
+            Some("belfry-chat"),
+            "cashu-wallet-v1"
+        ));
+        assert!(!derive_allowed(&rules, None, "cashu-wallet-v1"));
+        assert!(parse_derive_secrets("").is_empty());
+    }
+
     #[test]
     fn cold_path_pool_exhaustion_is_a_retryable_503_without_leaking_detail() {
         use keycast_core::repositories::RepositoryError;
diff --git a/api/src/handlers/http_rpc_handler.rs b/api/src/handlers/http_rpc_handler.rs
index d280adb..0d37070 100644
--- a/api/src/handlers/http_rpc_handler.rs
+++ b/api/src/handlers/http_rpc_handler.rs
@@ -479,6 +479,16 @@ impl HttpRpcHandler {
             .map_err(map_encryption_error)
     }
 
+    /// Belfry: a secret derived from the user's key for `purpose`, after the validity check.
+    /// Which client may derive which purpose is decided by the RPC layer
+    /// (`KEYCAST_DERIVE_SECRETS`).
+    pub fn derive_secret(&self, purpose: &str) -> Result<[u8; 32], HandlerError> {
+        if !self.is_valid() {
+            return Err(HandlerError::AuthorizationInvalid);
+        }
+        Ok(self.signing.derive_secret(purpose))
+    }
+
     /// Decrypt ciphertext using NIP-44 after checking validity and permissions
     /// (CPU-bound crypto runs on spawn_blocking via SigningSession)
     /// Returns DecryptedPlaintext (SecretString) for automatic memory zeroization on drop.
diff --git a/core/src/signing_session.rs b/core/src/signing_session.rs
index 9b21702..e53ae1b 100644
--- a/core/src/signing_session.rs
+++ b/core/src/signing_session.rs
@@ -12,6 +12,15 @@ use tokio::task::JoinError;
 
 use crate::secret_types::DecryptedPlaintext;
 
+/// HKDF-SHA256 derivation behind [`SigningSession::derive_secret`].
+pub fn derive_secret_from(secret_key: &[u8; 32], purpose: &str) -> [u8; 32] {
+    let hk = hkdf::Hkdf::<Sha256>::new(Some(b"keycast/derive/v1"), secret_key);
+    let mut out = [0u8; 32];
+    hk.expand(purpose.as_bytes(), &mut out)
+        .expect("32 bytes is a valid HKDF-SHA256 output length");
+    out
+}
+
 /// Canonicalize an UnsignedEvent's author pubkey to match the signer keys.
 /// If the supplied pubkey differs from the signer pubkey, this updates the
 /// event's pubkey and clears its id so it's recomputed over the canonical pubkey.
@@ -131,6 +140,14 @@ impl SigningSession {
         .await?
     }
 
+    /// Belfry: a 32-byte secret derived from the user's key for one `purpose`
+    /// (HKDF-SHA256, IKM = the 32-byte secret key, salt `keycast/derive/v1`, info = purpose).
+    /// Distinct purposes give independent secrets; none of them reveals the key. Anyone holding
+    /// the key can reproduce them, so participants who take their key keep their derived secrets.
+    pub fn derive_secret(&self, purpose: &str) -> [u8; 32] {
+        derive_secret_from(&self.keys.secret_key().secret_bytes(), purpose)
+    }
+
     /// Encrypt plaintext using NIP-44 (CPU-bound crypto runs on spawn_blocking)
     pub async fn nip44_encrypt(
         &self,
@@ -171,6 +188,29 @@ impl SigningSession {
 mod tests {
     use super::*;
 
+    #[test]
+    fn derived_secrets_follow_the_documented_hkdf() {
+        // HKDF-SHA256(IKM = 32 x 0x01, salt "keycast/derive/v1", info = purpose), reproducible
+        // with any HKDF implementation (the Belfry wallet README shows it in Python).
+        let key = [1u8; 32];
+        assert_eq!(
+            hex::encode(derive_secret_from(&key, "cashu-wallet-v1")),
+            "71b029b419dbc314159f9548e501c25b87b30d740ffdc2b06c005afe266593cc"
+        );
+        assert_eq!(
+            hex::encode(derive_secret_from(&key, "cashu-nutzap-v1")),
+            "27594c30a00c51b02dfcd2a88ba6d486598d0ae4cf50a7e4d9475acd79f74ac3"
+        );
+        let keys = Keys::generate();
+        let session = SigningSession::new(keys.clone());
+        assert_ne!(session.derive_secret("a"), session.derive_secret("b"));
+        assert_ne!(
+            session.derive_secret("a"),
+            keys.secret_key().secret_bytes(),
+            "a derived secret is never the key itself"
+        );
+    }
+
     #[tokio::test]
     async fn nip44_decrypt_rejects_a_payload_below_the_minimum_size() {
         use base64::{engine::general_purpose::STANDARD, Engine as _};
