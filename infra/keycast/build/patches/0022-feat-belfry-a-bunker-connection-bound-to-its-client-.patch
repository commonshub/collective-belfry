+    let auth_id = if client_pubkey.is_some() {
+        // Bound to the named client from the start; a key linked to another account is refused.
+        match oauth_auth_repo.create_bound_to_client(params).await? {
+            Some(id) => id,
+            None => {
+                tracing::warn!(
+                    "Refused a bunker for user {}: the client key is linked to another account",
+                    user_pubkey
+                );
+                return Ok(coded_error_response(
+                    StatusCode::CONFLICT,
+                    "This client key is already linked to another account.",
+                    CLIENT_KEY_TAKEN_CODE,
+                ));
+            }
+        }
+    } else {
+        oauth_auth_repo.create(params).await?
+    };
 
