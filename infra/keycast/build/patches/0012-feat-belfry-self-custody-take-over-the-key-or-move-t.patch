--- /dev/null
+++ b/api/src/api/http/self_custody.rs
@@ -0,0 +1,440 @@
+// ABOUTME: Belfry: participants take custody of their Nostr key or move the account to a key of their own
+// ABOUTME: Proof by a signed challenge; Keycast deletes its copy and tells the onboarding service
+
+//! Self-custody (decisions of 2026-10-24).
+//!
+//! 1. `GET /api/user/self-custody/challenge` (session): a challenge bound to the account and
+//!    valid for ten minutes, stateless (HMAC with the server key).
+//! 2. `POST /api/user/self-custody` (session, signed in within `OIDC_REAUTH_WINDOW_SECS` like the
+//!    key export) with `{"event": <kind 27235 event>}` carrying `["challenge", …]`, signed by the
+//!    key the participant wants:
+//!    - the account's own key ("take over"): Keycast deletes its encrypted copy and every app
+//!      authorization. The pubkey, the NIP-05 name and the pass stay as they are.
+//!    - another key ("bring a new key"): the account moves to it. A new users row with the new
+//!      pubkey takes over the username (NIP-05), the e-mail, the `vine_id` (the Odoo partner) and
+//!      the status; the sign-in link (`oidc_identities`) moves along; the old row is orphaned
+//!      and its key and authorizations deleted. The session cookie is cleared (sign in again).
+//!
+//! Either way Keycast no longer holds a key for the account: apps sign in with the participant's
+//! own signer (`/api/oauth/authorize` answers such accounts with `access_denied`, see
+//! `oauth.rs`), and `derive_secret` stops (no key). With `BELFRY_KEY_CHANGED_URL` and
+//! `BELFRY_HOOK_TOKEN` set, Keycast posts `{vine_id, old_pubkey, new_pubkey}` to the onboarding
+//! service, which moves the pass's npub and the relay whitelist.
+
+use axum::{
+    extract::State,
+    http::{header, HeaderMap},
+    response::{IntoResponse, Response},
+    Json,
+};
+use hmac::{Hmac, Mac};
+use nostr_sdk::{Event, JsonUtil, Kind};
+use once_cell::sync::Lazy;
+use serde::{Deserialize, Serialize};
+use sha2::Sha256;
+use std::time::Duration;
+
+use super::auth::{
+    extract_user_from_token, oidc_reauth_window_secs, reauth_is_fresh, session_auth_time, AuthError,
+};
+use super::routes::AuthState;
+
+const CHALLENGE_TTL_SECS: u64 = 600;
+const MAX_EVENT_SKEW_SECS: i64 = 600;
+
+fn now_unix() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+fn challenge_mac(secret: &[u8], tenant_id: i64, pubkey: &str, expires: u64) -> String {
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("any key size");
+    mac.update(format!("keycast/self-custody/v1|{tenant_id}|{pubkey}|{expires}").as_bytes());
+    hex::encode(mac.finalize().into_bytes())
+}
+
+/// `<expires>.<hmac>` for this account.
+pub fn make_challenge(secret: &[u8], tenant_id: i64, pubkey: &str, now: u64) -> String {
+    let expires = now + CHALLENGE_TTL_SECS;
+    format!(
+        "{expires}.{}",
+        challenge_mac(secret, tenant_id, pubkey, expires)
+    )
+}
+
+pub fn challenge_valid(
+    secret: &[u8],
+    tenant_id: i64,
+    pubkey: &str,
+    challenge: &str,
+    now: u64,
+) -> bool {
+    let Some((expires, mac)) = challenge.split_once('.') else {
+        return false;
+    };
+    let Ok(expires) = expires.parse::<u64>() else {
+        return false;
+    };
+    expires > now
+        && expires <= now + CHALLENGE_TTL_SECS
+        && subtle::ConstantTimeEq::ct_eq(
+            challenge_mac(secret, tenant_id, pubkey, expires).as_bytes(),
+            mac.as_bytes(),
+        )
+        .into()
+}
+
+#[derive(Serialize)]
+pub struct ChallengeResponse {
+    challenge: String,
+    kind: u16,
+    expires_in: u64,
+}
+
+/// GET /api/user/self-custody/challenge
+pub async fn challenge(
+    tenant: crate::api::tenant::TenantExtractor,
+    State(auth_state): State<AuthState>,
+    headers: HeaderMap,
+) -> Result<Json<ChallengeResponse>, AuthError> {
+    let pubkey = extract_user_from_token(&headers, tenant.0.id).await?;
+    let secret = auth_state.state.server_keys.secret_key().to_secret_bytes();
+    Ok(Json(ChallengeResponse {
+        challenge: make_challenge(&secret, tenant.0.id, &pubkey, now_unix()),
+        kind: Kind::HttpAuth.as_u16(),
+        expires_in: CHALLENGE_TTL_SECS,
+    }))
+}
+
+#[derive(Deserialize)]
+pub struct CompleteRequest {
+    event: serde_json::Value,
+}
+
+#[derive(Serialize)]
+pub struct CompleteResponse {
+    outcome: &'static str,
+    pubkey: String,
+    authorizations_revoked: usize,
+    pass_updated: bool,
+}
+
+/// The key the event proves, if the event is a valid answer to this account's challenge.
+pub fn proven_key(
+    event_json: &str,
+    secret: &[u8],
+    tenant_id: i64,
+    account: &str,
+    now: u64,
+) -> Result<String, &'static str> {
+    let event = Event::from_json(event_json).map_err(|_| "not a Nostr event")?;
+    if event.kind != Kind::HttpAuth {
+        return Err("the event must be of kind 27235");
+    }
+    event
+        .verify()
+        .map_err(|_| "the signature does not verify")?;
+    if (now as i64 - event.created_at.as_secs() as i64).abs() > MAX_EVENT_SKEW_SECS {
+        return Err("the event is too old or from the future");
+    }
+    let challenge = event
+        .tags
+        .iter()
+        .find(|t| t.as_slice().first().map(String::as_str) == Some("challenge"))
+        .and_then(|t| t.as_slice().get(1).cloned())
+        .ok_or("the event carries no challenge")?;
+    if !challenge_valid(secret, tenant_id, account, &challenge, now) {
+        return Err("the challenge is invalid or expired; start again");
+    }
+    Ok(event.pubkey.to_hex())
+}
+
+/// POST /api/user/self-custody
+pub async fn complete(
+    tenant: crate::api::tenant::TenantExtractor,
+    State(auth_state): State<AuthState>,
+    headers: HeaderMap,
+    Json(req): Json<CompleteRequest>,
+) -> Result<Response, AuthError> {
+    let tenant_id = tenant.0.id;
+    let account = extract_user_from_token(&headers, tenant_id).await?;
+    let auth_time = session_auth_time(&headers, tenant_id).await?;
+    if !reauth_is_fresh(auth_time, now_unix(), oidc_reauth_window_secs()) {
+        return Err(AuthError::Forbidden(
+            "Sign in again through your identity provider, then repeat this step".to_string(),
+        ));
+    }
+    let secret = auth_state.state.server_keys.secret_key().to_secret_bytes();
+    let target = proven_key(
+        &req.event.to_string(),
+        &secret,
+        tenant_id,
+        &account,
+        now_unix(),
+    )
+    .map_err(|m| AuthError::BadRequest(m.to_string()))?;
+
+    let pool = &auth_state.state.db;
+    let mut tx = pool.begin().await.map_err(AuthError::Database)?;
+    let bunkers: Vec<String> = sqlx::query_scalar(
+        "SELECT bunker_public_key FROM oauth_authorizations WHERE user_pubkey = $1 AND tenant_id = $2",
+    )
+    .bind(&account)
+    .bind(tenant_id)
+    .fetch_all(&mut *tx)
+    .await
+    .map_err(AuthError::Database)?;
+    let had_key: bool = sqlx::query_scalar(
+        "SELECT EXISTS (SELECT 1 FROM personal_keys WHERE user_pubkey = $1 AND tenant_id = $2)",
+    )
+    .bind(&account)
+    .bind(tenant_id)
+    .fetch_one(&mut *tx)
+    .await
+    .map_err(AuthError::Database)?;
+
+    let outcome = if target == account {
+        if !had_key {
+            return Err(AuthError::BadRequest(
+                "Belfry holds no key for this account any more".to_string(),
+            ));
+        }
+        "took_custody"
+    } else {
+        let taken: bool =
+            sqlx::query_scalar("SELECT EXISTS (SELECT 1 FROM users WHERE pubkey = $1)")
+                .bind(&target)
+                .fetch_one(&mut *tx)
+                .await
+                .map_err(AuthError::Database)?;
+        if taken {
+            return Err(AuthError::BadRequest(
+                "That key already belongs to an account".to_string(),
+            ));
+        }
+        move_identity(&mut tx, tenant_id, &account, &target).await?;
+        "moved_to_own_key"
+    };
+    sqlx::query("DELETE FROM oauth_authorizations WHERE user_pubkey = $1 AND tenant_id = $2")
+        .bind(&account)
+        .bind(tenant_id)
+        .execute(&mut *tx)
+        .await
+        .map_err(AuthError::Database)?;
+    sqlx::query("DELETE FROM personal_keys WHERE user_pubkey = $1")
+        .bind(&account)
+        .execute(&mut *tx)
+        .await
+        .map_err(AuthError::Database)?;
+    let vine_id: Option<String> =
+        sqlx::query_scalar("SELECT vine_id FROM users WHERE pubkey = $1 AND tenant_id = $2")
+            .bind(&target)
+            .bind(tenant_id)
+            .fetch_optional(&mut *tx)
+            .await
+            .map_err(AuthError::Database)?
+            .flatten();
+    tx.commit().await.map_err(AuthError::Database)?;
+
+    if let Some(tx) = &auth_state.auth_tx {
+        use keycast_core::authorization_channel::AuthorizationCommand;
+        for bunker_pubkey in &bunkers {
+            let _ = tx
+                .send(AuthorizationCommand::Remove {
+                    bunker_pubkey: bunker_pubkey.clone(),
+                })
+                .await;
+        }
+    }
+    tracing::info!(
+        event = "self_custody",
+        outcome,
+        tenant_id,
+        old_pubkey = %account,
+        new_pubkey = %target,
+        revoked = bunkers.len(),
+        "Keycast no longer holds this account's key"
+    );
+    let pass_updated = match vine_id {
+        Some(v) => notify_onboarding(&v, &account, &target).await,
+        None => false,
+    };
+
+    let body = Json(CompleteResponse {
+        outcome,
+        pubkey: target.clone(),
+        authorizations_revoked: bunkers.len(),
+        pass_updated,
+    });
+    if target != account {
+        // The session names the old pubkey; signing in again lands on the moved account.
+        let clear = "keycast_session=; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=0";
+        return Ok(([(header::SET_COOKIE, clear)], body).into_response());
+    }
+    Ok(body.into_response())
+}
+
+async fn move_identity(
+    tx: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+    tenant_id: i64,
+    old: &str,
+    new: &str,
+) -> Result<(), AuthError> {
+    #[derive(sqlx::FromRow)]
+    struct Identity {
+        username: Option<String>,
+        email: Option<String>,
+        email_verified: Option<bool>,
+        vine_id: Option<String>,
+        status: String,
+        suspended_reason: Option<String>,
+        suspended_at: Option<chrono::DateTime<chrono::Utc>>,
+    }
+    let identity: Identity = sqlx::query_as(
+        "SELECT username, email, email_verified, vine_id, status, suspended_reason, suspended_at
+         FROM users WHERE pubkey = $1 AND tenant_id = $2 FOR UPDATE",
+    )
+    .bind(old)
+    .bind(tenant_id)
+    .fetch_one(&mut **tx)
+    .await
+    .map_err(AuthError::Database)?;
+    // Orphan first: username, e-mail and vine_id are unique per tenant.
+    sqlx::query(
+        "UPDATE users SET username = NULL, email = NULL, password_hash = NULL, vine_id = NULL,
+                updated_at = NOW()
+         WHERE pubkey = $1 AND tenant_id = $2",
+    )
+    .bind(old)
+    .bind(tenant_id)
+    .execute(&mut **tx)
+    .await
+    .map_err(AuthError::Database)?;
+    sqlx::query(
+        "INSERT INTO users (pubkey, tenant_id, username, email, email_verified, vine_id, status,
+                            suspended_reason, suspended_at, created_at, updated_at)
+         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, NOW(), NOW())",
+    )
+    .bind(new)
+    .bind(tenant_id)
+    .bind(identity.username)
+    .bind(identity.email)
+    .bind(identity.email_verified)
+    .bind(identity.vine_id)
+    .bind(identity.status)
+    .bind(identity.suspended_reason)
+    .bind(identity.suspended_at)
+    .execute(&mut **tx)
+    .await
+    .map_err(AuthError::Database)?;
+    sqlx::query(
+        "UPDATE oidc_identities SET user_pubkey = $1 WHERE user_pubkey = $2 AND tenant_id = $3",
+    )
+    .bind(new)
+    .bind(old)
+    .bind(tenant_id)
+    .execute(&mut **tx)
+    .await
+    .map_err(AuthError::Database)?;
+    Ok(())
+}
+
+static NOTIFY: Lazy<Option<(String, String, reqwest::Client)>> = Lazy::new(|| {
+    let get = |n: &str| {
+        std::env::var(n)
+            .ok()
+            .map(|v| v.trim().to_string())
+            .filter(|v| !v.is_empty())
+    };
+    let (Some(url), Some(token)) = (get("BELFRY_KEY_CHANGED_URL"), get("BELFRY_HOOK_TOKEN")) else {
+        tracing::warn!(
+            "BELFRY_KEY_CHANGED_URL/BELFRY_HOOK_TOKEN unset: key changes are not reported"
+        );
+        return None;
+    };
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(10))
+        .build()
+        .expect("reqwest client");
+    Some((url, token, client))
+});
+
+/// Tells the onboarding service (pass npub, relay whitelist). Three tries; false on failure
+/// (the onboarding service's reconcile catches up from Keycast's account list later).
+async fn notify_onboarding(vine_id: &str, old: &str, new: &str) -> bool {
+    let Some((url, token, client)) = NOTIFY.as_ref() else {
+        return false;
+    };
+    let body = serde_json::json!({ "vine_id": vine_id, "old_pubkey": old, "new_pubkey": new });
+    for attempt in 0..3 {
+        match client
+            .post(url)
+            .query(&[("token", token)])
+            .json(&body)
+            .send()
+            .await
+        {
+            Ok(r) if r.status().is_success() => return true,
+            Ok(r) => tracing::warn!(status = %r.status(), attempt, "key-changed hook answered"),
+            Err(e) => tracing::warn!(error = %e, attempt, "key-changed hook failed"),
+        }
+        tokio::time::sleep(Duration::from_millis(500 * (attempt + 1))).await;
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use nostr_sdk::{EventBuilder, Keys, Tag, Timestamp};
+
+    #[test]
+    fn challenges_are_bound_to_the_account_and_expire() {
+        let secret = b"server";
+        let c = make_challenge(secret, 2, "aa", 1_000);
+        assert!(challenge_valid(secret, 2, "aa", &c, 1_000));
+        assert!(!challenge_valid(secret, 2, "bb", &c, 1_000));
+        assert!(!challenge_valid(secret, 3, "aa", &c, 1_000));
+        assert!(!challenge_valid(b"other", 2, "aa", &c, 1_000));
+        assert!(!challenge_valid(
+            secret,
+            2,
+            "aa",
+            &c,
+            1_000 + CHALLENGE_TTL_SECS
+        ));
+        assert!(!challenge_valid(secret, 2, "aa", "9999999999.00", 1_000));
+    }
+
+    #[test]
+    fn the_signed_challenge_proves_the_signing_key() {
+        let secret = b"server";
+        let now = Timestamp::now().as_secs();
+        let account = "cc".repeat(32);
+        let keys = Keys::generate();
+        let sign = |kind: Kind, challenge: &str| {
+            EventBuilder::new(kind, "")
+                .tag(Tag::parse(["challenge", challenge]).unwrap())
+                .sign_with_keys(&keys)
+                .unwrap()
+                .as_json()
+        };
+        let good = sign(Kind::HttpAuth, &make_challenge(secret, 2, &account, now));
+        assert_eq!(
+            proven_key(&good, secret, 2, &account, now),
+            Ok(keys.public_key().to_hex())
+        );
+        // a challenge for another account, the wrong kind, a tampered event
+        let other = sign(
+            Kind::HttpAuth,
+            &make_challenge(secret, 2, &"dd".repeat(32), now),
+        );
+        assert!(proven_key(&other, secret, 2, &account, now).is_err());
+        let wrong_kind = sign(Kind::TextNote, &make_challenge(secret, 2, &account, now));
+        assert!(proven_key(&wrong_kind, secret, 2, &account, now).is_err());
+        let tampered = good.replace("\"content\":\"\"", "\"content\":\"x\"");
+        assert!(proven_key(&tampered, secret, 2, &account, now).is_err());
+    }
+}
