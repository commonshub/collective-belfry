+/// Connected authorizations a user keeps per trusted client (one per browser or device).
+const TRUSTED_CLIENT_KEEP_CONNECTED: i64 = 5;
+/// A trusted client's authorization that no NIP-46 client connected to within this time is an
+/// abandoned sign-in.
+const TRUSTED_CLIENT_UNCONNECTED_GRACE_SECS: f64 = 600.0;
+
+/// After an authorization was marked revoked: spend its refresh tokens and drop it from the
+/// signer's cache.
+async fn finish_revocation(auth_state: &super::routes::AuthState, id: i32, bunker_pubkey: String) {
+    let refresh_repo = RefreshTokenRepository::new(auth_state.state.db.clone());
+    if let Err(e) = refresh_repo.revoke_for_authorization(id).await {
+        tracing::warn!(authorization_id = id, "revoking refresh tokens failed: {e}");
+    }
+    METRICS.inc_oauth_revoked();
+    if let Some(tx) = &auth_state.auth_tx {
+        use keycast_core::authorization_channel::AuthorizationCommand;
+        if let Err(e) = tx
+            .send(AuthorizationCommand::Remove { bunker_pubkey })
+            .await
+        {
+            tracing::error!("Failed to send authorization remove command: {}", e);
+        }
+    }
+    tracing::info!(authorization_id = id, "revoked authorization");
+}
+
+#[derive(Debug, Deserialize)]
+pub struct RevokeRequest {
+    /// The refresh token from the token response.
+    pub token: String,
+    pub client_id: Option<String>,
+}
+
+/// POST /api/oauth/revoke (RFC 7009; Belfry): an app ends its own authorization when the
+/// participant logs out, with the refresh token it got from `/api/oauth/token`. Answers 200 for
+/// unknown, expired or foreign tokens as well, as the RFC asks.
+pub async fn revoke(
+    tenant: crate::api::tenant::TenantExtractor,
+    State(auth_state): State<super::routes::AuthState>,
+    request: Request,
+) -> Result<Response, OAuthError> {
+    let tenant_id = tenant.0.id;
+    let content_type = request
+        .headers()
+        .get(CONTENT_TYPE)
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or_default()
+        .to_ascii_lowercase();
+    let req: RevokeRequest = if content_type.starts_with("application/json") {
+        let Json(req) = request
+            .extract::<Json<RevokeRequest>, _>()
+            .await
+            .map_err(|e| OAuthError::InvalidRequest(format!("Invalid JSON revoke request: {e}")))?;
+        req
+    } else {
+        let Form(req) = request
+            .extract::<Form<RevokeRequest>, _>()
+            .await
+            .map_err(|e| OAuthError::InvalidRequest(format!("Invalid revoke request: {e}")))?;
+        req
+    };
+    let pool = &auth_state.state.db;
+    let ok = || Ok(StatusCode::OK.into_response());
+
+    let refresh_repo = RefreshTokenRepository::new(pool.clone());
+    let Some(record) = refresh_repo
+        .find_by_token_hash(&hash_refresh_token(&req.token))
+        .await?
+    else {
+        return ok();
+    };
+    if record.tenant_id != tenant_id || record.expires_at <= Utc::now() {
+        return ok();
+    }
+    let Ok(authorization) = keycast_core::types::oauth_authorization::OAuthAuthorization::find(
+        pool,
+        tenant_id,
+        record.authorization_id,
+    )
+    .await
+    else {
+        return ok();
+    };
+    if req.client_id.is_some() && req.client_id != authorization.client_id {
+        return ok();
+    }
+    if authorization.revoked_at.is_none() {
+        OAuthAuthorizationRepository::new(pool.clone())
+            .revoke(authorization.id)
+            .await?;
+        finish_revocation(
+            &auth_state,
+            authorization.id,
+            authorization.bunker_public_key,
+        )
+        .await;
+    }
+    ok()
+}
