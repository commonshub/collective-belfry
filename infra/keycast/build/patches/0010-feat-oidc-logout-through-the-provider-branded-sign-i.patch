+/// The flow cookie of one sign-in, named after a prefix of its `state` (URL-safe base64). `None`
+/// for a `state` that is not of that alphabet.
+fn flow_cookie_name(state: &str) -> Option<String> {
+    let prefix: String = state.chars().take(12).collect();
+    (prefix.len() == 12
+        && prefix
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'))
+    .then(|| format!("{STATE_COOKIE}_{prefix}"))
+}
+
+fn clear_cookie(name: &str) -> String {
+    format!("{name}=; HttpOnly; Secure; SameSite=Lax; Path=/api/auth/oidc; Max-Age=0")
+}
+
+fn logout_key(server_secret: &[u8]) -> [u8; 32] {
+    let mut h = Sha256::new();
+    h.update(b"keycast-oidc-logout-v1");
+    h.update(server_secret);
+    h.finalize().into()
+}
+
+/// `<expires_at>.<return_to b64>.<tag>`: where to go after the provider's logout.
+pub fn seal_logout_return(return_to: &str, expires_at: u64, server_secret: &[u8]) -> String {
+    let payload = format!("{expires_at}.{}", URL_SAFE_NO_PAD.encode(return_to));
+    let mut mac = HmacSha256::new_from_slice(&logout_key(server_secret)).expect("any key size");
+    mac.update(payload.as_bytes());
+    let tag = URL_SAFE_NO_PAD.encode(mac.finalize().into_bytes());
+    format!("{payload}.{tag}")
+}
+
+pub fn open_logout_return(value: &str, server_secret: &[u8], now: u64) -> Option<String> {
+    let (payload, tag) = value.rsplit_once('.')?;
+    let tag = URL_SAFE_NO_PAD.decode(tag).ok()?;
+    let mut mac = HmacSha256::new_from_slice(&logout_key(server_secret)).ok()?;
+    mac.update(payload.as_bytes());
+    mac.verify_slice(&tag).ok()?;
+    let (expires_at, encoded) = payload.split_once('.')?;
+    if expires_at.parse::<u64>().ok()? <= now {
+        return None;
+    }
+    String::from_utf8(URL_SAFE_NO_PAD.decode(encoded).ok()?).ok()
+}
+
 fn now_unix() -> u64 {
     std::time::SystemTime::now()
         .duration_since(std::time::UNIX_EPOCH)
