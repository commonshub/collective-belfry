+    /// Belfry: revoke a user's stale authorizations for one client: those never connected and
+    /// older than `grace_secs` (an abandoned sign-in), and connected ones beyond the `keep` most
+    /// recently active. Returns the revoked (id, bunker_public_key) pairs.
+    pub async fn prune_for_client(
+        &self,
+        tenant_id: i64,
+        user_pubkey: &str,
+        client_id: &str,
+        keep: i64,
+        grace_secs: f64,
+    ) -> Result<Vec<(i32, String)>, RepositoryError> {
+        sqlx::query_as(
+            "WITH live AS (
+                 SELECT id, connected_at, created_at,
+                        COALESCE(last_activity, connected_at, created_at) AS seen
+                 FROM oauth_authorizations
+                 WHERE tenant_id = $1 AND user_pubkey = $2 AND client_id = $3
+                   AND revoked_at IS NULL
+             ),
+             ranked AS (
+                 SELECT id, row_number() OVER (ORDER BY seen DESC, id DESC) AS rn
+                 FROM live WHERE connected_at IS NOT NULL
+             ),
+             stale AS (
+                 SELECT id FROM live
+                 WHERE connected_at IS NULL AND created_at < NOW() - make_interval(secs => $5)
+                 UNION
+                 SELECT id FROM ranked WHERE rn > $4
+             )
+             UPDATE oauth_authorizations oa
+             SET revoked_at = NOW(), updated_at = NOW()
+             FROM stale WHERE oa.id = stale.id
+             RETURNING oa.id, oa.bunker_public_key",
+        )
+        .bind(tenant_id)
+        .bind(user_pubkey)
+        .bind(client_id)
+        .bind(keep)
+        .bind(grace_secs)
+        .fetch_all(&self.pool)
+        .await
+        .map_err(Into::into)
+    }
