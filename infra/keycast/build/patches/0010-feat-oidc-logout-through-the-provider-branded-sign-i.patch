+
+/// Where a logout may return to: a same-origin path, or a URL on the origin of one of the
+/// tenant's registered clients (Belfry's apps). Anything else falls back to `/`.
+async fn logout_return_to(pool: &sqlx::PgPool, tenant_id: i64, raw: Option<&str>) -> String {
+    let Some(raw) = raw else {
+        return "/".to_string();
+    };
+    if let Some(path) = safe_return_to(Some(raw)) {
+        return path;
+    }
+    if raw.len() > MAX_RETURN_TO_LEN {
+        return "/".to_string();
+    }
+    let Ok(origin) = super::oauth::extract_origin(raw) else {
+        return "/".to_string();
+    };
+    let repo = keycast_core::repositories::RegisteredClientRepository::new(pool.clone());
+    let allowed = repo
+        .list(tenant_id)
+        .await
+        .map(|clients| {
+            clients
+                .iter()
+                .flat_map(|c| c.allowed_redirect_uris.iter())
+                .filter_map(|uri| super::oauth::extract_origin(uri).ok())
+                .any(|o| o == origin)
+        })
+        .unwrap_or(false);
+    if allowed {
+        raw.to_string()
+    } else {
+        tracing::info!(return_to = %raw, "logout return_to is not a registered client origin");
+        "/".to_string()
+    }
+}
+
+/// GET /api/auth/oidc/logout: end the Keycast session and the provider's session, then return.
+pub async fn oidc_logout(
+    tenant: crate::api::tenant::TenantExtractor,
+    State(auth_state): State<AuthState>,
+    Query(params): Query<LogoutParams>,
+) -> Result<Response, OidcError> {
+    let return_to = logout_return_to(
+        &auth_state.state.db,
+        tenant.0.id,
+        params.return_to.as_deref(),
+    )
+    .await;
+    let end_session = match provider() {
+        Some(p) => p
+            .discovery()
+            .await
+            .ok()
+            .and_then(|d| d.end_session_endpoint.clone()),
+        None => None,
+    };
+    let session_clear = "keycast_session=; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=0";
+    tracing::info!(
+        event = "logout",
+        method = "oidc",
+        provider_logout = end_session.is_some()
+    );
+    let mut response = match end_session {
+        Some(url) => {
+            let secret = auth_state.state.server_keys.secret_key().to_secret_bytes();
+            let cookie = format!(
+                "{LOGOUT_COOKIE}={}; HttpOnly; Secure; SameSite=Lax; Path=/api/auth/oidc; Max-Age={LOGOUT_TTL_SECS}",
+                seal_logout_return(&return_to, now_unix() + LOGOUT_TTL_SECS, &secret)
+            );
+            (
+                AppendHeaders([
+                    (header::SET_COOKIE, session_clear.to_string()),
+                    (header::SET_COOKIE, cookie),
+                ]),
+                Redirect::to(&url),
+            )
+                .into_response()
+        }
+        None => (
+            [(header::SET_COOKIE, session_clear.to_string())],
+            Redirect::to(&return_to),
+        )
+            .into_response(),
+    };
+    response
+        .headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    Ok(response)
+}
+
+/// GET /api/auth/oidc/logged-out: the provider's invalidation flow ends here.
+pub async fn oidc_logged_out(State(auth_state): State<AuthState>, headers: HeaderMap) -> Response {
+    let secret = auth_state.state.server_keys.secret_key().to_secret_bytes();
+    let return_to = read_cookie(&headers, LOGOUT_COOKIE)
+        .and_then(|v| open_logout_return(&v, &secret, now_unix()))
+        .unwrap_or_else(|| "/".to_string());
+    let mut response = (
+        [(header::SET_COOKIE, clear_cookie(LOGOUT_COOKIE))],
+        Redirect::to(&return_to),
+    )
+        .into_response();
+    response
+        .headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    response
+}
