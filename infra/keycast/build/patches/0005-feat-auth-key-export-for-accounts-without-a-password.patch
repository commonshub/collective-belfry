 /// Extract UCAN token from Cookie header
+/// Seconds since the Unix epoch.
+pub(crate) fn unix_now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// How long after signing in an account without a password may export its key
+/// (`OIDC_REAUTH_WINDOW_SECS`, default 300). Belfry fork.
+pub(crate) fn oidc_reauth_window_secs() -> u64 {
+    std::env::var("OIDC_REAUTH_WINDOW_SECS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(300)
+}
+
+/// True when a session established at `auth_time` still counts as a fresh login.
+pub(crate) fn reauth_is_fresh(auth_time: Option<u64>, now: u64, window: u64) -> bool {
+    match auth_time {
+        Some(t) => t <= now + 60 && now.saturating_sub(t) <= window,
+        None => false,
+    }
+}
+
+/// The `auth_time` fact of the browser session (server-signed, no `bunker_pubkey`), or None
+/// for user-signed sessions, app tokens and sessions minted before the fact existed.
+pub(crate) async fn session_auth_time(
+    headers: &HeaderMap,
+    tenant_id: i64,
+) -> Result<Option<u64>, AuthError> {
+    let bearer = match headers.get("Authorization") {
+        Some(value) => {
+            let value = value.to_str().map_err(|_| AuthError::InvalidToken)?;
+            value.starts_with("Bearer ").then(|| value.to_string())
+        }
+        None => None,
+    };
+    let auth_header = bearer
+        .or_else(|| extract_ucan_from_cookie(headers).map(|token| format!("Bearer {}", token)))
+        .ok_or(AuthError::MissingToken)?;
+    let (_user_pubkey, _origin, bunker_pubkey, ucan) =
+        crate::ucan_auth::validate_ucan_token(&auth_header, tenant_id)
+            .await
+            .map_err(|_| AuthError::InvalidToken)?;
+    if bunker_pubkey.is_some() {
+        return Ok(None);
+    }
+    Ok(ucan
+        .facts()
+        .iter()
+        .find_map(|fact| fact.get("auth_time").and_then(|value| value.as_u64())))
+}
+
 pub(crate) fn extract_ucan_from_cookie(headers: &HeaderMap) -> Option<String> {
     let cookie_header = headers.get("cookie")?.to_str().ok()?;
 
