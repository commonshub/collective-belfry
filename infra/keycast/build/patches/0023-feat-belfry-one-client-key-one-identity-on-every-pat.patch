diff --git a/core/src/repositories/oauth_authorization.rs b/core/src/repositories/oauth_authorization.rs
index 8e91f02..04fd25a 100644
--- a/core/src/repositories/oauth_authorization.rs
+++ b/core/src/repositories/oauth_authorization.rs
@@ -239,6 +239,41 @@ impl OAuthAuthorizationRepository {
         Ok(id)
     }
 
+    /// Belfry: take the transaction-scoped advisory lock on a NIP-46 client key and say
+    /// whether that key is linked to a user other than the owner of authorization
+    /// `authorization_id`: declared for, or bound by a connect to, any of that other
+    /// user's authorizations in the tenant, revoked and expired ones included.
+    ///
+    /// The signer calls this before it binds a client on a first `connect`, in the
+    /// transaction that writes the binding, so the rule of
+    /// [`Self::create_bound_to_client`] holds on every path: one client key, one identity.
+    pub async fn client_key_of_another_user(
+        tx: &mut sqlx::PgConnection,
+        authorization_id: i32,
+        client_pubkey: &str,
+    ) -> Result<bool, sqlx::Error> {
+        sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1::text, 0))")
+            .bind(client_pubkey)
+            .execute(&mut *tx)
+            .await?;
+        sqlx::query_scalar::<_, bool>(
+            "SELECT EXISTS (
+                 SELECT 1 FROM oauth_authorizations mine
+                 JOIN oauth_authorizations other
+                   ON other.tenant_id = mine.tenant_id
+                  AND other.user_pubkey::text <> mine.user_pubkey::text
+                 WHERE mine.id = $1
+                   AND (lower(other.client_pubkey::text) = $2::text
+                        OR (other.connected_client_pubkey = $2::text
+                            AND other.verified_client_pubkey = $2::text))
+             )",
+        )
+        .bind(authorization_id)
+        .bind(client_pubkey)
+        .fetch_one(&mut *tx)
+        .await
+    }
+
     /// Create an authorization only while its exact redeemed exchange-code claim is live.
     ///
     /// This locks only the exchange row and never the pending registration row. Callers that also
@@ -1214,6 +1249,28 @@ mod tests {
             repo.create_bound_to_client(params(&users[1])).await.unwrap(),
             None
         );
+
+        // The signer's check before a first connect: the key belongs to users[0].
+        let mut unbound = params(&users[1]);
+        unbound.client_pubkey = None;
+        let others = repo.create(unbound).await.unwrap();
+        let mut unbound = params(&users[0]);
+        unbound.client_pubkey = None;
+        let own = repo.create(unbound).await.unwrap();
+        let mut tx = pool.begin().await.unwrap();
+        assert!(
+            OAuthAuthorizationRepository::client_key_of_another_user(&mut *tx, others, &client)
+                .await
+                .unwrap(),
+            "the key cannot connect to another user's authorization"
+        );
+        assert!(
+            !OAuthAuthorizationRepository::client_key_of_another_user(&mut *tx, own, &client)
+                .await
+                .unwrap(),
+            "the key may connect to another authorization of its own user"
+        );
+        tx.rollback().await.unwrap();
     }
 
     #[tokio::test]
