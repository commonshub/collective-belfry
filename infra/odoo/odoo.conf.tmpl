[options]
; Template of the Belfry Odoo 19 config, rendered into odoo.conf (gitignored) by
; scripts/gen-secrets.sh. DB host/user/password come from PGHOST/PGUSER/PGPASSWORD in the
; compose environment (libpq reads them). The only secret here is the master password that
; guards database management (create/drop/backup over /web/database); list_db is off as well.
admin_passwd = @@ODOO_MASTER_PASSWORD@@
addons_path = /mnt/extra-addons
data_dir = /var/lib/odoo
; The main server only serves the "odoo" database; test databases (test_belfry) are
; created by a separate container.
dbfilter = ^odoo$
list_db = False
proxy_mode = True
; Dev settings: single process, one cron thread (payment post-processing and
; automation rules use it), memory limits as in the spike.
workers = 0
max_cron_threads = 1
limit_memory_soft = 1500000000
limit_memory_hard = 2000000000
limit_time_cpu = 120
limit_time_real = 240
log_level = info
; Mute the Odoo 19 deprecation warning for /jsonrpc (used by bootstrap, smoke and the
; onboarding service).
log_handler = :INFO,odoo.addons.rpc.controllers:ERROR
