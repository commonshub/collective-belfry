+//! Private kinds (Belfry).
+//!
+//! Events of the configured kinds are delivered only to a connection that is NIP-42
+//! authenticated as one of the pubkeys in the event's `p` tags, both for stored results and
+//! for live broadcasts. A REQ whose filter can only match these kinds must ask for the
+//! authenticated pubkey's own `#p` (so `limit` and paging stay honest); otherwise it is
+//! answered CLOSED. COUNT and NEG-OPEN, which cannot be filtered per event, are refused when a
+//! filter could match a private kind and is not of that own form. Writing an event of these
+//! kinds is refused when its `created_at` is more than `max_skew` seconds from the relay's
+//! clock.
+//!
+//! Enabled only when the `[private_kinds]` section is present:
+//!
+//! ```toml
+//! [private_kinds]
+//! kinds = [8571, 8572, 8573]
+//! max_skew = 300
+//! ```
+
+use crate::auth::AuthState;
+use metrics::{counter, describe_counter};
+use nostr_relay::db::{now, Filter};
+use nostr_relay::{
+    message::{ClientMessage, IncomingMessage, OutgoingMessage},
+    Extension, ExtensionMessageResult, Result, Session, Setting, SettingUpdate,
+};
+use serde::Deserialize;
+
+#[derive(Deserialize, Debug, Clone, PartialEq, Eq)]
+#[serde(default, deny_unknown_fields)]
+pub struct PrivateKindsSetting {
+    /// Kinds delivered only to the authenticated pubkeys of their `p` tags.
+    pub kinds: Vec<u16>,
+    /// Largest allowed distance, in seconds, between an event's `created_at` and the relay's clock.
+    #[serde(deserialize_with = "nostr_relay::setting::deserialize_scalar")]
+    pub max_skew: u64,
+}
+
+impl Default for PrivateKindsSetting {
+    fn default() -> Self {
+        Self {
+            kinds: vec![8571, 8572, 8573],
+            max_skew: 300,
+        }
+    }
+}
+
+impl PrivateKindsSetting {
+    fn is_private(&self, kind: u16) -> bool {
+        self.kinds.contains(&kind)
+    }
+
+    /// The filter asks only for private kinds.
+    fn only_private(&self, filter: &Filter) -> bool {
+        !filter.kinds.is_empty() && filter.kinds.iter().all(|k| self.is_private(*k))
+    }
+
+    /// The filter could match an event of a private kind.
+    fn may_match_private(&self, filter: &Filter) -> bool {
+        filter.kinds.is_empty() || filter.kinds.iter().any(|k| self.is_private(*k))
+    }
+
+    /// Every result of the filter is addressed to `me`: `#p` is present and holds only `me`.
+    fn own_only(filter: &Filter, me: Option<&str>) -> bool {
+        let Some(me) = me else {
+            return false;
+        };
+        match filter.tags.get(b"p".as_slice()) {
+            Some(list) if !list.is_empty() => list.iter().all(|v| hex_eq(v, me)),
+            _ => false,
+        }
+    }
+
+    /// A REQ is refused when one of its filters asks only for private kinds and is not
+    /// limited to the caller's own `#p`.
+    fn refuse_req(&self, filters: &[Filter], me: Option<&str>) -> bool {
+        filters
+            .iter()
+            .any(|f| self.only_private(f) && !Self::own_only(f, me))
+    }
+
+    /// COUNT and NEG-OPEN can't be filtered per event: refused when a filter could match a
+    /// private kind and is not of the own form (only private kinds, own `#p`).
+    fn refuse_aggregate(&self, filters: &[&Filter], me: Option<&str>) -> bool {
+        filters.iter().any(|f| {
+            self.may_match_private(f) && !(self.only_private(f) && Self::own_only(f, me))
+        })
+    }
+
+    fn skewed(&self, created_at: u64, now: u64) -> bool {
+        created_at.abs_diff(now) > self.max_skew
+    }
+}
+
+fn hex_eq(bytes: &[u8], hex: &str) -> bool {
+    let hex = hex.as_bytes();
+    if hex.len() != bytes.len() * 2 {
+        return false;
+    }
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    bytes.iter().enumerate().all(|(i, b)| {
+        hex[2 * i].to_ascii_lowercase() == DIGITS[(b >> 4) as usize]
+            && hex[2 * i + 1].to_ascii_lowercase() == DIGITS[(b & 15) as usize]
+    })
+}
+
+/// The parts of an outgoing EVENT message this extension needs.
+#[derive(Deserialize)]
+struct WireEvent {
+    kind: u16,
+    #[serde(default)]
+    tags: Vec<Vec<String>>,
+}
+
+#[derive(Deserialize)]
+struct WireMessage(String, serde::de::IgnoredAny, WireEvent);
+
+#[derive(Default, Debug)]
+pub struct PrivateKinds {
+    setting: Option<PrivateKindsSetting>,
+    /// The decimal text of each private kind, to skip parsing messages that can't hold one.
+    needles: Vec<String>,
+}
+
+impl PrivateKinds {
+    pub fn new() -> Self {
+        describe_counter!(
+            "nostr_relay_private_kinds_refused",
+            "Messages refused or withheld by the private kinds rule"
+        );
+        Self::default()
+    }
+
+    fn authed(session: &Session) -> Option<&str> {
+        session
+            .get::<AuthState>()
+            .and_then(AuthState::pubkey)
+            .map(String::as_str)
+    }
+
+    /// Whether an outgoing message may reach a connection authenticated as `me`.
+    fn deliver(&self, setting: &PrivateKindsSetting, text: &str, me: Option<&str>) -> bool {
+        if !self.needles.iter().any(|n| text.contains(n.as_str())) {
+            return true;
+        }
+        match serde_json::from_str::<WireMessage>(text) {
+            Ok(WireMessage(command, _, event)) if command == "EVENT" => {
+                if !setting.is_private(event.kind) {
+                    return true;
+                }
+                let Some(me) = me else {
+                    return false;
+                };
+                event
+                    .tags
+                    .iter()
+                    .any(|t| t.len() > 1 && t[0] == "p" && t[1].eq_ignore_ascii_case(me))
+            }
+            // Not an EVENT with an event object (EOSE, CLOSED, NOTICE, OK...).
+            Ok(_) => true,
+            // An EVENT we can't read is withheld; any other message passes.
+            Err(_) => !OutgoingMessage(text.to_owned()).is_event(),
+        }
+    }
+}
+
+impl Extension for PrivateKinds {
+    fn name(&self) -> &'static str {
+        "private_kinds"
+    }
+
+    fn setting<'a>(&'a mut self, setting: &mut Setting) -> Result<SettingUpdate<'a>> {
+        let parsed: Option<PrivateKindsSetting> = if setting.extra.contains_key(self.name()) {
+            Some(setting.parse_extension(self.name())?)
+        } else {
+            None
+        };
+        Ok(Box::new(move || {
+            self.needles = parsed
+                .iter()
+                .flat_map(|s| s.kinds.iter().map(|k| k.to_string()))
+                .collect();
+            self.setting = parsed;
+        }))
+    }
+
+    fn outgoing(
+        &self,
+        msg: &OutgoingMessage,
+        session: &mut Session,
+        _ctx: &mut <Session as actix::Actor>::Context,
+    ) -> bool {
+        let Some(setting) = &self.setting else {
+            return true;
+        };
+        let ok = self.deliver(setting, &msg.0, Self::authed(session));
+        if !ok {
+            counter!("nostr_relay_private_kinds_refused", "command" => "deliver").increment(1);
+        }
+        ok
+    }
+
+    fn message(
+        &self,
+        msg: ClientMessage,
+        session: &mut Session,
+        _ctx: &mut <Session as actix::Actor>::Context,
+    ) -> ExtensionMessageResult {
+        let Some(setting) = &self.setting else {
+            return ExtensionMessageResult::Continue(msg);
+        };
+        let me = Self::authed(session);
+        match &msg.msg {
+            IncomingMessage::Event(event) if setting.is_private(event.kind()) => {
+                if setting.skewed(event.created_at(), now()) {
+                    counter!("nostr_relay_private_kinds_refused", "command" => "EVENT")
+                        .increment(1);
+                    return OutgoingMessage::ok(
+                        &event.id_str(),
+                        false,
+                        &format!(
+                            "invalid: created_at must be within {} seconds of the relay's clock",
+                            setting.max_skew
+                        ),
+                    )
+                    .into();
+                }
+            }
+            IncomingMessage::Req(sub) if setting.refuse_req(&sub.filters, me) => {
+                counter!("nostr_relay_private_kinds_refused", "command" => "REQ").increment(1);
+                return OutgoingMessage::closed(&sub.id, &refusal(me)).into();
+            }
+            IncomingMessage::Count(sub)
+                if setting.refuse_aggregate(&sub.filters.iter().collect::<Vec<_>>(), me) =>
+            {
+                counter!("nostr_relay_private_kinds_refused", "command" => "COUNT").increment(1);
+                return OutgoingMessage::closed(&sub.id, &refusal(me)).into();
+            }
+            IncomingMessage::NegOpen(open) if setting.refuse_aggregate(&[&open.filter], me) => {
+                counter!("nostr_relay_private_kinds_refused", "command" => "NEG-OPEN")
+                    .increment(1);
+                return msg.reject(refusal(me));
+            }
+            _ => {}
+        }
+        ExtensionMessageResult::Continue(msg)
+    }
+}
+
+fn refusal(me: Option<&str>) -> String {
+    if me.is_some() {
+        "restricted: these kinds are served only with your own #p".to_owned()
+    } else {
+        "auth-required: these kinds are served only to their recipients".to_owned()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{create_test_app, Auth};
+    use actix_web::web;
+    use actix_web_actors::ws;
+    use anyhow::Result;
+    use futures_util::{Sink, SinkExt as _, Stream, StreamExt as _};
