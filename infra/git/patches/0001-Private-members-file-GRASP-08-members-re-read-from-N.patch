 #[cfg(test)]
 mod tests {
     use super::*;
@@ -96,4 +129,31 @@ mod tests {
         assert!(!access.replace([second]));
         assert_eq!(*generation.borrow(), 1);
     }
+
+    #[test]
+    fn members_file_reads_npubs_and_hex_and_fails_on_garbage() {
+        use nostr_sdk::prelude::ToBech32;
+        let dir = std::env::temp_dir().join(format!("ngit-members-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("members");
+        assert!(read_members_file(&path).unwrap().is_empty());
+
+        let a = Keys::generate().public_key();
+        let b = Keys::generate().public_key();
+        std::fs::write(
+            &path,
+            format!(
+                "# members\n{}\n{} ,\n\n",
+                a.to_bech32().unwrap(),
+                b.to_hex()
+            ),
+        )
+        .unwrap();
+        let members = read_members_file(&path).unwrap();
+        assert_eq!(members, [a, b].into_iter().collect());
+
+        std::fs::write(&path, format!("{}\nnot-a-key\n", a.to_hex())).unwrap();
+        assert!(read_members_file(&path).is_err());
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
 }
