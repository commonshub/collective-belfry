+/// Read a members file: one npub or 64-hex pubkey per line (commas and
+/// whitespace also separate entries), `#` starts a comment. A missing file is
+/// an empty set; any malformed entry fails the whole read, so a caller can keep
+/// its previous set instead of silently dropping members.
+pub fn read_members_file(path: &std::path::Path) -> anyhow::Result<HashSet<PublicKey>> {
+    use anyhow::Context;
+    use nostr_sdk::prelude::FromBech32;
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(HashSet::new()),
+        Err(err) => {
+            return Err(err).with_context(|| format!("reading {}", path.display()));
+        }
+    };
+    let mut members = HashSet::new();
+    for line in text.lines() {
+        let line = line.split('#').next().unwrap_or_default();
+        for entry in line.split(|c: char| c == ',' || c.is_whitespace()) {
+            if entry.is_empty() {
+                continue;
+            }
+            let key = if entry.starts_with("npub1") {
+                PublicKey::from_bech32(entry)
+            } else {
+                PublicKey::from_hex(entry)
+            }
+            .with_context(|| format!("invalid member '{entry}' in {}", path.display()))?;
+            members.insert(key);
+        }
+    }
+    Ok(members)
+}
