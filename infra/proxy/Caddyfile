# Belfry reverse proxy for a public deployment (docker-compose.prod.yml). One hostname per
# service under BELFRY_DOMAIN, automatic TLS (Let's Encrypt, ACME_EMAIL). Everything that is
# management or internal only is denied here; the services keep talking to each other over
# the Compose network. CADDY_TLS_ARG is the argument of the tls directive: the ACME e-mail in
# production (docker-compose.prod.yml defaults it to ACME_EMAIL), "internal" for a local check
# with Caddy's own CA.
#
# Hardening (2026-10-24):
# - Admin pages (Odoo's back office, Authentik's admin and password login, the steward pages,
#   Keycast's admin pages) answer only connections from ADMIN_NETS: the ZeroTier network's subnet
#   plus the VM itself (Docker's address ranges, for bootstrap and the smoke test). Admins map the
#   public hostnames to the VM's ZeroTier address in their hosts file (infra/DEPLOY.md). The
#   check uses the connection's address (remote_ip), never X-Forwarded-For.
# - Per-IP rate limits (module caddy-ratelimit, image infra/proxy/Dockerfile) on the pages anyone
#   can hit without an account. They are generous on purpose: at the event most participants
#   share the venue's address, which RATE_LIMIT_EXEMPT (the venue WiFi's public addresses, CIDR,
#   space-separated) takes out of every limit. Pages that poll every 1.5 s (the door's session,
#   pass sign-in) count about 40 requests a minute per open page. Mail flooding is limited per
#   account in Authentik (belfry-magic-link-flow.yaml), not here.
# - Errors the proxy answers itself (admin pages from outside ADMIN_NETS, closed paths, rate
#   limits, a service that is down) are a branded page for browsers (errors/error.html, rendered
#   by Caddy's templates) and the plain message for other clients. Errors a service answers
#   itself pass through.
# - A Content-Security-Policy per browser app (scripts and connections only to Belfry's own
#   hosts). Odoo and Authentik bring their own inline code and get none.
{
	email {$ACME_EMAIL}
	order rate_limit before basic_auth
	servers {
		trusted_proxies static private_ranges
	}
}

(security) {
	tls {$CADDY_TLS_ARG}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	encode zstd gzip
	import errors
}

# Browsers (Accept: text/html) get errors/error.html with the status code; API clients, wallets
# and relays get the message as plain text, as before.
(errors) {
	handle_errors {
		@page header Accept *text/html*
		handle @page {
			root * /etc/caddy/errors
			rewrite * /error.html
			header Cache-Control no-store
			templates
			file_server {
				status {err.status_code}
			}
		}
		handle {
			respond "{err.message}" {err.status_code}
		}
	}
}

# import admin_only <path> [<path> ...]: those paths only from ADMIN_NETS (once per site).
(admin_only) {
	@outside_admin_net {
		path {args[:]}
		not remote_ip {$ADMIN_NETS:127.0.0.1/8 172.16.0.0/12}
	}
	error @outside_admin_net "This page is for stewards and admins and opens only over Belfry's admin network. Connect to it and reload the page." 403
}

# import limit <zone> <events> <window> <path> [<path> ...]: per client address; 429 beyond.
# Addresses in RATE_LIMIT_EXEMPT are never limited (default: a documentation address, i.e. none).
(limit) {
	rate_limit {
		zone {args[0]} {
			match {
				path {args[3:]}
				not remote_ip {$RATE_LIMIT_EXEMPT:192.0.2.1/32}
			}
			key {client_ip}
			events {args[1]}
			window {args[2]}
		}
	}
}

# import csp "<policy>": the app's Content-Security-Policy, plus what every app shares.
(csp) {
	header Content-Security-Policy "{args[0]}; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
}

# import onboarding_site <zone prefix>: the onboarding service as one site, on pass.<domain> and
# (for the start page) on the apex; the same rules on both hosts.
(onboarding_site) {
	@internal path /admin/* /hooks/odoo/* /hooks/keycast/* /issuer-shim/* /docs /openapi.json /redoc
	error @internal 404
	import admin_only /steward /steward/*
	import limit {args[0]}-claim 120 1m /claim/* /tokens/* /wallet/*
	import limit {args[0]}-me 120 1m /me/login /me/callback /me/invites /me/invites/*
	import limit {args[0]}-check 600 1m /check/*
	import limit {args[0]}-bridge 1200 1m /bridge/*
	import limit {args[0]}-door 600 1m /door /door/*
	import limit {args[0]}-feedback 30 1m /feedback
	# the pages carry their own small inline scripts and the QR codes as data: images
	import csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://login.{$BELFRY_DOMAIN}"
	reverse_proxy onboarding:8100
}

# Registry and billing: invite pages, Odoo payment links, back office. Host shop.<domain>
# (ODOO_HOST_PREFIX).
{$ODOO_HOST_PREFIX:shop}.{$BELFRY_DOMAIN} {
	import security
	# The back office, its login and the database manager only over the admin network;
	# participants keep the invite, payment and portal pages (access-token links).
	import admin_only /odoo /odoo/* /web /web/ /web/login /web/login/* /web/reset_password* /web/signup* /web/database/* /web/session/* /web/become /xmlrpc/* /jsonrpc /json/*
	import limit odoo-invite 120 1m /belfry/invite/*
	reverse_proxy odoo:8069
}

# Login (Authentik). Keycast's OIDC issuer is https://login.<domain>/application/o/keycast/.
login.{$BELFRY_DOMAIN} {
	import security
	# Authentik's admin interface and akadmin's password login only over the admin network.
	import admin_only /if/admin /if/admin/* /if/flow/default-authentication-flow /if/flow/default-authentication-flow/* /api/v3/flows/executor/default-authentication-flow /api/v3/flows/executor/default-authentication-flow/* /api/v3/admin/*
	# Flow steps (e-mail entry, magic links, pass sign-in): bursts from the venue are fine.
	import limit login-flows 300 1m /api/v3/flows/executor/*
	reverse_proxy authentik-server:9000
}

# Community apps / signer (Keycast web app and API, NIP-05 for its usernames).
apps.{$BELFRY_DOMAIN} {
	import security
	# Admin API only for the onboarding service (Compose network); the dev mail inbox
	# (ENABLE_DEV_EMAIL_INBOX, read by bootstrap to confirm the admin) must never be public.
	@admin path /api/admin/* /api/dev/*
	error @admin 404
	import admin_only /admin /admin/*
	import csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data:; connect-src 'self' https://login.{$BELFRY_DOMAIN} wss://bunker.{$BELFRY_DOMAIN}; form-action 'self' https://login.{$BELFRY_DOMAIN}"
	reverse_proxy keycast:3000
}

# NIP-05 on Belfry's own domain: <member>@<domain> resolves through Keycast's nostr.json.
{$BELFRY_DOMAIN} {
	import security
	@nip05 path /.well-known/nostr.json
	handle @nip05 {
		# Keycast already answers with Access-Control-Allow-Origin: *.
		# Keycast takes its tenant from the Host header and only knows KEYCAST_TENANT_DOMAIN.
		reverse_proxy keycast:3000 {
			header_up Host {$KEYCAST_TENANT_DOMAIN}
		}
	}
	# Everything else: the start page (the onboarding service's landing page, SITE_URL) and the
	# onboarding site it links to.
	handle {
		import onboarding_site site
	}
}

# Community relay (NIP-42 whitelist); wss://relay.<domain>
relay.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy relay:8080
}

# Blossom file server through its gate (writes need an active pass; reads are public).
blossom.{$BELFRY_DOMAIN} {
	import security
	request_body {
		max_size 25MB
	}
	# Files uploaded by participants: never run as a page on this origin.
	header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
	reverse_proxy blossom-gate:80
}

# Community chat (Coracle, NIP-17): a static build; the browser talks to relay., bunker. and
# blossom. directly (infra/apps/chat/README.md).
chat.{$BELFRY_DOMAIN} {
	import security
	# Coracle's own <meta> policy applies as well (both must allow). Participants may add other
	# relays and look up NIP-05 names elsewhere, so connections stay open to any https/wss host.
	import csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://pass.{$BELFRY_DOMAIN}; font-src 'self' data: https://pass.{$BELFRY_DOMAIN}; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src https://open.spotify.com https://embed.tidal.com; manifest-src 'self'; form-action 'self'"
	reverse_proxy chat:80
}

# Village token mint (Cashu, no monetary value): wallets swap, read keys and check states; only
# the onboarding service mints (internal network), and nothing is ever melted (paid out).
mint.{$BELFRY_DOMAIN} {
	import security
	@closed path /v1/mint/* /v1/melt/*
	error @closed "Minting and melting are closed: tokens come with the pass." 403
	reverse_proxy mint:8085
}

# Village token wallet (cashu.me, static); it talks to mint., apps. (Keycast) and relay. itself.
wallet.{$BELFRY_DOMAIN} {
	import security
	# one inline script (brand.mjs: the dark background before the app loads)
	import csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://pass.{$BELFRY_DOMAIN}; font-src 'self' data: https://pass.{$BELFRY_DOMAIN}; img-src 'self' https: data: blob:; connect-src 'self' https://mint.{$BELFRY_DOMAIN} https://apps.{$BELFRY_DOMAIN} https://pass.{$BELFRY_DOMAIN} wss://relay.{$BELFRY_DOMAIN}; worker-src 'self'; manifest-src 'self'; form-action 'self'"
	reverse_proxy wallet:80
}

# Keycast's NIP-46 relay for remote signing; wss://bunker.<domain>
bunker.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy keycast-relay:8080
}

# Credential issuer: wallet-facing OpenID4VCI only; the management API stays internal.
issuer.{$BELFRY_DOMAIN} {
	import security
	@management path /issuer2/*
	error @management 404
	import limit issuer 300 1m /openid4vci/* /.well-known/*
	# Issuer2 serves its metadata only at the RFC 8615 place (/.well-known/<name>/openid4vci);
	# walt.id's web wallet and other draft-13 wallets append it to the issuer URL instead.
	rewrite /openid4vci/.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/openid4vci
	rewrite /openid4vci/.well-known/openid-configuration /.well-known/oauth-authorization-server/openid4vci
	# The credential issuer metadata comes through the onboarding service, which adds
	# authorization_servers (Issuer2 omits it; walt.id's wallet then finds no token endpoint).
	@issuermeta path /.well-known/openid-credential-issuer/openid4vci /openid4vci/.well-known/openid-credential-issuer
	handle @issuermeta {
		rewrite * /issuer-metadata
		reverse_proxy onboarding:8100
	}
	# Issuer2 1.2.0 speaks OpenID4VCI 1.0 only; draft-13 wallets (walt.id's web wallet) need
	# c_nonce in the token response and send {format, vct, proof}. The onboarding service
	# translates (clients/issuer.py) and passes 1.0 requests through unchanged.
	handle /openid4vci/token {
		rewrite * /issuer-shim/token
		reverse_proxy onboarding:8100
	}
	handle /openid4vci/credential {
		rewrite * /issuer-shim/credential
		reverse_proxy onboarding:8100
	}
	# Authorization-code flows (the claim page's sign-in offer, DIDroom) only with issuer_state:
	# without it Issuer2 would issue the profile's placeholder data. The onboarding service
	# checks and passes the request on.
	handle /openid4vci/par {
		rewrite * /issuer-shim/par
		reverse_proxy onboarding:8100
	}
	handle /openid4vci/authorize {
		rewrite * /issuer-shim/authorize?{query}
		reverse_proxy onboarding:8100
	}
	reverse_proxy issuer:7005
}

# Verifier: wallets fetch request objects and post presentations; session management is
# internal (door page and bridge create and read sessions over the Compose network).
verifier.{$BELFRY_DOMAIN} {
	import security
	@wallet path_regexp ^/verification-session/[^/]+/(request|response)$
	handle @wallet {
		reverse_proxy verifier:7004
	}
	handle {
		error 404
	}
}

