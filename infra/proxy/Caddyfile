# Belfry reverse proxy for a public deployment (docker-compose.prod.yml). One hostname per
# service under BELFRY_DOMAIN, automatic TLS (Let's Encrypt, ACME_EMAIL). Everything that is
# management or internal only is denied here; the services keep talking to each other over
# the Compose network. CADDY_TLS_ARG is the argument of the tls directive: the ACME e-mail in
# production (docker-compose.prod.yml defaults it to ACME_EMAIL), "internal" for a local check
# with Caddy's own CA.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(security) {
	tls {$CADDY_TLS_ARG}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
}

# Registry and billing: invite pages, Odoo payment links, back office. Host shop.<domain>
# (ODOO_HOST_PREFIX; the first test deployment, belfry.tofauti.net, keeps odoo.).
{$ODOO_HOST_PREFIX:shop}.{$BELFRY_DOMAIN} {
	import security
	# Database management is guarded by the master password; keep it off the internet anyway.
	@dbmanager path /web/database/*
	respond @dbmanager 404
	reverse_proxy odoo:8069
}

# Login (Authentik). Keycast's OIDC issuer is https://login.<domain>/application/o/keycast/.
login.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy authentik-server:9000
}

# Community apps / signer (Keycast web app and API, NIP-05 for its usernames).
apps.{$BELFRY_DOMAIN} {
	import security
	# Admin API only for the onboarding service (Compose network); the dev mail inbox
	# (ENABLE_DEV_EMAIL_INBOX, read by bootstrap to confirm the admin) must never be public.
	@admin path /api/admin/* /api/dev/*
	respond @admin 404
	reverse_proxy keycast:3000
}

# NIP-05 on Belfry's own domain: <member>@<domain> resolves through Keycast's nostr.json.
{$BELFRY_DOMAIN} {
	import security
	@nip05 path /.well-known/nostr.json
	handle @nip05 {
		# Keycast already answers with Access-Control-Allow-Origin: *.
		# Keycast takes its tenant from the Host header and only knows KEYCAST_TENANT_DOMAIN.
		reverse_proxy keycast:3000 {
			header_up Host {$KEYCAST_TENANT_DOMAIN}
		}
	}
	# Everything else on the apex: the invite/registry front door.
	handle {
		redir https://{$ODOO_HOST_PREFIX:shop}.{$BELFRY_DOMAIN}{uri}
	}
}

# Community relay (NIP-42 whitelist); wss://relay.<domain>
relay.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy relay:8080
}

# Blossom file server through its gate (writes need an active pass; reads are public).
blossom.{$BELFRY_DOMAIN} {
	import security
	request_body {
		max_size 25MB
	}
	reverse_proxy blossom-gate:80
}

# Community chat (Coracle, NIP-17): a static build; the browser talks to relay., bunker. and
# blossom. directly (infra/apps/chat/README.md).
chat.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy chat:80
}

# Keycast's NIP-46 relay for remote signing; wss://bunker.<domain>
bunker.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy keycast-relay:8080
}

# Credential issuer: wallet-facing OpenID4VCI only; the management API stays internal.
issuer.{$BELFRY_DOMAIN} {
	import security
	@management path /issuer2/*
	respond @management 404
	# Issuer2 serves its metadata only at the RFC 8615 place (/.well-known/<name>/openid4vci);
	# walt.id's web wallet and other draft-13 wallets append it to the issuer URL instead.
	rewrite /openid4vci/.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/openid4vci
	rewrite /openid4vci/.well-known/openid-configuration /.well-known/oauth-authorization-server/openid4vci
	# The credential issuer metadata comes through the onboarding service, which adds
	# authorization_servers (Issuer2 omits it; walt.id's wallet then finds no token endpoint).
	@issuermeta path /.well-known/openid-credential-issuer/openid4vci /openid4vci/.well-known/openid-credential-issuer
	handle @issuermeta {
		rewrite * /issuer-metadata
		reverse_proxy onboarding:8100
	}
	# Issuer2 1.2.0 speaks OpenID4VCI 1.0 only; draft-13 wallets (walt.id's web wallet) need
	# c_nonce in the token response and send {format, vct, proof}. The onboarding service
	# translates (clients/issuer.py) and passes 1.0 requests through unchanged.
	handle /openid4vci/token {
		rewrite * /issuer-shim/token
		reverse_proxy onboarding:8100
	}
	handle /openid4vci/credential {
		rewrite * /issuer-shim/credential
		reverse_proxy onboarding:8100
	}
	# Authorization-code flows (the claim page's sign-in offer, DIDroom) only with issuer_state:
	# without it Issuer2 would issue the profile's placeholder data. The onboarding service
	# checks and passes the request on.
	handle /openid4vci/par {
		rewrite * /issuer-shim/par
		reverse_proxy onboarding:8100
	}
	handle /openid4vci/authorize {
		rewrite * /issuer-shim/authorize?{query}
		reverse_proxy onboarding:8100
	}
	reverse_proxy issuer:7005
}

# Verifier: wallets fetch request objects and post presentations; session management is
# internal (door page and bridge create and read sessions over the Compose network).
verifier.{$BELFRY_DOMAIN} {
	import security
	@wallet path_regexp ^/verification-session/[^/]+/(request|response)$
	handle @wallet {
		reverse_proxy verifier:7004
	}
	handle {
		respond 404
	}
}

# Community app: the Open Source Village calendar (infra/apps/calendar, a static build).
calendar.{$BELFRY_DOMAIN} {
	import security
	reverse_proxy calendar:80
}

# Participant-facing pages of the onboarding service: claim page, door, pass bridge, status
# list, type metadata, Stripe webhook. Odoo's hooks and the admin endpoints are internal.
pass.{$BELFRY_DOMAIN} {
	import security
	@internal path /admin/* /hooks/odoo/* /issuer-shim/* /docs /openapi.json /redoc
	respond @internal 404
	reverse_proxy onboarding:8100
}
