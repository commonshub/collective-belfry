+// Belfry: the Open Source Village wallet. Built with BELFRY_MINT_URL, the app is a wallet for the
+// village tokens (Belfry's mint, unit "osv", no monetary value): it skips cashu.me's onboarding
+// (seed phrase and mint choice; the seed can still be backed up from the settings), adds the
+// village mint, makes it active and shows the unit as "tokens".
+
+import { useWelcomeStore } from "src/stores/welcome";
+import { useMintsStore } from "src/stores/mints";
+
+export const VILLAGE_MINT_URL = (process.env.BELFRY_MINT_URL || "").replace(
+  /\/+$/,
+  ""
+);
+export const VILLAGE_UNIT = "osv";
+
+export const villageEnabled = () => Boolean(VILLAGE_MINT_URL);
+
+/** Marks the onboarding as done; call before the wallet page decides whether to show it. */
+export function skipOnboarding() {
+  if (!villageEnabled()) return;
+  const welcome = useWelcomeStore();
+  if (welcome.termsAccepted && !welcome.showWelcome) return;
+  welcome.termsAccepted = true;
+  welcome.onboardingPath = "new";
+  welcome.seedPhraseValidated = true;
+  welcome.mintSetupCompleted = true;
+  welcome.showWelcome = false;
+}
+
+/** Adds the village mint once and makes it (with the token unit) the active one. */
+export async function ensureVillageMint() {
+  if (!villageEnabled()) return;
+  const mints = useMintsStore();
+  try {
+    if (!mints.mints.some((m) => m.url === VILLAGE_MINT_URL)) {
+      await mints.addMint({
+        url: VILLAGE_MINT_URL,
+        nickname: "Open Source Village",
+      });
+    }
+    if (!mints.activeMintUrl || mints.activeMintUrl === VILLAGE_MINT_URL) {
+      await mints.activateMintUrl(VILLAGE_MINT_URL, false, true, VILLAGE_UNIT);
+    }
+  } catch (e) {
+    console.warn("Could not add the Open Source Village mint", e);
+  }
+}
+
+/** "1 token", "50 tokens". */
+export function formatTokens(value: number | bigint, locale?: string) {
+  const n = new Intl.NumberFormat(locale).format(value as number);
+  return `${n} ${value === 1 || value === 1n ? "token" : "tokens"}`;
+}
