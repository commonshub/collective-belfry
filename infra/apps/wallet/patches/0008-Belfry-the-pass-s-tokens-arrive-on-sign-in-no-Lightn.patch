       const wallet = await useWalletStore().mintWallet(
@@ -176,6 +184,34 @@ export async function connectVillageAccount() {
   }
 }
 
+/** The tokens a pass brings (50 per pass day), minted at activation and kept on the pass until a
+ *  wallet redeems them: asked for with a NIP-98 signature of the participant's key, so they land
+ *  in this wallet without the separate "Get your tokens" link. Nothing comes back once redeemed. */
+export async function claimPassTokens() {
+  if (!PASS_URL) return;
+  const url = `${PASS_URL}/wallet/pass-tokens`;
+  const auth = await signEvent({
+    kind: 27235,
+    created_at: Math.floor(Date.now() / 1000),
+    tags: [
+      ["u", url],
+      ["method", "GET"],
+    ],
+    content: "",
+  });
+  const response = await fetch(url, {
+    headers: { Authorization: `Nostr ${btoa(JSON.stringify(auth))}` },
+  });
+  if (!response.ok) throw new Error(`pass tokens: HTTP ${response.status}`);
+  const { tokens } = (await response.json()) as {
+    tokens: { token: string; amount: number }[];
+  };
+  for (const { token, amount } of tokens || []) {
+    await receiveQuietly(token);
+    notifySuccess(`Your pass brought ${formatTokens(amount)}`);
+  }
+}
+
 /** Sends `amount` tokens to a participant (hex pubkey) as a nutzap. */
