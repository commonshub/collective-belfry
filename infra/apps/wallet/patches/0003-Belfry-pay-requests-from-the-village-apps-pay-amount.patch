+/** Pages of the same deployment (wallet.<domain> -> *.<domain>) may ask to come back. */
+function allowedReturn(raw: string | null): string {
+  if (!raw) return "";
+  try {
+    const url = new URL(raw);
+    const here = window.location.hostname;
+    const labels = here.split(".");
+    const parent = labels.length > 2 ? labels.slice(1).join(".") : "";
+    const sameSite =
+      url.hostname === here || (parent && url.hostname.endsWith(`.${parent}`));
+    return /^https?:$/.test(url.protocol) && sameSite ? url.toString() : "";
+  } catch {
+    return "";
+  }
+}
+
+/**
+ * A payment request from another village app: /?pay=<npub>&amount=<n>&memo=…&ref=…&return=…
+ * opens the send dialog filled in (Belfry wallet patch 0003, the marketplace's "Pay").
+ */
+function takePayIntent() {
+  const params = new URLSearchParams(window.location.search);
+  if (!params.has("pay")) return null;
+  const intent = {
+    recipient: params.get("pay") || "",
+    amount: Math.max(1, Math.floor(Number(params.get("amount")) || 0)),
+    memo: (params.get("memo") || "").slice(0, 200),
+    ref: params.get("ref") || "",
+    returnUrl: allowedReturn(params.get("return")),
+  };
+  for (const k of ["pay", "amount", "memo", "ref", "return"]) params.delete(k);
+  const rest = params.toString();
+  window.history.replaceState(
+    null,
+    "",
+    window.location.pathname + (rest ? `?${rest}` : "") + window.location.hash
+  );
+  return intent;
+}
+
