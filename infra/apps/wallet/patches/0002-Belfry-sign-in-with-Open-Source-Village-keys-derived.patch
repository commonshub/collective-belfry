diff --git a/src/belfry/keys.ts b/src/belfry/keys.ts
new file mode 100644
index 0000000..e13b16e
--- /dev/null
+++ b/src/belfry/keys.ts
@@ -0,0 +1,51 @@
+// Belfry: the wallet's keys derive from the participant's Nostr key (Keycast derive_secret,
+// HKDF-SHA256 per purpose; decision 2026-10-24):
+//
+// - "cashu-wallet-v1": the first 16 bytes are the entropy of the wallet's 12-word seed (NUT-13
+//   deterministic secrets), so signing in on another device restores the tokens from the mint.
+// - "cashu-nutzap-v1": the P2PK key nutzaps are locked to (NIP-61 forbids the main key),
+//   normalised to an even Y so that senders' "02" + x-only key is exactly this key.
+//
+// A participant who takes custody of their Nostr key can reproduce both with any HKDF
+// implementation (salt "keycast/derive/v1", info = the purpose).
+
+import { entropyToMnemonic } from "@scure/bip39";
+import { wordlist } from "@scure/bip39/wordlists/english";
+import { getPublicKey } from "nostr-tools";
+import { bytesToHex, hexToBytes } from "@noble/hashes/utils";
+import { secp256k1 } from "@noble/curves/secp256k1";
+import { rpc } from "./sso";
+
+const CURVE_ORDER = BigInt(
+  "0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141"
+);
+
+async function derive(purpose: string): Promise<Uint8Array> {
+  const hex = (await rpc("derive_secret", [purpose])) as string;
+  if (!/^[0-9a-f]{64}$/.test(hex)) throw new Error("derive_secret: bad answer");
+  return hexToBytes(hex);
+}
+
+export async function deriveWalletMnemonic(): Promise<string> {
+  return entropyToMnemonic(
+    (await derive("cashu-wallet-v1")).slice(0, 16),
+    wordlist
+  );
+}
+
+/** The nutzap key as {privateKey, publicKey: "02" + x-only}, with an even Y. */
+export async function deriveNutzapKey(): Promise<{
+  privateKey: string;
+  publicKey: string;
+}> {
+  const secret = await derive("cashu-nutzap-v1");
+  let d = BigInt("0x" + bytesToHex(secret)) % CURVE_ORDER;
+  if (d === 0n) throw new Error("derived key out of range");
+  // BIP340 x-only keys stand for the even-Y point; negate d when its point is odd.
+  const compressed = bytesToHex(
+    secp256k1.getPublicKey(d.toString(16).padStart(64, "0"), true)
+  );
+  if (compressed.startsWith("03")) d = CURVE_ORDER - d;
+  const privateKey = d.toString(16).padStart(64, "0");
+  return { privateKey, publicKey: "02" + getPublicKey(hexToBytes(privateKey)) };
+}
diff --git a/src/belfry/nutzap.ts b/src/belfry/nutzap.ts
new file mode 100644
index 0000000..5b55dce
--- /dev/null
+++ b/src/belfry/nutzap.ts
@@ -0,0 +1,200 @@
+// Belfry: nutzaps (NIP-61) between participants, over the community relay.
+//
+// - kind 10019 announces where the participant receives: the community relay, the village mint
+//   with its unit, and the nutzap key (derived from the Nostr key, see keys.ts).
+// - kind 9321 carries tokens P2PK-locked to the recipient's 10019 key; the wallet redeems the
+//   ones addressed to the participant and remembers which it has seen.
+// The community relay only talks to whitelisted pubkeys after NIP-42 AUTH, which Keycast signs.
+
+import { Relay } from "nostr-tools";
+import type { Event, EventTemplate, VerifiedEvent } from "nostr-tools";
+import { getEncodedToken } from "@cashu/cashu-ts";
+import { rpc, getSession } from "./sso";
+import { VILLAGE_MINT_URL, VILLAGE_UNIT } from "./village";
+
+export const COMMUNITY_RELAY =
+  (process.env.BELFRY_COMMUNITY_RELAY as string) || "";
+const SEEN_KEY = "belfry.nutzaps.seen";
+
+async function sign(template: EventTemplate): Promise<VerifiedEvent> {
+  const session = getSession();
+  if (!session) throw new Error("not signed in");
+  return (await rpc("sign_event", [
+    { ...template, pubkey: session.pubkey },
+  ])) as VerifiedEvent;
+}
+
+let relayPromise: Promise<Relay> | null = null;
+
+/** The community relay, connected and authenticated (NIP-42). */
+export function communityRelay(): Promise<Relay> {
+  if (!relayPromise) {
+    relayPromise = (async () => {
+      const relay = await Relay.connect(COMMUNITY_RELAY);
+      relay.onclose = () => {
+        relayPromise = null;
+      };
+      for (let i = 0; i < 50 && !relay.challenge; i++) {
+        await new Promise((r) => setTimeout(r, 100));
+      }
+      if (relay.challenge) await relay.auth(sign);
+      return relay;
+    })().catch((e) => {
+      relayPromise = null;
+      throw e;
+    });
+  }
+  return relayPromise;
+}
+
+async function fetchOne(
+  relay: Relay,
+  filter: Record<string, unknown>
+): Promise<Event | null> {
+  return new Promise((resolve) => {
+    let found: Event | null = null;
+    const sub = relay.subscribe([filter as any], {
+      onevent(e) {
+        if (!found || e.created_at > found.created_at) found = e;
+      },
+      oneose() {
+        sub.close();
+        resolve(found);
+      },
+    });
+    setTimeout(() => {
+      sub.close();
+      resolve(found);
+    }, 5000);
+  });
+}
+
+/** Publishes the participant's 10019 unless an identical one is there. */
+export async function announceNutzapInfo(nutzapPubkey: string) {
+  const session = getSession();
+  if (!session || !COMMUNITY_RELAY) return;
+  const relay = await communityRelay();
+  const xonly = nutzapPubkey.slice(2);
+  const tags = [
+    ["relay", COMMUNITY_RELAY],
+    ["mint", VILLAGE_MINT_URL, VILLAGE_UNIT],
+    ["pubkey", xonly],
+  ];
+  const current = await fetchOne(relay, {
+    kinds: [10019],
+    authors: [session.pubkey],
+    limit: 1,
+  });
+  if (current && JSON.stringify(current.tags) === JSON.stringify(tags)) return;
+  await relay.publish(
+    await sign({ kind: 10019, created_at: now(), tags, content: "" })
+  );
+}
+
+/** The recipient's nutzap key ("02" + x-only) for the village mint, or null. */
+export async function recipientNutzapKey(
+  pubkey: string
+): Promise<string | null> {
+  const relay = await communityRelay();
+  const info = await fetchOne(relay, {
+    kinds: [10019],
+    authors: [pubkey],
+    limit: 1,
+  });
+  if (!info) return null;
+  const acceptsVillage = info.tags.some(
+    (t) => t[0] === "mint" && t[1] === VILLAGE_MINT_URL
+  );
+  const key = info.tags.find((t) => t[0] === "pubkey")?.[1];
+  if (!acceptsVillage || !key || !/^[0-9a-f]{64}$/.test(key)) return null;
+  return "02" + key;
+}
+
+/** Publishes a nutzap carrying `proofs` (already locked to the recipient). */
+export async function publishNutzap(
+  recipient: string,
+  proofs: {
+    amount: number;
+    C: string;
+    id: string;
+    secret: string;
+    dleq?: unknown;
+  }[],
+  comment: string
+) {
+  const relay = await communityRelay();
+  const tags = [
+    ...proofs.map((p) => ["proof", JSON.stringify(p)]),
+    ["unit", VILLAGE_UNIT],
+    ["u", VILLAGE_MINT_URL],
+    ["p", recipient],
+  ];
+  await relay.publish(
+    await sign({ kind: 9321, created_at: now(), tags, content: comment })
+  );
+}
+
+function seen(): Set<string> {
+  try {
+    return new Set(JSON.parse(window.localStorage.getItem(SEEN_KEY) || "[]"));
+  } catch {
+    return new Set();
+  }
+}
+
+function markSeen(ids: Set<string>) {
+  try {
+    window.localStorage.setItem(SEEN_KEY, JSON.stringify([...ids].slice(-500)));
+  } catch {
+    // not remembered: redeeming a spent nutzap again only fails at the mint
+  }
+}
+
+/** Calls `redeem` with a token for every nutzap to the participant not seen before. */
+export async function listenForNutzaps(
+  redeem: (
+    token: string,
+    from: string,
+    amount: number,
+    comment: string,
+    proofs: { secret: string; id: string }[]
+  ) => Promise<void>
+) {
+  const session = getSession();
+  if (!session || !COMMUNITY_RELAY) return;
+  const relay = await communityRelay();
+  const known = seen();
+  relay.subscribe([{ kinds: [9321], "#p": [session.pubkey] } as any], {
+    async onevent(e: Event) {
+      if (known.has(e.id)) return;
+      known.add(e.id);
+      markSeen(known);
+      const mint = e.tags.find((t) => t[0] === "u")?.[1];
+      if (mint !== VILLAGE_MINT_URL) return;
+      const unit = e.tags.find((t) => t[0] === "unit")?.[1] || "sat";
+      const proofs = e.tags
+        .filter((t) => t[0] === "proof")
+        .map((t) => {
+          try {
+            return JSON.parse(t[1]);
+          } catch {
+            return null;
+          }
+        })
+        .filter(Boolean);
+      if (!proofs.length) return;
+      const amount = proofs.reduce(
+        (s: number, p: any) => s + Number(p.amount),
+        0
+      );
+      const token = getEncodedToken({ mint, unit, proofs });
+      try {
+        await redeem(token, e.pubkey, amount, e.content, proofs);
+      } catch (err) {
+        console.warn("Could not redeem nutzap", e.id, err);
+      }
+    },
+  });
+}
+
+const now = () => Math.floor(Date.now() / 1000);
diff --git a/src/belfry/sso.ts b/src/belfry/sso.ts
new file mode 100644
index 0000000..86561b9
--- /dev/null
+++ b/src/belfry/sso.ts
@@ -0,0 +1,240 @@
+// Belfry: "Sign in with Open Source Village" for the wallet.
+//
+// OAuth 2.0 authorization code + PKCE against Keycast (client belfry-wallet, a trusted app: no
+// consent screen). The wallet keeps the token response's access and refresh tokens and talks to
+// Keycast over HTTP RPC: get_public_key, sign_event (kind 10019, 9321, NIP-42 AUTH) and
+// derive_secret (Keycast patch 0011) for the wallet seed and the nutzap key. On load the wallet
+// tries a silent sign-in once per tab (prompt=none), like the chat and the calendar.
+
+const KEYCAST_URL = ((process.env.BELFRY_KEYCAST_URL as string) || "").replace(
+  /\/+$/,
+  ""
+);
+const CLIENT_ID = "belfry-wallet";
+const SCOPE = "policy:belfry-event";
+const CALLBACK_PATH = "/oauth/callback";
+const FLOW_KEY = "belfry-sso-flow";
+const TRIED_KEY = "belfry-sso-silent-tried";
+const SESSION_KEY = "belfry.session";
+/** Fired on window when a sign-in finished (components mounted before it update). */
+export const SESSION_EVENT = "belfry:session";
+
+type Flow = {
+  state: string;
+  verifier: string;
+  silent: boolean;
+  returnTo: string;
+};
+
+export type Session = {
+  pubkey: string;
+  accessToken: string;
+  refreshToken: string;
+};
+
+export const ssoEnabled = () => Boolean(KEYCAST_URL);
+export const isSsoCallback = () => window.location.pathname === CALLBACK_PATH;
+const redirectUri = () => window.location.origin + CALLBACK_PATH;
+
+const tab = {
+  get: (k: string) => {
+    try {
+      return window.sessionStorage.getItem(k);
+    } catch {
+      return null;
+    }
+  },
+  set: (k: string, v: string) => {
+    try {
+      window.sessionStorage.setItem(k, v);
+      return true;
+    } catch {
+      return false;
+    }
+  },
+  remove: (k: string) => {
+    try {
+      window.sessionStorage.removeItem(k);
+    } catch {
+      // nothing to remove
+    }
+  },
+};
+
+export function getSession(): Session | null {
+  try {
+    const raw = window.localStorage.getItem(SESSION_KEY);
+    return raw ? (JSON.parse(raw) as Session) : null;
+  } catch {
+    return null;
+  }
+}
+
+function setSession(s: Session | null) {
+  try {
+    if (s) window.localStorage.setItem(SESSION_KEY, JSON.stringify(s));
+    else window.localStorage.removeItem(SESSION_KEY);
+  } catch {
+    // storage unavailable: the session lasts as long as the page
+  }
+}
+
+const b64url = (bytes: Uint8Array) =>
+  btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+const randomString = (n = 32) =>
+  b64url(crypto.getRandomValues(new Uint8Array(n)));
+const challengeFor = async (verifier: string) =>
+  b64url(
+    new Uint8Array(
+      await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))
+    )
+  );
+
+/** Redirects to Keycast. Interactive by default; `silent` adds prompt=none. */
+export async function startSignIn(silent = false) {
+  const flow: Flow = {
+    state: randomString(),
+    verifier: randomString(48),
+    silent,
+    returnTo: isSsoCallback()
+      ? "/"
+      : window.location.pathname +
+        window.location.search +
+        window.location.hash,
+  };
+  if (!tab.set(FLOW_KEY, JSON.stringify(flow))) return false;
+  const url = new URL(KEYCAST_URL + "/api/oauth/authorize");
+  url.searchParams.set("client_id", CLIENT_ID);
+  url.searchParams.set("redirect_uri", redirectUri());
+  url.searchParams.set("scope", SCOPE);
+  url.searchParams.set("state", flow.state);
+  url.searchParams.set("code_challenge", await challengeFor(flow.verifier));
+  url.searchParams.set("code_challenge_method", "S256");
+  if (silent) url.searchParams.set("prompt", "none");
+  window.location.assign(url.toString());
+  return true;
+}
+
+/** One silent attempt per tab, only without a session. True when the page is redirecting. */
+export async function trySilentSignIn() {
+  if (!ssoEnabled() || getSession() || tab.get(TRIED_KEY)) return false;
+  // A token link waits for the user: never redirect away from it.
+  if (window.location.hash.includes("token=")) return false;
+  if (!tab.set(TRIED_KEY, "1")) return false;
+  return startSignIn(true);
+}
+
+/** Handles /oauth/callback. Returns the new session, or null (error or silent miss). */
+export async function finishSignIn(): Promise<Session | null> {
+  const params = new URLSearchParams(window.location.search);
+  const raw = tab.get(FLOW_KEY);
+  tab.remove(FLOW_KEY);
+  let flow: Flow | undefined;
+  try {
+    flow = raw ? (JSON.parse(raw) as Flow) : undefined;
+  } catch {
+    flow = undefined;
+  }
+  window.history.replaceState(null, "", flow?.returnTo || "/");
+  if (!flow || params.get("state") !== flow.state || params.get("error"))
+    return null;
+  const code = params.get("code");
+  if (!code) return null;
+  const tokens = await tokenRequest({
+    grant_type: "authorization_code",
+    code,
+    client_id: CLIENT_ID,
+    redirect_uri: redirectUri(),
+    code_verifier: flow.verifier,
+  });
+  if (!tokens) return null;
+  const session: Session = { pubkey: "", ...tokens };
+  setSession(session);
+  session.pubkey = (await rpc("get_public_key", [])) as string;
+  setSession(session);
+  window.dispatchEvent(new Event(SESSION_EVENT));
+  return session;
+}
+
+async function tokenRequest(
+  body: Record<string, string>
+): Promise<{ accessToken: string; refreshToken: string } | null> {
+  const r = await fetch(KEYCAST_URL + "/api/oauth/token", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  const json = await r.json().catch(() => ({}));
+  if (!r.ok || !json.access_token) return null;
+  return {
+    accessToken: json.access_token,
+    refreshToken: json.refresh_token || "",
+  };
+}
+
+async function refresh(session: Session): Promise<boolean> {
+  if (!session.refreshToken) return false;
+  const tokens = await tokenRequest({
+    grant_type: "refresh_token",
+    refresh_token: session.refreshToken,
+    client_id: CLIENT_ID,
+  });
+  if (!tokens) return false;
+  setSession({ ...session, ...tokens });
+  return true;
+}
+
+/** Keycast HTTP RPC with the session's access token; refreshes it once on 401. */
+export async function rpc(method: string, params: unknown[]): Promise<unknown> {
+  for (let attempt = 0; attempt < 2; attempt++) {
+    const session = getSession();
+    if (!session) throw new Error("not signed in");
+    const r = await fetch(KEYCAST_URL + "/api/nostr", {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        Authorization: `Bearer ${session.accessToken}`,
+      },
+      body: JSON.stringify({ method, params }),
+    });
+    if (r.status === 401 && attempt === 0 && (await refresh(session))) continue;
+    const json = await r.json().catch(() => ({}));
+    if (!r.ok || json.error) {
+      throw new Error(json.error || `Keycast ${method}: HTTP ${r.status}`);
+    }
+    return json.result;
+  }
+  throw new Error("Keycast session expired");
+}
+
+/** Revokes the wallet's authorization and returns the URL that ends the single sign-on. */
+export async function prepareLogout(returnTo: string) {
+  const session = getSession();
+  setSession(null);
+  tab.set(TRIED_KEY, "1");
+  if (!ssoEnabled()) return returnTo;
+  if (session?.refreshToken) {
+    try {
+      await fetch(KEYCAST_URL + "/api/oauth/revoke", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          token: session.refreshToken,
+          client_id: CLIENT_ID,
+        }),
+        signal: AbortSignal.timeout(3000),
+      });
+    } catch (e) {
+      console.warn("Revoking the wallet's authorization failed", e);
+    }
+  }
+  const url = new URL(KEYCAST_URL + "/api/auth/oidc/logout");
+  url.searchParams.set(
+    "return_to",
+    new URL(returnTo, window.location.origin).toString()
+  );
+  return url.toString();
+}
diff --git a/src/belfry/village.ts b/src/belfry/village.ts
index c2ec920..9579ff7 100644
--- a/src/belfry/village.ts
+++ b/src/belfry/village.ts
@@ -5,6 +5,23 @@
 
 import { useWelcomeStore } from "src/stores/welcome";
 import { useMintsStore } from "src/stores/mints";
+import { Amount, getEncodedToken } from "@cashu/cashu-ts";
+import type { Proof } from "@cashu/cashu-ts";
+import { useWalletStore } from "src/stores/wallet";
+import { useProofsStore } from "src/stores/proofs";
+import { useP2PKStore } from "src/stores/p2pk";
+import { useRestoreStore } from "src/stores/restore";
+import { useReceiveTokensStore } from "src/stores/receiveTokensStore";
+import { useTokensStore } from "src/stores/tokens";
+import { notifySuccess } from "src/js/notify";
+import { getSession } from "./sso";
+import { deriveWalletMnemonic, deriveNutzapKey } from "./keys";
+import {
+  announceNutzapInfo,
+  listenForNutzaps,
+  publishNutzap,
+  recipientNutzapKey,
+} from "./nutzap";
 
 export const VILLAGE_MINT_URL = (process.env.BELFRY_MINT_URL || "").replace(
   /\/+$/,
@@ -50,3 +67,156 @@ export function formatTokens(value: number | bigint, locale?: string) {
   const n = new Intl.NumberFormat(locale).format(value as number);
   return `${n} ${value === 1 || value === 1n ? "token" : "tokens"}`;
 }
+
+// -- the participant's account (after "Sign in with Open Source Village") -----------------------
+
+function villageMint() {
+  return useMintsStore().mints.find((m) => m.url === VILLAGE_MINT_URL);
+}
+
+function heldProofs() {
+  const mint = villageMint();
+  return mint ? useMintsStore().mintUnitProofs(mint, VILLAGE_UNIT) : [];
+}
+
+const asProofs = (proofs: { amount: number; [k: string]: any }[]): Proof[] =>
+  proofs.map(({ reserved, quote, amount, ...rest }) => ({
+    ...(rest as any),
+    amount: Amount.from(amount),
+  }));
+
+/** Moves the wallet onto the seed derived from the Nostr key. Tokens it holds are swapped onto
+ *  the new seed (so they can be restored elsewhere); a fresh wallet restores from the mint. */
+async function adoptDerivedSeed() {
+  const walletStore = useWalletStore();
+  const mnemonic = await deriveWalletMnemonic();
+  if (walletStore.mnemonic === mnemonic) return;
+  const held = heldProofs().filter((p) => !p.reserved);
+  walletStore.oldMnemonicCounters.push({
+    mnemonic: walletStore.mnemonic,
+    keysetCounters: walletStore.keysetCounters,
+  });
+  walletStore.keysetCounters = [];
+  walletStore.sharedCounterSource = null;
+  walletStore.mnemonic = mnemonic;
+
+  if (held.length) {
+    const proofsStore = useProofsStore();
+    const token = getEncodedToken({
+      mint: VILLAGE_MINT_URL,
+      unit: VILLAGE_UNIT,
+      proofs: asProofs(held),
+    });
+    await proofsStore.removeProofs(held);
+    try {
+      const wallet = await walletStore.mintWallet(
+        VILLAGE_MINT_URL,
+        VILLAGE_UNIT,
+        true
+      );
+      const fresh = await wallet.ops.receive(token).asDeterministic().run();
+      await proofsStore.addProofs(fresh);
+    } catch (e) {
+      // the swap did not happen: the old proofs are still good
+      await proofsStore.addProofs(held);
+      console.warn("Could not move the tokens onto the derived seed", e);
+    }
+  } else {
+    const restore = useRestoreStore();
+    restore.mnemonicToRestore = mnemonic;
+    // quiet: a first sign-in finds nothing, which is not news
+    await restore.restoreMint(VILLAGE_MINT_URL, true);
+  }
+}
+
+/** Receives a token without the dialog (nutzaps); P2PK keys come from the key store. */
+async function receiveQuietly(token: string) {
+  const receive = useReceiveTokensStore();
+  receive.receiveData.tokensBase64 = token;
+  receive.receiveData.p2pkPrivateKey = "";
+  await receive.receiveToken(token);
+}
+
+let connected = false;
+
+/** After signing in (and on every load while signed in): derived seed, nutzap key, 10019,
+ *  incoming nutzaps. */
+export async function connectVillageAccount() {
+  if (connected || !villageEnabled() || !getSession()) return;
+  connected = true;
+  try {
+    await ensureVillageMint();
+    await adoptDerivedSeed();
+    const key = await deriveNutzapKey();
+    const p2pk = useP2PKStore();
+    if (!p2pk.haveThisKey(key.publicKey)) {
+      p2pk.p2pkKeys = p2pk.p2pkKeys.concat({
+        ...key,
+        used: false,
+        usedCount: 0,
+      });
+    }
+    await announceNutzapInfo(key.publicKey);
+    await listenForNutzaps(async (token, _from, amount, _comment, proofs) => {
+      // On a new device old nutzaps come in again: skip the ones already redeemed.
+      const wallet = await useWalletStore().mintWallet(
+        VILLAGE_MINT_URL,
+        VILLAGE_UNIT,
+        true
+      );
+      const states = await wallet.checkProofsStates(proofs);
+      if (states.some((s: any) => s.state !== "UNSPENT")) return;
+      await receiveQuietly(token);
+      notifySuccess(`Received ${formatTokens(amount)}`);
+    });
+  } catch (e) {
+    connected = false;
+    console.warn("Open Source Village account setup failed", e);
+    throw e;
+  }
+}
+
+/** Sends `amount` tokens to a participant (hex pubkey) as a nutzap. */
+export async function sendToParticipant(
+  pubkey: string,
+  amount: number,
+  comment: string
+) {
+  const key = await recipientNutzapKey(pubkey);
+  if (!key) {
+    throw new Error(
+      "This participant has not opened the wallet yet. Send them a token link instead."
+    );
+  }
+  const walletStore = useWalletStore();
+  const wallet = await walletStore.mintWallet(
+    VILLAGE_MINT_URL,
+    VILLAGE_UNIT,
+    true
+  );
+  const { sendProofs } = await walletStore.sendToLock(
+    heldProofs(),
+    wallet,
+    amount,
+    key
+  );
+  const proofs = sendProofs.map((p: any) => ({
+    amount: Amount.from(p.amount).toNumber(),
+    C: p.C,
+    id: p.id,
+    secret: p.secret,
+    ...(p.dleq ? { dleq: p.dleq } : {}),
+  }));
+  await publishNutzap(pubkey, proofs, comment);
+  useTokensStore().addPaidToken({
+    amount: -amount,
+    token: getEncodedToken({
+      mint: VILLAGE_MINT_URL,
+      unit: VILLAGE_UNIT,
+      proofs: asProofs(proofs as any),
+    }),
+    mint: VILLAGE_MINT_URL,
+    unit: VILLAGE_UNIT,
+    label: comment || "Sent to a participant",
+  } as any);
+}
