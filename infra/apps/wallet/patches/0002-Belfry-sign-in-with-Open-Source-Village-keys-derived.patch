+<template>
+  <!-- Belfry: the participant's Open Source Village account in the wallet -->
+  <div v-if="enabled" class="village-card q-pa-md q-mx-md text-left">
+    <template v-if="!signedIn">
+      <div class="text-body2 q-mb-sm">
+        Sign in to keep your tokens on every device and to receive tokens from
+        other participants.
+      </div>
+      <q-btn
+        rounded
+        unelevated
+        color="primary"
+        class="full-width"
+        data-testid="village-sign-in"
+        label="Sign in with Open Source Village"
+        @click="signIn"
+      />
+    </template>
+    <template v-else>
+      <div class="row items-center no-wrap">
+        <div class="col text-body2">
+          Signed in<span v-if="ready"> · others can send you tokens</span>
+          <span v-else-if="error" class="text-warning"> · {{ error }}</span>
+          <span v-else> · setting up…</span>
+        </div>
+        <q-btn flat dense no-caps size="sm" label="Sign out" @click="signOut" />
+      </div>
+      <q-btn
+        rounded
+        unelevated
+        color="primary"
+        class="full-width q-mt-sm"
+        data-testid="village-send"
+        label="Send to a participant"
+        :disable="!ready"
+        @click="showSend = true"
+      />
+    </template>
+
+    <q-dialog v-model="showSend">
+      <q-card class="q-pa-md" style="min-width: 300px; max-width: 420px">
+        <div class="text-h6 q-mb-md">Send tokens to a participant</div>
+        <q-input
+          v-model="recipient"
+          outlined
+          dense
+          label="Their npub or name (name@domain)"
+          data-testid="village-recipient"
+          class="q-mb-sm"
+        />
+        <q-input
+          v-model.number="amount"
+          outlined
+          dense
+          type="number"
+          min="1"
+          label="Tokens"
+          data-testid="village-amount"
+          class="q-mb-sm"
+        />
+        <q-input
+          v-model="comment"
+          outlined
+          dense
+          label="Note (optional)"
+          class="q-mb-md"
+        />
+        <div v-if="sendError" class="text-warning q-mb-sm">{{ sendError }}</div>
+        <q-btn
+          rounded
+          unelevated
+          color="primary"
+          class="full-width"
+          data-testid="village-send-confirm"
+          :loading="sending"
+          label="Send"
+          @click="send"
+        />
+      </q-card>
+    </q-dialog>
+  </div>
+</template>
+
+<script lang="ts">
+import { defineComponent } from "vue";
+import { nip05, nip19 } from "nostr-tools";
+import { notifySuccess } from "src/js/notify";
+import {
+  ssoEnabled,
+  getSession,
+  startSignIn,
+  prepareLogout,
+  SESSION_EVENT,
+} from "src/belfry/sso";
+import {
+  villageEnabled,
+  connectVillageAccount,
+  sendToParticipant,
+  formatTokens,
+} from "src/belfry/village";
+
+async function resolvePubkey(input: string): Promise<string> {
+  const value = input.trim();
+  if (/^[0-9a-f]{64}$/.test(value)) return value;
+  if (value.startsWith("npub1")) return nip19.decode(value).data as string;
+  if (value.includes("@")) {
+    const profile = await nip05.queryProfile(value);
+    if (profile?.pubkey) return profile.pubkey;
+  }
+  throw new Error("Enter an npub or a name like name@domain.");
+}
+
+export default defineComponent({
+  name: "VillageCard",
+  data() {
+    return {
+      signedIn: Boolean(getSession()),
+      ready: false,
+      error: "",
+      showSend: false,
+      recipient: "",
+      amount: 10 as number,
+      comment: "",
+      sending: false,
+      sendError: "",
+    };
+  },
+  computed: {
+    enabled(): boolean {
+      return villageEnabled() && ssoEnabled();
+    },
+  },
+  async mounted() {
+    window.addEventListener(SESSION_EVENT, this.onSession);
+    if (this.signedIn) await this.connect();
+  },
+  beforeUnmount() {
+    window.removeEventListener(SESSION_EVENT, this.onSession);
+  },
+  methods: {
+    async onSession() {
+      this.signedIn = Boolean(getSession());
+      if (this.signedIn) await this.connect();
+    },
+    async connect() {
+      try {
+        await connectVillageAccount();
+        this.ready = true;
+        this.error = "";
+      } catch (e: any) {
+        this.error = "could not reach the village services";
+      }
+    },
+    signIn() {
+      startSignIn(false);
+    },
+    async signOut() {
+      window.location.href = await prepareLogout("/");
+    },
+    async send() {
+      this.sendError = "";
+      this.sending = true;
+      try {
+        if (!this.amount || this.amount < 1)
+          throw new Error("Enter a number of tokens.");
+        const pubkey = await resolvePubkey(this.recipient);
+        await sendToParticipant(pubkey, Math.floor(this.amount), this.comment);
+        notifySuccess(`Sent ${formatTokens(Math.floor(this.amount))}`);
+        this.showSend = false;
+        this.recipient = "";
+        this.comment = "";
+      } catch (e: any) {
+        this.sendError = e?.message || String(e);
+      } finally {
+        this.sending = false;
+      }
+    },
+  },
+});
+</script>
+
+<style scoped>
+.village-card {
+  border: 1px solid rgba(255, 255, 255, 0.16);
+  border-radius: 12px;
+}
+</style>
