new file mode 100644
index 0000000..4dd8d96
--- /dev/null
+++ b/src/belfry/people.ts
@@ -0,0 +1,126 @@
+// Belfry: the participants to send tokens to, from the Directory (services/village): those who
+// chose to be listed (kind 30078, d = "osv-directory", content {"listed": true}; the newest per
+// author counts), with their kind-0 profile and whether their wallet can receive (a kind 10019).
+// Read from the community relay the wallet is connected to anyway (nutzap.ts).
+
+import type { Event } from "nostr-tools";
+import { nip19 } from "nostr-tools";
+import { getSession } from "./sso";
+import { communityRelay } from "./nutzap";
+
+export type Participant = {
+  pubkey: string;
+  name: string;
+  picture: string;
+  nip05: string;
+  canReceive: boolean;
+};
+
+const DIRECTORY_D = "osv-directory";
+
+async function fetchAll(filter: Record<string, unknown>): Promise<Event[]> {
+  const relay = await communityRelay();
+  return new Promise((resolve) => {
+    const events: Event[] = [];
+    const done = () => {
+      sub.close();
+      resolve(events);
+    };
+    const sub = relay.subscribe([filter as any], {
+      onevent: (e) => events.push(e),
+      oneose: done,
+    });
+    setTimeout(done, 6000);
+  });
+}
+
+function newestByAuthor(events: Event[]): Map<string, Event> {
+  const out = new Map<string, Event>();
+  for (const e of events) {
+    const prev = out.get(e.pubkey);
+    if (!prev || e.created_at > prev.created_at) out.set(e.pubkey, e);
+  }
+  return out;
+}
+
+function parseProfile(event?: Event) {
+  try {
+    const c = JSON.parse(event?.content || "{}") || {};
+    const str = (v: unknown) => (typeof v === "string" ? v.trim() : "");
+    const picture = str(c.picture);
+    return {
+      name: str(c.display_name) || str(c.displayName) || str(c.name),
+      picture: /^https:\/\//.test(picture) ? picture : "",
+      nip05: str(c.nip05),
+    };
+  } catch {
+    return { name: "", picture: "", nip05: "" };
+  }
+}
+
+export function shortNpub(pubkey: string): string {
+  const npub = nip19.npubEncode(pubkey);
+  return `${npub.slice(0, 10)}…${npub.slice(-4)}`;
+}
+
+const names = new Map<string, string>();
+
+/** A participant's display name (their profile), or a shortened npub. */
+export async function participantName(pubkey: string): Promise<string> {
+  if (names.has(pubkey)) return names.get(pubkey) as string;
+  let name = "";
+  try {
+    const [profile] = [
+      ...newestByAuthor(
+        await fetchAll({ kinds: [0], authors: [pubkey] })
+      ).values(),
+    ];
+    const p = parseProfile(profile);
+    name = p.name || p.nip05.split("@")[0];
+  } catch {
+    // the relay is not reachable: the npub will do
+  }
+  name = name || shortNpub(pubkey);
+  names.set(pubkey, name);
+  return name;
+}
+
+/** The listed participants (not the signed-in one), by name. */
+export async function listedParticipants(): Promise<Participant[]> {
+  const me = getSession()?.pubkey;
+  const consents = newestByAuthor(
+    await fetchAll({ kinds: [30078], "#d": [DIRECTORY_D] })
+  );
+  const listed = [...consents.values()]
+    .filter((e) => {
+      try {
+        return JSON.parse(e.content || "{}").listed === true;
+      } catch {
+        return false;
+      }
+    })
+    .map((e) => e.pubkey)
+    .filter((pk) => pk !== me);
+  if (!listed.length) return [];
+  const [profiles, wallets] = await Promise.all([
+    fetchAll({ kinds: [0], authors: listed }),
+    fetchAll({ kinds: [10019], authors: listed }),
+  ]);
+  const byAuthor = newestByAuthor(profiles);
+  const receiving = new Set(wallets.map((e) => e.pubkey));
+  const people = listed.map((pubkey) => {
+    const p = parseProfile(byAuthor.get(pubkey));
+    const name = p.name || p.nip05.split("@")[0] || shortNpub(pubkey);
+    names.set(pubkey, name);
+    return {
+      pubkey,
+      name,
+      picture: p.picture,
+      nip05: p.nip05,
+      canReceive: receiving.has(pubkey),
+    };
+  });
+  return people.sort((a, b) =>
+    a.name.localeCompare(b.name, undefined, { sensitivity: "base" })
+  );
+}
