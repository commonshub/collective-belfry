+type Nip07 = {
+  getPublicKey(): Promise<string>;
+  signEvent(event: EventTemplate & { pubkey?: string }): Promise<VerifiedEvent>;
+  nip44?: {
+    encrypt(pubkey: string, plaintext: string): Promise<string>;
+    decrypt(pubkey: string, ciphertext: string): Promise<string>;
+  };
 };
+const nip07 = () => (window as unknown as { nostr?: Nip07 }).nostr;
 
 export const ssoEnabled = () => Boolean(KEYCAST_URL);
 export const isSsoCallback = () => window.location.pathname === CALLBACK_PATH;
@@ -139,6 +158,9 @@ export async function finishSignIn(): Promise<Session | null> {
     flow = undefined;
   }
   window.history.replaceState(null, "", flow?.returnTo || "/");
+  // Keycast answers this when the participant holds their own key (Keycast patch 0012)
+  if (params.get("error_description") === "self_custody")
+    tab.set(SELF_CUSTODY_KEY, "1");
   if (!flow || params.get("state") !== flow.state || params.get("error"))
     return null;
   const code = params.get("code");
@@ -187,6 +209,65 @@ async function refresh(session: Session): Promise<boolean> {
   return true;
 }
 
+/** A NIP-07 signer extension is in this browser. */
+export const hasOwnSigner = () => typeof nip07()?.signEvent === "function";
+/** Signed in with the participant's own signer. */
+export const usesOwnSigner = () => getSession()?.signer === "nip07";
+/** Keycast told us (on a sign-in attempt) that the participant holds their own key. */
+export const toldSelfCustody = () => tab.get(SELF_CUSTODY_KEY) === "1";
+
+/** Signs in with the browser's signer extension: the session is just its public key. */
+export async function signInWithOwnSigner(): Promise<Session> {
+  const signer = nip07();
+  if (!signer) throw new Error("No Nostr signer extension in this browser.");
+  if (!signer.nip44)
+    throw new Error("Your signer cannot encrypt (NIP-44), which the wallet needs.");
+  const pubkey = await signer.getPublicKey();
+  if (!/^[0-9a-f]{64}$/.test(pubkey))
+    throw new Error("Your signer did not share a public key.");
+  const session: Session = {
+    pubkey,
+    accessToken: "",
+    refreshToken: "",
+    signer: "nip07",
+  };
+  setSession(session);
+  window.dispatchEvent(new Event(SESSION_EVENT));
+  return session;
+}
+
+/** Signs an event as the participant: with their own signer, or through Keycast. */
+export async function signEvent(template: EventTemplate): Promise<VerifiedEvent> {
+  const session = getSession();
+  if (!session) throw new Error("not signed in");
+  if (session.signer === "nip07") {
+    const signer = nip07();
+    if (!signer) throw new Error("Your signer extension is not available.");
+    const signed = await signer.signEvent({ ...template, pubkey: session.pubkey });
+    if (signed.pubkey !== session.pubkey)
+      throw new Error("Your signer signed with another key.");
+    return signed;
+  }
+  return (await rpc("sign_event", [
+    { ...template, pubkey: session.pubkey },
+  ])) as VerifiedEvent;
+}
+
+/** NIP-44 to the participant's own key, with their own signer (the wallet backup, keys.ts). */
+export async function encryptToSelf(plaintext: string): Promise<string> {
+  const session = getSession();
+  const signer = nip07();
+  if (!session || !signer?.nip44) throw new Error("Your signer cannot encrypt (NIP-44).");
+  return signer.nip44.encrypt(session.pubkey, plaintext);
+}
+
+export async function decryptFromSelf(ciphertext: string): Promise<string> {
+  const session = getSession();
+  const signer = nip07();
+  if (!session || !signer?.nip44) throw new Error("Your signer cannot decrypt (NIP-44).");
+  return signer.nip44.decrypt(session.pubkey, ciphertext);
+}
+
