 const TRIED_KEY = "belfry-sso-silent-tried";
 const SESSION_KEY = "belfry.session";
+const SELF_CUSTODY_KEY = "belfry-sso-self-custody";
 /** Fired on window when a sign-in finished (components mounted before it update). */
 export const SESSION_EVENT = "belfry:session";
 
@@ -30,7 +37,19 @@ export type Session = {
   pubkey: string;
   accessToken: string;
   refreshToken: string;
+  /** "nip07": the participant's own signer (browser extension); absent: Keycast. */
+  signer?: "nip07";
