diff --git a/src/belfry/keys.ts b/src/belfry/keys.ts
index e13b16e..02d50ec 100644
--- a/src/belfry/keys.ts
+++ b/src/belfry/keys.ts
@@ -8,13 +8,22 @@
 //
 // A participant who takes custody of their Nostr key can reproduce both with any HKDF
 // implementation (salt "keycast/derive/v1", info = the purpose).
+//
+// With their own signer nothing derives them: the wallet makes a random seed and nutzap key once
+// and keeps them on the community relay as a kind-30078 event ("d" = osv-wallet), its content
+// NIP-44-encrypted to the participant's own key, so another device signed in with the same
+// signer finds them again.
 
-import { entropyToMnemonic } from "@scure/bip39";
+import { entropyToMnemonic, validateMnemonic } from "@scure/bip39";
 import { wordlist } from "@scure/bip39/wordlists/english";
 import { getPublicKey } from "nostr-tools";
 import { bytesToHex, hexToBytes } from "@noble/hashes/utils";
 import { secp256k1 } from "@noble/curves/secp256k1";
-import { rpc } from "./sso";
+import { rpc, getSession, usesOwnSigner, signEvent, encryptToSelf, decryptFromSelf } from "./sso";
+import { communityRelay, fetchOne } from "./nutzap";
+
+const BACKUP_KIND = 30078;
+const BACKUP_D = "osv-wallet";
 
 const CURVE_ORDER = BigInt(
   "0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141"
@@ -33,12 +42,14 @@ export async function deriveWalletMnemonic(): Promise<string> {
   );
 }
 
+export type NutzapKey = { privateKey: string; publicKey: string };
+
 /** The nutzap key as {privateKey, publicKey: "02" + x-only}, with an even Y. */
-export async function deriveNutzapKey(): Promise<{
-  privateKey: string;
-  publicKey: string;
-}> {
-  const secret = await derive("cashu-nutzap-v1");
+export async function deriveNutzapKey(): Promise<NutzapKey> {
+  return nutzapKeyFrom(await derive("cashu-nutzap-v1"));
+}
+
+function nutzapKeyFrom(secret: Uint8Array): NutzapKey {
   let d = BigInt("0x" + bytesToHex(secret)) % CURVE_ORDER;
   if (d === 0n) throw new Error("derived key out of range");
   // BIP340 x-only keys stand for the even-Y point; negate d when its point is odd.
@@ -49,3 +60,45 @@ export async function deriveNutzapKey(): Promise<{
   const privateKey = d.toString(16).padStart(64, "0");
   return { privateKey, publicKey: "02" + getPublicKey(hexToBytes(privateKey)) };
 }
+
+/** The wallet's seed and nutzap key: derived through Keycast, or the own signer's backup. */
+export async function walletSecrets(): Promise<{
+  mnemonic: string;
+  nutzapKey: NutzapKey;
+}> {
+  if (!usesOwnSigner()) {
+    return {
+      mnemonic: await deriveWalletMnemonic(),
+      nutzapKey: await deriveNutzapKey(),
+    };
+  }
+  const session = getSession();
+  if (!session) throw new Error("not signed in");
+  const relay = await communityRelay();
+  const found = await fetchOne(relay, {
+    kinds: [BACKUP_KIND],
+    authors: [session.pubkey],
+    "#d": [BACKUP_D],
+  });
+  if (found) {
+    // A backup that cannot be read is never replaced: that would lose the tokens on its seed.
+    const data = JSON.parse(await decryptFromSelf(found.content));
+    if (!validateMnemonic(data.mnemonic, wordlist) || !/^[0-9a-f]{64}$/.test(data.nutzap))
+      throw new Error("The wallet backup on the relay is damaged.");
+    return { mnemonic: data.mnemonic, nutzapKey: nutzapKeyFrom(hexToBytes(data.nutzap)) };
+  }
+  const mnemonic = entropyToMnemonic(crypto.getRandomValues(new Uint8Array(16)), wordlist);
+  const nutzapKey = nutzapKeyFrom(crypto.getRandomValues(new Uint8Array(32)));
+  const content = await encryptToSelf(
+    JSON.stringify({ v: 1, mnemonic, nutzap: nutzapKey.privateKey })
+  );
+  await relay.publish(
+    await signEvent({
+      kind: BACKUP_KIND,
+      created_at: Math.floor(Date.now() / 1000),
+      tags: [["d", BACKUP_D]],
+      content,
+    })
+  );
+  return { mnemonic, nutzapKey };
+}
