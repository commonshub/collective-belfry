+  return undefined
+}
+
+export default restoreSession().then(async () => {
+  const sso = await belfrySignIn()
+
+  // The page is on its way to the signer; mounting now would only flash the logged-out app.
+  if (sso === "redirecting") return
+
   syncAppConfig()
 
-  return new App({
+  const app = new App({
     target: document.getElementById("app"),
   })
+
+  if (sso?.ok) {
+    setTimeout(boot, 300)
+  } else if (sso && !pubkey.get()) {
+    setTimeout(() => router.at("login").open(), 300)
+  }
+
+  return app
 })
