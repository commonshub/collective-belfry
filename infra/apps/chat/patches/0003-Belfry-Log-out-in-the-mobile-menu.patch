Subject: [PATCH] Belfry: Log out in the mobile menu

---
 src/app/MenuMobile.svelte | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/app/MenuMobile.svelte b/src/app/MenuMobile.svelte
index 31ae692..8328a98 100644
--- a/src/app/MenuMobile.svelte
+++ b/src/app/MenuMobile.svelte
@@ -105,6 +105,12 @@
       <MenuMobileItem on:click={openFeeds}>
         <i class="fa fa-rss" /> Feeds
       </MenuMobileItem>
+      {#if $pubkey}
+        <!-- Belfry: upstream hides Logout under the account name; participants look for it here. -->
+        <MenuMobileItem href="/logout" on:click={closeMenu}>
+          <i class="fa fa-right-from-bracket" /> Log out
+        </MenuMobileItem>
+      {/if}
     </div>
     <div class="staatliches mt-8 block flex h-8 justify-center gap-2 px-8 text-tinted-400">
       <Link class="hover:text-tinted-200" href="/about">About</Link> /
