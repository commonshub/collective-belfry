+/**
+ * Belfry: which participants hold an active pass, and what stewards hid after a report, from the
+ * programme app's API (services/village: GET /api/participants with NIP-98, GET /api/hidden).
+ * The community relay keeps the events of expired passes; "From participants" shows only active
+ * participants' sessions, like the programme app.
+ */
+import { signerManager } from "../common/signer";
+import { buildAndSign } from "../nostr/core";
+
+export const PROGRAMME_URL = (
+  (import.meta.env.VITE_PROGRAMME_URL as string | undefined) || ""
+).replace(/\/$/, "");
+
+async function nip98(url: string, pubkey: string): Promise<string> {
+  const signed = await buildAndSign({
+    kind: 27235,
+    pubkey,
+    created_at: Math.floor(Date.now() / 1000),
+    tags: [
+      ["u", url],
+      ["method", "GET"],
+    ],
+    content: "",
+  });
+  return `Nostr ${btoa(JSON.stringify(signed))}`;
+}
+
+/** The active participants' public keys; null when they cannot be learned (not signed in, no
+ * programme app, an error). */
+export async function activeParticipants(
+  pubkey: string,
+): Promise<Set<string> | null> {
+  if (!PROGRAMME_URL || !pubkey) return null;
+  try {
+    await signerManager.getSigner();
+    const url = `${PROGRAMME_URL}/api/participants`;
+    const res = await fetch(url, {
+      headers: { Authorization: await nip98(url, pubkey) },
+    });
+    if (!res.ok) return null;
+    const body = (await res.json()) as { pubkeys?: string[] };
+    return new Set(body.pubkeys ?? []);
+  } catch {
+    return null;
+  }
+}
+
+/** Event ids and coordinates stewards hid; empty when they cannot be read. */
+export async function hiddenRefs(): Promise<Set<string>> {
+  if (!PROGRAMME_URL) return new Set();
+  try {
+    const res = await fetch(`${PROGRAMME_URL}/api/hidden`);
+    if (!res.ok) return new Set();
+    const body = (await res.json()) as { hidden?: string[] };
+    return new Set(body.hidden ?? []);
+  } catch {
+    return new Set();
+  }
+}
