+
+/**
+ * Belfry: participants' public calendar events and their deletions. The community relay only
+ * takes events from participants, so every author here has (or had) a pass.
+ */
+export function observeCommunityEvents(
+  onEvent: (event: Event) => void,
+): ObserveHandle {
+  const filters: Filter[] = [
+    { kinds: [EventKinds.PublicCalendarEvent] },
+    {
+      kinds: [EventKinds.DeletionEvent],
+      "#k": [String(EventKinds.PublicCalendarEvent)],
+    },
+  ];
+  return dataLayer.observe(filters, { onEvent });
+}
