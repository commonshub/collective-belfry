@@ -0,0 +1,76 @@
+import { useEffect } from "react";
+import { Box, Checkbox, Typography } from "@mui/material";
+import CircleIcon from "@mui/icons-material/Circle";
+import { CollapsibleGroup } from "../ui/CollapsibleGroup";
+import { PROGRAMME_PUBKEY, useVillageCalendars } from "../../belfry/village";
+
+/** Belfry: the sidebar's "Open Source Village" group (village programme and room bookings,
+ * read-only, from the programme key; src/belfry/village.ts). Nothing without the key. */
+export function SidebarVillageCalendars() {
+  const calendars = useVillageCalendars((s) => s.calendars);
+  const visibility = useVillageCalendars((s) => s.visibility);
+  const toggleVisibility = useVillageCalendars((s) => s.toggleVisibility);
+  const start = useVillageCalendars((s) => s.start);
+  useEffect(() => start(), [start]);
+
+  if (!PROGRAMME_PUBKEY) return null;
+
+  return (
+    <CollapsibleGroup
+      title="Open Source Village"
+      count={calendars.length}
+      defaultOpen
+    >
+      {calendars.length === 0 ? (
+        <Typography variant="body2" color="text.secondary" py={1}>
+          The programme appears here once it is published.
+        </Typography>
+      ) : (
+        calendars.map((calendar) => {
+          const visible = visibility[calendar.id] !== false;
+          return (
+            <Box
+              key={calendar.id}
+              data-testid="village-calendar-row"
+              display="flex"
+              alignItems="center"
+              sx={{
+                py: 0.5,
+                "&:hover": { backgroundColor: "action.hover" },
+                borderRadius: 1,
+              }}
+            >
+              <Checkbox
+                checked={visible}
+                onChange={() => toggleVisibility(calendar.id)}
+                size="small"
+                sx={{
+                  color: calendar.color,
+                  "&.Mui-checked": { color: calendar.color },
+                  p: 0.5,
+                }}
+                inputProps={{ "aria-label": calendar.title }}
+              />
+              <Box
+                display="flex"
+                alignItems="center"
+                gap={1}
+                flex={1}
+                minWidth={0}
+                sx={{ ml: 0.5 }}
+              >
+                <CircleIcon sx={{ fontSize: 10, color: calendar.color }} />
+                <Typography
+                  variant="body2"
+                  sx={{ wordBreak: "break-word", whiteSpace: "normal" }}
+                >
+                  {calendar.title}
+                </Typography>
+              </Box>
+            </Box>
+          );
+        })
+      )}
+    </CollapsibleGroup>
+  );
+}
