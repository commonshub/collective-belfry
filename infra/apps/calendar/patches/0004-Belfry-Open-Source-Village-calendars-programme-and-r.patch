index 0000000..b734bcb
--- /dev/null
+++ b/src/belfry/village.ts
@@ -0,0 +1,166 @@
+/**
+ * Belfry: the Open Source Village calendars. Belfry's `sync-programme` job publishes the
+ * website's programme and the rooms' Google calendars as public NIP-52 events (kind 31923)
+ * signed with the programme key (VITE_PROGRAMME_PUBKEY). This store follows that key's events
+ * on the community relay and groups them by their `t` tag: "programme" is the village
+ * programme, "room-<slug>" one calendar per room. They are read-only public events: no
+ * calendar-list refs, never edited here; participants can still open, share and RSVP to them.
+ */
+import { create } from "zustand";
+import type { Event } from "nostr-tools";
+import type { ObserveHandle } from "@formstr/local-relay";
+import { observeProgrammeEvents } from "../nostr/village";
+import { EventKinds } from "../nostr/kinds";
+import { nostrEventToCalendar } from "../utils/parser";
+import type { ICalendarEvent } from "../utils/types";
+
+export const PROGRAMME_PUBKEY = (
+  (import.meta.env.VITE_PROGRAMME_PUBKEY as string | undefined) || ""
+).trim();
+
+export const VILLAGE_CALENDAR_PREFIX = "village:";
+const VISIBILITY_KEY = "belfry:village-visibility";
+
+export interface VillageCalendar {
+  id: string;
+  title: string;
+  color: string;
+}
+
+// The programme in the village's lime, the rooms in tints that read on the dark theme.
+const PROGRAMME_COLOR = "#d6ff52";
+const ROOM_COLORS = [
+  "#f89b0e",
+  "#5ec8e5",
+  "#c792ea",
+  "#ff7a8a",
+  "#7ee0a1",
+  "#f2d06b",
+  "#8fa8ff",
+];
+
+/** The calendar an event of the programme key belongs to, from its `t` tags. */
+export function villageCalendarFor(event: Event): VillageCalendar | null {
+  const tags = event.tags.filter((t) => t[0] === "t").map((t) => t[1]);
+  if (tags.includes("programme")) {
+    return {
+      id: `${VILLAGE_CALENDAR_PREFIX}programme`,
+      title: "Village programme",
+      color: PROGRAMME_COLOR,
+    };
+  }
+  const room = tags.find((t) => t?.startsWith("room-"));
+  if (!room) return null;
+  const location = event.tags.find((t) => t[0] === "location")?.[1] ?? "";
+  return {
+    id: `${VILLAGE_CALENDAR_PREFIX}${room}`,
+    title: location.split(",")[0]?.trim() || room.slice(5),
+    color: ROOM_COLORS[0], // assigned by position in publish()
+  };
+}
+
+export function villageCalendarColor(calendarId: string): string | undefined {
+  return useVillageCalendars
+    .getState()
+    .calendars.find((c) => c.id === calendarId)?.color;
+}
+
+function loadVisibility(): Record<string, boolean> {
+  try {
+    return JSON.parse(localStorage.getItem(VISIBILITY_KEY) || "{}");
+  } catch {
+    return {};
+  }
+}
+
+interface VillageState {
+  calendars: VillageCalendar[];
+  events: ICalendarEvent[];
+  visibility: Record<string, boolean>;
+  start: () => void;
+  toggleVisibility: (id: string) => void;
+}
+
+let subscription: ObserveHandle | null = null;
+// d tag → newest kind-31923 version; d tag → newest deletion (NIP-09 `a` tag)
+const latest = new Map<string, { event: Event; calendar: VillageCalendar }>();
+const deletedAt = new Map<string, number>();
+
+export const useVillageCalendars = create<VillageState>((set, get) => {
+  const publish = () => {
+    const calendars = new Map<string, VillageCalendar>();
+    const events: ICalendarEvent[] = [];
+    for (const [d, { event, calendar }] of latest) {
+      if ((deletedAt.get(d) ?? -1) >= event.created_at) continue;
+      calendars.set(calendar.id, calendar);
+      const parsed = nostrEventToCalendar(event, calendar.id);
+      if (parsed.begin && parsed.end) events.push(parsed);
+    }
+    // the programme first, then the rooms by name, each room in its own tint
+    const rooms = [...calendars.values()]
+      .filter((c) => !c.id.endsWith(":programme"))
+      .sort((a, b) => a.title.localeCompare(b.title))
+      .map((c, i) => ({ ...c, color: ROOM_COLORS[i % ROOM_COLORS.length] }));
+    const programme = calendars.get(`${VILLAGE_CALENDAR_PREFIX}programme`);
+    const sorted = programme ? [programme, ...rooms] : rooms;
+    set({ calendars: sorted, events });
+  };
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const schedule = () => {
+    clearTimeout(timer);
+    timer = setTimeout(publish, 150);
+  };
+
+  return {
+    calendars: [],
+    events: [],
+    visibility: loadVisibility(),
+    start: () => {
+      if (subscription || !PROGRAMME_PUBKEY) return;
+      subscription = observeProgrammeEvents(
+        PROGRAMME_PUBKEY,
+        (event: Event) => {
+          if (event.pubkey !== PROGRAMME_PUBKEY) return;
+          if (event.kind === EventKinds.DeletionEvent) {
+            for (const tag of event.tags) {
+              if (tag[0] !== "a") continue;
+              const d = tag[1]?.split(":").slice(2).join(":");
+              if (d)
+                deletedAt.set(
+                  d,
+                  Math.max(deletedAt.get(d) ?? 0, event.created_at),
+                );
+            }
+          } else if (event.kind === EventKinds.PublicCalendarEvent) {
+            const d = event.tags.find((t) => t[0] === "d")?.[1];
+            const calendar = villageCalendarFor(event);
+            if (!d || !calendar) return;
+            const known = latest.get(d);
+            if (!known || known.event.created_at < event.created_at)
+              latest.set(d, { event, calendar });
+          }
+          schedule();
+        },
+      );
+    },
+    toggleVisibility: (id) => {
+      const visibility = {
+        ...get().visibility,
+        [id]: get().visibility[id] === false,
+      };
+      try {
+        localStorage.setItem(VISIBILITY_KEY, JSON.stringify(visibility));
+      } catch {
+        // private mode: the choice lasts for this page only
+      }
+      set({ visibility });
+    },
+  };
+});
+
+/** The events of the village calendars the participant shows. */
+export function useVisibleVillageEvents(): ICalendarEvent[] {
+  const events = useVillageCalendars((s) => s.events);
+  const visibility = useVillageCalendars((s) => s.visibility);
+  return events.filter((e) => visibility[e.calendarId] !== false);
+}
