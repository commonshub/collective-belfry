index 0000000..a473b21
--- /dev/null
+++ b/src/nostr/village.ts
@@ -0,0 +1,18 @@
+import type { Event, Filter } from "nostr-tools";
+import { dataLayer, type ObserveHandle } from "@formstr/local-relay";
+import { EventKinds } from "./kinds";
+
+/**
+ * Belfry: the programme key's public calendar events and deletions (src/belfry/village.ts).
+ * No since/until: relays apply them to created_at, not to when an event takes place.
+ */
+export function observeProgrammeEvents(
+  pubkey: string,
+  onEvent: (event: Event) => void,
+): ObserveHandle {
+  const filter: Filter = {
+    kinds: [EventKinds.PublicCalendarEvent, EventKinds.DeletionEvent],
+    authors: [pubkey],
+  };
+  return dataLayer.observe([filter], { onEvent });
+}
