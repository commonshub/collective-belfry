diff --git a/src/belfry/sso.ts b/src/belfry/sso.ts
new file mode 100644
index 0000000..857c997
--- /dev/null
+++ b/src/belfry/sso.ts
@@ -0,0 +1,122 @@
+/**
+ * Belfry: "Sign in with Open Source Village" through Keycast's OAuth (authorization code +
+ * PKCE). The token response carries a bunker URL, which the app's own NIP-46 login uses, so the
+ * participant never copies a bunker link. With `prompt=none` Keycast answers without showing a
+ * page (signed in and approved -> code, otherwise ?error=login_required and similar); the app
+ * tries that once per tab on load and shows the sign-in dialog when it fails.
+ */
+const KEYCAST_URL = (
+  import.meta.env.VITE_KEYCAST_URL as string | undefined
+)?.replace(/\/$/, "");
+const CLIENT_ID =
+  (import.meta.env.VITE_OAUTH_CLIENT_ID as string | undefined) ||
+  "belfry-calendar";
+const SCOPE = "policy:belfry-event";
+const PENDING_KEY = "belfry-sso-pending";
+const TRIED_KEY = "belfry-sso-silent-tried";
+
+export const SSO_CALLBACK_PATH = "/oauth/callback";
+export const ssoEnabled = Boolean(KEYCAST_URL);
+
+interface Pending {
+  state: string;
+  verifier: string;
+  returnTo: string;
+}
+
+const b64url = (bytes: Uint8Array) =>
+  btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+const randomString = () => b64url(crypto.getRandomValues(new Uint8Array(32)));
+
+const redirectUri = () => `${window.location.origin}${SSO_CALLBACK_PATH}`;
+
+function session(): Storage | null {
+  try {
+    return window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+/** Send the browser to Keycast's authorize endpoint; `silent` adds prompt=none. */
+export async function startSso(silent: boolean): Promise<void> {
+  if (!KEYCAST_URL) return;
+  const verifier = randomString();
+  const digest = await crypto.subtle.digest(
+    "SHA-256",
+    new TextEncoder().encode(verifier),
+  );
+  const pending: Pending = {
+    state: randomString(),
+    verifier,
+    returnTo: window.location.pathname + window.location.search,
+  };
+  session()?.setItem(PENDING_KEY, JSON.stringify(pending));
+  const params = new URLSearchParams({
+    client_id: CLIENT_ID,
+    redirect_uri: redirectUri(),
+    scope: SCOPE,
+    code_challenge: b64url(new Uint8Array(digest)),
+    code_challenge_method: "S256",
+    state: pending.state,
+  });
+  if (silent) params.set("prompt", "none");
+  window.location.assign(`${KEYCAST_URL}/api/oauth/authorize?${params}`);
+}
+
+/** True once per tab: the caller should try a silent sign-in now. */
+export function shouldTrySilentSso(): boolean {
+  const store = session();
+  if (!ssoEnabled || !store || store.getItem(TRIED_KEY)) return false;
+  store.setItem(TRIED_KEY, "1");
+  return true;
+}
+
+export type SsoResult =
+  | { ok: true; bunkerUrl: string; returnTo: string }
+  | { ok: false; error: string; returnTo: string };
+
+/** Handle the redirect back to SSO_CALLBACK_PATH: check state, exchange the code. */
+export async function finishSso(search: string): Promise<SsoResult> {
+  const params = new URLSearchParams(search);
+  const store = session();
+  const raw = store?.getItem(PENDING_KEY);
+  store?.removeItem(PENDING_KEY);
+  const pending: Pending | null = raw ? JSON.parse(raw) : null;
+  const returnTo = pending?.returnTo || "/";
+  if (!pending || params.get("state") !== pending.state) {
+    return { ok: false, error: "state_mismatch", returnTo };
+  }
+  const error = params.get("error");
+  if (error) return { ok: false, error, returnTo };
+  const code = params.get("code");
+  if (!code || !KEYCAST_URL) return { ok: false, error: "no_code", returnTo };
+  try {
+    const res = await fetch(`${KEYCAST_URL}/api/oauth/token`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        grant_type: "authorization_code",
+        code,
+        client_id: CLIENT_ID,
+        redirect_uri: redirectUri(),
+        code_verifier: pending.verifier,
+      }),
+    });
+    const body = await res.json().catch(() => ({}));
+    if (!res.ok || typeof body.bunker_url !== "string") {
+      return {
+        ok: false,
+        error: body.error || `token_${res.status}`,
+        returnTo,
+      };
+    }
+    return { ok: true, bunkerUrl: body.bunker_url, returnTo };
+  } catch {
+    return { ok: false, error: "token_request_failed", returnTo };
+  }
+}
