diff --git a/src/belfry/sso.ts b/src/belfry/sso.ts
new file mode 100644
index 00000000..2e2af498
--- /dev/null
+++ b/src/belfry/sso.ts
@@ -0,0 +1,217 @@
+// Belfry: "Sign in with Open Source Village" and the silent sign-in check.
+//
+// OAuth 2.0 authorization code + PKCE against Keycast (the community signer). Keycast signs the
+// participant in through Authentik; its token response carries a fresh bunker:// URL, which this
+// module connects with like the "Login with bunker" screen does. On load without a session the
+// app redirects once per tab with prompt=none: Keycast answers with a code when the participant
+// is signed in (Keycast or Authentik session, Belfry's apps skip consent), otherwise with
+// error=login_required and the login screen opens.
+//
+// Logout ends the sign-in everywhere: the app revokes its own authorization at Keycast (with the
+// refresh token of the token response) and goes through Keycast's /api/auth/oidc/logout, which
+// ends the Keycast and Authentik sessions and returns here; otherwise the silent check would
+// sign the participant straight back in.
+
+import {Nip46Broker} from "@welshman/signer"
+import {makeSecret} from "@welshman/util"
+import {toSession, nip46} from "@welshman/app"
+import {NIP46_PERMS} from "@app/core/nip46"
+import {login} from "@app/core/session"
+
+const KEYCAST_URL = ((import.meta.env.VITE_KEYCAST_URL as string) || "").replace(/\/+$/, "")
+const CLIENT_ID = (import.meta.env.VITE_OAUTH_CLIENT_ID as string) || "belfry-groups"
+const SCOPE = "policy:belfry-event"
+const CALLBACK_PATH = "/oauth/callback"
+const FLOW_KEY = "belfry-sso-flow"
+const TRIED_KEY = "belfry-sso-silent-tried"
+const REFRESH_KEY = "belfry-sso-refresh-token"
+
+type Flow = {state: string; verifier: string; silent: boolean; returnTo: string}
+
+// `returnTo` is where the app was when the flow started; the layout navigates there.
+export type SsoResult =
+  | {ok: true; returnTo: string}
+  | {ok: false; silent: boolean; error: string; returnTo: string}
+
+export const ssoEnabled = () => Boolean(KEYCAST_URL)
+
+export const isSsoCallback = () => window.location.pathname === CALLBACK_PATH
+
+const redirectUri = () => window.location.origin + CALLBACK_PATH
+
+const store = {
+  get: (key: string) => {
+    try {
+      return window.sessionStorage.getItem(key)
+    } catch {
+      return null
+    }
+  },
+  set: (key: string, value: string) => {
+    try {
+      window.sessionStorage.setItem(key, value)
+      return true
+    } catch {
+      return false
+    }
+  },
+  remove: (key: string) => {
+    try {
+      window.sessionStorage.removeItem(key)
+    } catch {
+      // storage unavailable: nothing to remove
+    }
+  },
+}
+
+const b64url = (bytes: Uint8Array) =>
+  btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "")
+
+const randomString = (length = 32) => b64url(crypto.getRandomValues(new Uint8Array(length)))
+
+const challengeFor = async (verifier: string) =>
+  b64url(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))))
+
+/** Redirects to Keycast. Interactive by default; `silent` adds prompt=none. */
+export const startSignIn = async (silent = false) => {
+  const here = window.location.pathname + window.location.search + window.location.hash
+  const flow: Flow = {
+    state: randomString(),
+    verifier: randomString(48),
+    silent,
+    returnTo: isSsoCallback() ? "/" : here,
+  }
+
+  // Without storage the callback could not check the state: do not start a flow it cannot finish.
+  if (!store.set(FLOW_KEY, JSON.stringify(flow))) return false
+
+  const url = new URL(KEYCAST_URL + "/api/oauth/authorize")
+  url.searchParams.set("client_id", CLIENT_ID)
+  url.searchParams.set("redirect_uri", redirectUri())
+  url.searchParams.set("scope", SCOPE)
+  url.searchParams.set("state", flow.state)
+  url.searchParams.set("code_challenge", await challengeFor(flow.verifier))
+  url.searchParams.set("code_challenge_method", "S256")
+  if (silent) url.searchParams.set("prompt", "none")
+
+  window.location.assign(url.toString())
+  return true
+}
+
+/** One silent attempt per tab. True when the page is being redirected. */
+export const trySilentSignIn = async () => {
+  if (!ssoEnabled() || store.get(TRIED_KEY)) return false
+  if (!store.set(TRIED_KEY, "1")) return false
+  return startSignIn(true)
+}
+
+export const connectBunker = async (bunkerUrl: string) => {
+  const clientSecret = makeSecret()
+  const {signerPubkey, connectSecret, relays} = Nip46Broker.parseBunkerUrl(bunkerUrl)
+  const broker = new Nip46Broker({relays, clientSecret, signerPubkey})
+
+  try {
+    const result = await broker.connect(connectSecret, NIP46_PERMS)
+    const pubkey = await broker.getPublicKey()
+
+    if (!pubkey || !["ack", connectSecret].includes(result)) {
+      throw new Error("the signer did not accept the connection")
+    }
+
+    await login(toSession(nip46, {clientSecret, signerPubkey, relays: broker.params.relays}))
+  } finally {
+    broker.cleanup()
+  }
+}
+
+/** Handles /oauth/callback: exchanges the code and connects. Restores the original URL. */
+export const finishSignIn = async (): Promise<SsoResult> => {
+  const params = new URLSearchParams(window.location.search)
+  const raw = store.get(FLOW_KEY)
+  store.remove(FLOW_KEY)
+
+  let flow: Flow | undefined
+  try {
+    flow = raw ? (JSON.parse(raw) as Flow) : undefined
+  } catch {
+    flow = undefined
+  }
+
+  const returnTo = flow?.returnTo || "/"
+  const silent = Boolean(flow?.silent)
+  const fail = (error: string): SsoResult => ({ok: false, silent, error, returnTo})
+
+  if (!flow || params.get("state") !== flow.state) return fail("state_mismatch")
+  if (params.get("error")) return fail(params.get("error") as string)
+
+  const code = params.get("code")
+  if (!code) return fail("missing_code")
+
+  try {
+    const response = await fetch(KEYCAST_URL + "/api/oauth/token", {
+      method: "POST",
+      headers: {"Content-Type": "application/json"},
+      body: JSON.stringify({
+        grant_type: "authorization_code",
+        code,
+        client_id: CLIENT_ID,
+        redirect_uri: redirectUri(),
+        code_verifier: flow.verifier,
+      }),
+    })
+    const body = await response.json().catch(() => ({}))
+
+    if (!response.ok || !body.bunker_url) {
+      return fail(body.error || `token_${response.status}`)
+    }
+
+    await connectBunker(body.bunker_url)
+    try {
+      if (body.refresh_token) window.localStorage.setItem(REFRESH_KEY, body.refresh_token)
+    } catch {
+      // storage unavailable: logout then only ends the sessions, not the authorization
+    }
+  } catch (e) {
+    console.error("Sign-in with Open Source Village failed", e)
+    return fail("connect_failed")
+  }
+
+  return {ok: true, returnTo}
+}
+
+/** Revokes this app's authorization and returns the URL that ends the single sign-on session
+ *  and comes back to `returnTo`. Call before clearing local storage. */
+export const prepareLogout = async (returnTo: string) => {
+  if (!ssoEnabled()) return returnTo
+
+  let refreshToken: string | null = null
+  try {
+    refreshToken = window.localStorage.getItem(REFRESH_KEY)
+    window.localStorage.removeItem(REFRESH_KEY)
+  } catch {
+    refreshToken = null
+  }
+
+  if (refreshToken) {
+    try {
+      await fetch(KEYCAST_URL + "/api/oauth/revoke", {
+        method: "POST",
+        headers: {"Content-Type": "application/json"},
+        body: JSON.stringify({token: refreshToken, client_id: CLIENT_ID}),
+        signal: AbortSignal.timeout(3000),
+      })
+    } catch (e) {
+      console.warn("Revoking the Open Source Village authorization failed", e)
+    }
+  }
+
+  // Back here signed out: show the login screen instead of trying the silent sign-in again.
+  store.set(TRIED_KEY, "1")
+
+  const url = new URL(KEYCAST_URL + "/api/auth/oidc/logout")
+  url.searchParams.set("return_to", new URL(returnTo, window.location.origin).toString())
+  return url.toString()
+}
