# Belfry local stack: the settings. Run scripts/gen-secrets.sh, which copies this file to
# infra/.env and fills in every "generated" value.
#
# No secrets here: every password, token and key is a file in infra/secrets/ (mode 640, not in
# git), written by scripts/gen-secrets.sh, bootstrap.sh (API tokens) or scripts/put-secret.sh
# (SMTP password, Stripe and Mollie keys), and mounted into the containers that need it as a
# Compose secret. infra/README.md, "Secrets".

# --- Odoo
COMPANY_NAME=Belfry                    # Odoo company name (sender name of the mails)
MAIL_FROM=belfry@belfry.local          # company e-mail: sender of the activation mails
COMPANY_CURRENCY=EUR                   # company currency; bootstrap sets it on a fresh database only
COMPANY_COUNTRY=BE                     # company country (ISO code): Odoo's chart of accounts and taxes; fresh database only
# Outgoing mail server for Odoo (bootstrap creates ir.mail_server from these); locally Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_ENCRYPTION=none                   # none | starttls | ssl
ODOO_ONBOARDING_LOGIN=onboarding@belfry.local   # technical user the onboarding service uses
ODOO_PUBLIC_URL=http://localhost:8069  # Odoo as browsers see it (web.base.url: invite links, payment links in mails)
EVENT_START=2027-01-25                 # mirrors ir.config_parameter belfry.event_start
# The start page (the onboarding service's landing page, also on the apex); prod-env.sh sets https://<domain>
SITE_URL=
# A notice on every page a participant sees during a test run, e.g. "Test run: no real money is
# charged, and all data is deleted afterwards." Bootstrap adds the Mollie test card while Mollie is in test mode.
TEST_RUN_NOTICE=
# How many friends a participant can invite (open or used invites) from the pass page
INVITES_PER_PARTICIPANT=3
EVENT_END=2027-01-31                   # mirrors belfry.event_end

# --- Authentik
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@belfry.local
AUTHENTIK_PUBLIC_URL=http://localhost:9000  # Authentik as the browser sees it; Keycast's OIDC issuer is <this>/application/o/keycast/

# --- Keycast (signer)
KEYCAST_ADMIN_PUBKEY=generated         # x-only pubkey of secrets/keycast_admin_nsec; goes into ALLOWED_PUBKEYS
KEYCAST_ADMIN_EMAIL=admin@belfry.local # login of the Keycast admin account
KEYCAST_APP_URL=http://localhost:3000  # APP_URL/BASE_URL/ALLOWED_ORIGINS
BUNKER_PUBLIC_RELAYS=ws://localhost:3080  # the NIP-46 relay as clients reach it (bunker:// URLs); production wss://bunker.<domain>
KEYCAST_TENANT_DOMAIN=localhost        # ALLOWED_TENANT_DOMAINS; every client must send this Host header
KEYCAST_RUST_LOG=info
KEYCAST_OIDC_ONLY=true                 # hide Keycast's e-mail/password forms; participants sign in through Authentik
# The master key (32 random bytes, base64) is a file, not a variable: infra/keycast/master.key

# --- Community relay (rnostr, host port 3090; see relay/README.md)
# comma-separated hex pubkeys always whitelisted (Belfry's own keys, stewards)
RELAY_EXTRA_PUBKEYS=
# Programme key (secrets/programme_nsec): `sync-programme` publishes the website's programme and the
# rooms' Google calendars as public calendar events with it; the relay whitelist adds it itself.
PROGRAMME_PUBKEY=generated             # x-only pubkey of secrets/programme_nsec; built into the calendar and programme apps
NIP05_DOMAIN=localhost                 # domain of the NIP-05 names in published profiles (Keycast serves nostr.json)
BLOSSOM_PUBLIC_DOMAIN=localhost:3100   # Blossom (files) as clients see it, bare host[:port]; blob URLs and the auth "server" tag
COMMUNITY_RELAY_URL=ws://localhost:3090  # the community relay as browsers reach it (built into the calendar app); production wss://relay.<domain>
CALENDAR_PUBLIC_URL=http://localhost:3200  # the calendar app as browsers reach it (Keycast's registered redirect URI <URL>/oauth/callback); production https://calendar.<domain>
BLOSSOM_PUBLIC_URL=http://localhost:3100  # Blossom with scheme, compiled into the apps; production https://blossom.<domain>
CHAT_PUBLIC_URL=http://localhost:3300  # the chat app (Coracle) as browsers reach it; production https://chat.<domain>
VOTE_PUBLIC_URL=http://localhost:3500  # the polls app (services/vote) as browsers reach it (Keycast redirect URI <URL>/oauth/callback); production https://vote.<domain>
MINT_PUBLIC_URL=http://localhost:3338  # the token mint as wallets reach it; production https://mint.<domain>
WALLET_PUBLIC_URL=http://localhost:3400  # the token wallet (cashu.me); production https://wallet.<domain>
PEOPLE_PUBLIC_URL=http://localhost:3600  # the directory (services/village); production https://people.<domain>
MARKET_PUBLIC_URL=http://localhost:3700  # the marketplace (services/village); production https://market.<domain>
PHOTOS_PUBLIC_URL=http://localhost:3800  # the photos (services/village); production https://photos.<domain>
PROGRAMME_PUBLIC_URL=http://localhost:3900  # the programme (services/village); production https://programme.<domain>

# --- Credential issuer and verifier (Phase 3, walt.id Issuer2 / Verifier2 1.2.0)
ISSUER_PUBLIC_URL=http://localhost:7005     # the issuer as wallets see it; credential_issuer = <this>/openid4vci
VERIFIER_PUBLIC_URL=http://localhost:7004   # the verifier as wallets see it (request_uri, response_uri)
ONBOARDING_PUBLIC_URL=http://localhost:8100 # claim pages, door page, pass bridge, status list and vct as the browser sees them
# the credential's status_list.uri as the VERIFIER reaches it (inside Compose: the service name)
STATUS_LIST_URL=http://onboarding:8100/status/1
STATUS_LIST_TTL=5                           # seconds verifiers may cache the status list (revocation delay); 300 in production
# Issuer keys are files, not variables: infra/issuer/keys/ (scripts/gen-issuer-pki.sh)

# --- Public deployment (docker-compose.prod.yml, proxy/Caddyfile); set by scripts/prod-env.sh <domain> <acme e-mail>
# BELFRY_DOMAIN=belfry.example
# ACME_EMAIL=ops@belfry.example
# CADDY_TLS_ARG=internal               # only for a local check of the routing rules (Caddy's own CA); unset = ACME

# --- Backups (scripts/backup.sh run, nightly from backup.sh install; DEPLOY.md "Backups")
# Production proxy: admin pages only from these networks (ZeroTier subnet + Docker's ranges for
# bootstrap and the smoke test on the VM); scripts/zerotier.sh status prints the line.
# ADMIN_NETS="10.147.17.0/24 127.0.0.1/8 172.16.0.0/12"
# Production proxy: the venue WiFi's public addresses, exempt from the per-IP rate limits (everyone
# there shares them); space-separated CIDRs. Unset: no exemption.
# RATE_LIMIT_EXEMPT="203.0.113.7/32"
# BACKUP_RECIPIENTS=age1…               # printed by backup.sh keygen on a steward's laptop; space separated
# BACKUP_TARGET=sftp://u123456@u123456.your-storagebox.de:23/belfry   # or a local directory
# BACKUP_SSH_KEY=/home/belfry/.ssh/belfry-backup
# BACKUP_KEEP=30                        # days at the target
# BACKUP_AT=03:15                       # UTC, for backup.sh install

# --- Onboarding service
# Keycast runs as this user and group (the owner of keycast/master.key and the custody seed);
# gen-secrets.sh writes the deploying user's ids
HOST_UID=generated
HOST_GID=generated
# CUSTODY_SEED_DIR: empty locally (secrets/custody, written by gen-secrets.sh); a deployment uses
# /run/belfry, filled by scripts/custody-seed.sh unlock (Keycast patch 0014)
CUSTODY_SEED_DIR=
# Stripe: the publishable key here (pk_test_… or pk_live_…), the secret key in
# infra/secrets/stripe_secret_key (scripts/put-secret.sh); bootstrap configures Odoo's provider
STRIPE_PUBLISHABLE_KEY=
# (the dispute webhook's whsec_… goes to infra/secrets/stripe_webhook_secret, written by bootstrap)
# Mollie: the API key (test_… or live_…) in infra/secrets/mollie_api_key (scripts/put-secret.sh);
# bootstrap configures Odoo's provider and offers these payment methods (Odoo codes, comma-separated)
MOLLIE_METHODS=card,ideal,bancontact
ONBOARDING_URL=http://onboarding:8100  # stored as ir.config_parameter belfry.onboarding_url
LOG_LEVEL=info
