# Belfry local stack. Copy to infra/.env or run scripts/gen-secrets.sh, which fills in
# every "generated" value. Values marked "bootstrap" are written by scripts/bootstrap.sh.

# --- Postgres (one role + database per service, created by postgres/init.sh on first start)
POSTGRES_PASSWORD=generated            # superuser "postgres"
ODOO_DB_PASSWORD=generated             # role "odoo", database "odoo" (CREATEDB for test DBs)
AUTHENTIK_DB_PASSWORD=generated        # role/database "authentik"
KEYCAST_DB_PASSWORD=generated          # role/database "keycast"

# --- Odoo
ODOO_ADMIN_PASSWORD=generated          # password of the "admin" user, set by bootstrap (DB is created with "admin")
ODOO_ONBOARDING_LOGIN=onboarding@belfry.local   # technical user the onboarding service uses
ODOO_API_KEY=                          # bootstrap: API key of that user (JSON-RPC password)
EVENT_START=2027-01-25                 # mirrors ir.config_parameter belfry.event_start
EVENT_END=2027-01-31                   # mirrors belfry.event_end

# --- Authentik
AUTHENTIK_SECRET_KEY=generated         # Django secret key; changing it invalidates sessions
AUTHENTIK_BOOTSTRAP_PASSWORD=generated # akadmin password, applied by the system bootstrap blueprint on first start only
AUTHENTIK_BOOTSTRAP_TOKEN=generated    # non-expiring API token for akadmin, same blueprint, first start only
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@belfry.local
AUTHENTIK_TOKEN=                       # bootstrap: the token the onboarding service uses (= bootstrap token for slice 1)
BRIDGE_CLIENT_SECRET=generated         # client secret of the pass-bridge OIDC source (placeholder until Phase 3)

# --- Keycast (signer)
KEYCAST_SERVER_NSEC=generated          # 64 hex; signs server-issued UCANs (admin and preload sessions)
KEYCAST_ADMIN_NSEC=generated           # 64 hex; the admin's Nostr secret, used once to register the admin
KEYCAST_ADMIN_PUBKEY=generated         # x-only pubkey of the above; goes into ALLOWED_PUBKEYS
KEYCAST_ADMIN_EMAIL=admin@belfry.local # login of the Keycast admin account
KEYCAST_ADMIN_PASSWORD=generated
KEYCAST_SERVICE_TOKEN=generated        # bearer for the service-token routes (PUT /api/admin/users/<pubkey>/status)
KEYCAST_ADMIN_TOKEN=                   # bootstrap: 30-day admin UCAN from /api/admin/token (preload-user)
KEYCAST_APP_URL=http://localhost:3000  # APP_URL/BASE_URL/ALLOWED_ORIGINS
KEYCAST_TENANT_DOMAIN=localhost        # ALLOWED_TENANT_DOMAINS; every client must send this Host header
KEYCAST_RUST_LOG=info
# The master key (32 random bytes, base64) is a file, not a variable: infra/keycast/master.key

# --- Onboarding service
HOOK_TOKEN=generated                   # shared secret in Odoo webhook URLs (?token=) and ir.config_parameter belfry.hook_token
STRIPE_WEBHOOK_SECRET=                 # whsec_... for /hooks/stripe (disputes); empty locally
ONBOARDING_URL=http://onboarding:8100  # stored as ir.config_parameter belfry.onboarding_url
LOG_LEVEL=info
